//MEGA_FUNCTIONS_BEGIN
// ======== [BEGIN FILE: src/*.j] ========

function PAX_IsFixedBoss takes integer id returns boolean
    return id == 'n001' or id == 'n00C' or id == 'n00D' or id == 'n00F' or id == 'n00G' or id == 'n01I' or id == 'n01J' or id == 'n01K' or id == 'n01L' or id == 'n01M' or id == 'n01N' or id == 'n01O' or id == 'n033' or id == 'n034' or id == 'n035'
endfunction

function PAX_Boss_Register takes unit lg, real x, real y returns nothing
    local integer h = 0
    local integer oldMax = 0
    local integer newMax = 0
    local integer baseDmg = 0
    local integer dice = 0
    local real arm = 0.0
    local real atkCd = 0.0
    if lg != null then
        set h = GetHandleId(lg)
        if LoadInteger(PAX_Boss_HT, h, 2) == 0 then
            call SaveReal(PAX_Boss_HT, h, 0, x)
            call SaveReal(PAX_Boss_HT, h, 1, y)
            call SaveInteger(PAX_Boss_HT, h, 2, 1)
            call SaveReal(PAX_Boss_HT, h, 3, x)
            call SaveReal(PAX_Boss_HT, h, 4, y)
            call SaveReal(PAX_Boss_HT, h, 5, Mega_Time)
            call SaveInteger(PAX_Boss_HT, h, 6, 0)
            call SaveReal(PAX_Boss_HT, h, 7, 0.0)
            call SaveReal(Ab_HT, h, 60, Mega_Time)

            // Uniform Boss Buff: x10 HP, x2 ATK, x2 Armor, Infinite Mana, -50% CD, Flag 65
            if LoadInteger(PAX_Boss_HT, h, 65) == 0 then
                call SaveInteger(PAX_Boss_HT, h, 65, 1)
                
                // x10 HP
                set oldMax = BlzGetUnitMaxHP(lg)
                if oldMax > 0 then
                    set newMax = oldMax * 10
                    call BlzSetUnitMaxHP(lg, newMax)
                    call SetWidgetLife(lg, I2R(newMax))
                endif

                // x2 ATK
                set baseDmg = BlzGetUnitBaseDamage(lg, 0)
                call BlzSetUnitBaseDamage(lg, baseDmg * 2, 0)
                set dice = BlzGetUnitDiceSides(lg, 0)
                if dice > 0 then
                    call BlzSetUnitDiceSides(lg, dice * 2, 0)
                endif

                // x2 Armor
                set arm = BlzGetUnitArmor(lg)
                call BlzSetUnitArmor(lg, arm * 2.0)

                // Infinite Mana (10,000 max mana)
                call BlzSetUnitMaxMana(lg, 10000)
                call SetUnitState(lg, UNIT_STATE_MANA, 10000.0)

                // -50% CD
                set atkCd = BlzGetUnitAttackCooldown(lg, 0)
                if atkCd > 0.40 then
                    call BlzSetUnitAttackCooldown(lg, atkCd * 0.50, 0)
                endif
            endif

            call GroupAddUnit(PAX_Leg_G, lg)
        endif
    endif
endfunction

function PAX_Boss_Scan takes nothing returns nothing
    local unit u = null
    call GroupEnumUnitsOfPlayer(PAX_Boss_ScanG, Player(PLAYER_NEUTRAL_AGGRESSIVE), null)
    loop
        set u = FirstOfGroup(PAX_Boss_ScanG)
        exitwhen u == null
        call GroupRemoveUnit(PAX_Boss_ScanG, u)
        if GetWidgetLife(u) > 0.405 and PAX_IsFixedBoss(GetUnitTypeId(u)) and LoadInteger(PAX_Boss_HT, GetHandleId(u), 2) == 0 then
            call PAX_Boss_Register(u, GetUnitX(u), GetUnitY(u))
        endif
    endloop
    set u = null
endfunction

function PAX_Boss_Tick takes nothing returns nothing
    local group keep = CreateGroup()
    local unit u = null
    local integer h = 0
    local real hx = 0.0
    local real hy = 0.0
    local real maxhp = 0.0
    local real dx = 0.0
    local real dy = 0.0
    local real dist = 0.0
    local real curX = 0.0
    local real curY = 0.0
    local real prevX = 0.0
    local real prevY = 0.0
    local real movedDist2 = 0.0
    local real lastCombat = 0.0
    local real lastActive = 0.0
    local real returnStart = 0.0
    local boolean moved = false
    local integer returning = 0
    local integer baseDmg = 0
    local real curAtkCd = 0.0
    local real curScale = 0.0
    local texttag rageTag = null
    call PAX_Boss_Scan()
    loop
        set u = FirstOfGroup(PAX_Leg_G)
        exitwhen u == null
        call GroupRemoveUnit(PAX_Leg_G, u)
        set h = GetHandleId(u)
        if GetUnitTypeId(u) == 0 or GetWidgetLife(u) <= 0.405 then
            call FlushChildHashtable(PAX_Boss_HT, h)
        else
            call GroupAddUnit(keep, u)
            set curX = GetUnitX(u)
            set curY = GetUnitY(u)
            if LoadInteger(PAX_Boss_HT, h, 65) == 1 then
                call SetUnitState(u, UNIT_STATE_MANA, 10000.0)
            endif
            set prevX = LoadReal(PAX_Boss_HT, h, 3)
            set prevY = LoadReal(PAX_Boss_HT, h, 4)
            set dx = curX - prevX
            set dy = curY - prevY
            set movedDist2 = dx * dx + dy * dy
            set moved = movedDist2 > 100.0
            call SaveReal(PAX_Boss_HT, h, 3, curX)
            call SaveReal(PAX_Boss_HT, h, 4, curY)
            set lastCombat = LoadReal(Ab_HT, h, 60)
            set lastActive = LoadReal(PAX_Boss_HT, h, 5)
            set returning = LoadInteger(PAX_Boss_HT, h, 6)
            set returnStart = LoadReal(PAX_Boss_HT, h, 7)
            if lastCombat > lastActive then
                set lastActive = lastCombat
                call SaveReal(PAX_Boss_HT, h, 5, lastActive)
            endif
            set hx = LoadReal(PAX_Boss_HT, h, 0)
            set hy = LoadReal(PAX_Boss_HT, h, 1)
            set dx = curX - hx
            set dy = curY - hy
            set dist = SquareRoot(dx * dx + dy * dy)
            set maxhp = I2R(BlzGetUnitMaxHP(u))
            if LoadInteger(PAX_Boss_HT, h, 8) == 0 and maxhp > 0.0 and GetWidgetLife(u) < 0.50 * maxhp then
                call SaveInteger(PAX_Boss_HT, h, 8, 1)
                set baseDmg = BlzGetUnitBaseDamage(u, 0)
                if baseDmg > 0 then
                    call BlzSetUnitBaseDamage(u, R2I(I2R(baseDmg) * 1.35), 0)
                endif
                call BlzSetUnitArmor(u, BlzGetUnitArmor(u) + 12.0)
                set curAtkCd = BlzGetUnitAttackCooldown(u, 0)
                if curAtkCd > 0.35 then
                    set curAtkCd = curAtkCd * 0.72
                    if curAtkCd < 0.35 then
                        set curAtkCd = 0.35
                    endif
                    call BlzSetUnitAttackCooldown(u, curAtkCd, 0)
                endif
                call SetUnitVertexColor(u, 255, 110, 110, 255)
                set curScale = BlzGetUnitRealField(u, UNIT_RF_SCALING_VALUE) * 1.15
                if curScale > 0.5 then
                    call SetUnitScale(u, curScale, curScale, curScale)
                endif
                call AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", u, "origin")
                call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", curX, curY))
                set rageTag = CreateTextTag()
                call SetTextTagText(rageTag, "|cffff4444ENRAGED! (+ATK/DEF/AS)|r", 0.026)
                call SetTextTagPos(rageTag, curX - 75.0, curY, 120.0)
                call SetTextTagVelocity(rageTag, 0.0, 0.025)
                call SetTextTagPermanent(rageTag, false)
                call SetTextTagLifespan(rageTag, 3.0)
                call SetTextTagFadepoint(rageTag, 1.8)
                call SetTextTagVisibility(rageTag, true)
                set rageTag = null
                call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffff5c5c[BOSS ENRAGED!]|r |cffffd166" + GetUnitName(u) + "|r |cffe8ecf2dropped below 50% HP (+35% ATK, +25% Skill, +12 Armor, +38% AS)!|r")
            endif
            if returning == 1 then
                if lastCombat > returnStart then
                    call SaveInteger(PAX_Boss_HT, h, 6, 0)
                    call SaveReal(PAX_Boss_HT, h, 5, Mega_Time)
                else
                    if GetWidgetLife(u) < maxhp then
                        call SetWidgetLife(u, RMinBJ(maxhp, GetWidgetLife(u) + 0.02 * maxhp))
                    endif
                    if dist > 2500.0 then
                        call SetUnitPosition(u, hx, hy)
                        call IssueImmediateOrder(u, "stop")
                        call SaveInteger(PAX_Boss_HT, h, 6, 0)
                        call SaveReal(PAX_Boss_HT, h, 3, hx)
                        call SaveReal(PAX_Boss_HT, h, 4, hy)
                        call SaveReal(PAX_Boss_HT, h, 5, Mega_Time)
                    elseif dist > 250.0 then
                        call IssuePointOrder(u, "move", hx, hy)
                    else
                        call SaveInteger(PAX_Boss_HT, h, 6, 0)
                    endif
                endif
            else
                if moved then
                    set lastActive = Mega_Time
                    call SaveReal(PAX_Boss_HT, h, 5, lastActive)
                elseif Mega_Time - lastActive >= 10.0 then
                    if GetWidgetLife(u) < maxhp then
                        call SetWidgetLife(u, RMinBJ(maxhp, GetWidgetLife(u) + 0.02 * maxhp))
                    endif
                if dist > 2500.0 then
                    call SetUnitPosition(u, hx, hy)
                    call IssueImmediateOrder(u, "stop")
                    call SaveReal(PAX_Boss_HT, h, 3, hx)
                    call SaveReal(PAX_Boss_HT, h, 4, hy)
                    call SaveReal(PAX_Boss_HT, h, 5, Mega_Time)
                elseif dist > 250.0 then
                    call SaveInteger(PAX_Boss_HT, h, 6, 1)
                    call SaveReal(PAX_Boss_HT, h, 7, Mega_Time)
                    call IssuePointOrder(u, "move", hx, hy)
                endif
                endif
            endif
        endif
    endloop
    call DestroyGroup(PAX_Leg_G)
    set PAX_Leg_G = keep
    set keep = null
    set u = null
endfunction

function PAX_Leg_Float takes unit u, string msg, integer r, integer g, integer b, player plA, player plB returns nothing
    local texttag tt = null
    if u == null then
        set tt = null
        return
    endif
    set tt = CreateTextTag()
    call SetTextTagText(tt, msg, 0.023)
    call SetTextTagPos(tt, GetUnitX(u), GetUnitY(u), 55.0)
    call SetTextTagColor(tt, r, g, b, 255)
    call SetTextTagVelocity(tt, 0.0, 0.03)
    call SetTextTagPermanent(tt, false)
    call SetTextTagLifespan(tt, 1.5)
    call SetTextTagFadepoint(tt, 0.8)
    call SetTextTagVisibility(tt, GetLocalPlayer() == plA or GetLocalPlayer() == plB)
    set tt = null
endfunction

function PAX_HealMult takes unit u returns real
    local integer h = 0
    if u == null then
        return 1.0
    endif
    set h = GetHandleId(u)
    if Mega_Time < LoadReal(Fx_HT, h, 81) or Mega_Time < LoadReal(Fx_HT, h, 83) then
        return 0.60
    endif
    return 1.0
endfunction

function PAX_HealUnit takes unit u, real amount returns nothing
    local real maxhp = 0.0
    local real cur = 0.0
    if u == null or amount <= 0.0 or GetWidgetLife(u) <= 0.405 then
        return
    endif
    set maxhp = I2R(BlzGetUnitMaxHP(u))
    set cur = GetWidgetLife(u) + amount * PAX_HealMult(u)
    if cur > maxhp then
        set cur = maxhp
    endif
    call SetWidgetLife(u, cur)
endfunction

function PAX_Rainbow takes string text returns string
    local string colors = "ffffd166ffffe599ffffba33fffff2cc"
    local string result = ""
    local string ch = ""
    local integer i = 0
    local integer color = 0
    local integer n = StringLength(text)
    loop
        exitwhen i >= n
        set ch = SubString(text, i, i + 1)
        set i = i + 1
        if ch == " " then
            set result = result + ch
        else
            set result = result + "|c" + SubString(colors, color, color + 8) + ch
            set color = color + 8
            if color == 32 then
                set color = 0
            endif
        endif
    endloop
    return result + "|r"
endfunction

function PAX_Announce takes string msg, real duration returns nothing
    local integer pid = 0
    loop
        exitwhen pid >= bj_MAX_PLAYER_SLOTS
        call DisplayTimedTextToPlayer(Player(pid), 0, 0, duration, msg)
        set pid = pid + 1
    endloop
endfunction

function PAX_MajorEvent takes string barColor, string tagText, string body, real duration returns nothing
    local string bar = barColor + "======================================|r"
    call PAX_Announce(bar, duration)
    call PAX_Announce("  " + barColor + tagText + "|r  |cffe8ecf2" + body + "|r", duration)
    call PAX_Announce(bar, duration)
endfunction

function PAX_Celebrate takes unit u, string floatMsg, string fxPath returns nothing
    local player p = null
    if u == null then
        return
    endif
    set p = GetOwningPlayer(u)
    call PAX_Leg_Float(u, PAX_Rainbow(floatMsg), 255, 255, 255, p, p)
    if fxPath != "" then
        call DestroyEffect(AddSpecialEffectTarget(fxPath, u, "origin"))
    endif
    set p = null
endfunction

// These labels and auras are intentionally kept for the match lifetime.
function PAX_MapLabel takes string label, real x, real y, real height returns nothing
    local texttag tt = CreateTextTag()
    call SetTextTagText(tt, label, 0.015)
    call SetTextTagPos(tt, x, y, height)
    call SetTextTagColor(tt, 255, 255, 255, 255)
    call SetTextTagPermanent(tt, true)
    call SetTextTagVisibility(tt, true)
    set PAX_DecorLabels[PAX_DecorLabelCount] = tt
    set PAX_DecorLabelCount = PAX_DecorLabelCount + 1
    set tt = null
endfunction

function PAX_MapAura takes string model, unit anchor, real x, real y, real scale returns nothing
    local effect fx = null
    if anchor == null then
        set fx = AddSpecialEffect(model, x, y)
    else
        set fx = AddSpecialEffectTarget(model, anchor, "origin")
    endif
    if fx != null then
        call BlzSetSpecialEffectScale(fx, scale)
        set PAX_DecorEffects[PAX_DecorEffectCount] = fx
        set PAX_DecorEffectCount = PAX_DecorEffectCount + 1
    endif
    set fx = null
endfunction

function PAX_GetHost takes nothing returns player
    local integer pid = 0
    local player candidate = null
    if PAX_HostPlayer != null and GetPlayerSlotState(PAX_HostPlayer) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(PAX_HostPlayer) == MAP_CONTROL_USER then
        return PAX_HostPlayer
    endif
    set PAX_HostPlayer = Player(0)
    loop
        exitwhen pid >= 12
        set candidate = Player(pid)
        if GetPlayerSlotState(candidate) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(candidate) == MAP_CONTROL_USER then
            set PAX_HostPlayer = candidate
            exitwhen true
        endif
        set pid = pid + 1
    endloop
    set candidate = null
    return PAX_HostPlayer
endfunction

function PAX_FogCmd takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local player host = PAX_GetHost()
    if p != host then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffff4040Only the host (" + GetPlayerName(host) + ") can toggle map vision.|r")
    else
        set PAX_FogEnabled = not PAX_FogEnabled
        call FogEnable(PAX_FogEnabled)
        call FogMaskEnable(PAX_FogEnabled)
        if PAX_FogEnabled then
            call PAX_Announce("|cff7dd3fc[VISION]|r |cffe8ecf2Team Vision (Fog of War)|r", 7.0)
        else
            call PAX_Announce("|cff7dd3fc[VISION]|r |cffe8ecf2Full Map Vision|r", 7.0)
        endif
    endif
    set p = null
    set host = null
endfunction

function PAX_HostLeave takes nothing returns nothing
    if GetTriggerPlayer() == PAX_HostPlayer then
        set PAX_HostPlayer = null
    endif
endfunction

function PAX_WelcomeBanner takes nothing returns nothing
    local timer tm = GetExpiredTimer()
    local string bar = "|cffffd166======================================|r"
    call DestroyTimer(tm)
    set tm = null
    call PAX_Announce(bar, 10.0)
    call PAX_Announce("  |cffffd166POKEMON ARENA v4.1.2-ver2m|r  |cff94a3b8- PvP & Legend Balance|r", 10.0)
    call PAX_Announce("  |cff7dd3fc-help|r |cffe8ecf2All Commands  |  |cff7dd3fc-up|r |cffe8ecf2Train  |  |cff7dd3fc-quest|r |cffe8ecf2Awakening  |  |cff7dd3fc-solo|r |cffe8ecf21v1 Loot  |  |cff7dd3fc-pet|r |cffe8ecf2Mini Pet|r", 10.0)
    call PAX_Announce("  |cffe8ecf2Base Shops:|r |cffffd166Form Shop|r |cff64748b/|r |cffd896ffParadox Form Shop|r", 10.0)
    call PAX_Announce(bar, 10.0)
endfunction

function PAX_DecorateMap takes nothing returns nothing
    local timer tm = CreateTimer()
    local integer side = -1
    local real x = 0.0
    call PAX_MapAura("PkFx\\White_Spell_Aura_1.mdx", null, -128.0, 16.0, 0.45)
    call PAX_MapLabel("|cffffcc66Awakening Altar|r", -190.0, 16.0, 155.0)
    loop
        exitwhen side > 1
        set x = 4820.0 * I2R(side)
        // decorative base auras removed to prevent path clutter
        // call PAX_MapAura("Abilities\\Spells\\Human\\Brilliance\\Brilliance.mdl", null, x, 120.0, 0.55)
        set side = side + 2
    endloop
    call TimerStart(tm, 4.0, false, function PAX_WelcomeBanner)
    set tm = null
endfunction

function PAX_Title_Bit takes integer tid returns integer
    if tid == 1 then
        return 1
    elseif tid == 2 then
        return 2
    elseif tid == 3 then
        return 4
    elseif tid == 4 then
        return 8
    elseif tid == 5 then
        return 16
    elseif tid == 6 then
        return 32
    elseif tid == 7 then
        return 64
    elseif tid == 8 then
        return 128
    elseif tid == 9 then
        return 256
    elseif tid == 10 then
        return 512
    elseif tid == 11 then
        return 1024
    elseif tid == 12 then
        return 2048
    elseif tid == 13 then
        return 4096
    elseif tid == 14 then
        return 8192
    endif
    return 0
endfunction

function PAX_Title_Has takes integer pid, integer tid returns boolean
    local integer bit = PAX_Title_Bit(tid)
    if pid < 0 or pid >= 12 or bit == 0 then
        return false
    endif
    return ModuloInteger(PAX_TitleMask[pid] / bit, 2) == 1
endfunction

function PAX_Title_Text takes integer tid returns string
    if tid == 1 then
        return PAX_Rainbow("[CHAMPION]")
    elseif tid == 2 then
        return "|cffff5c5c[SLAYER]|r"
    elseif tid == 3 then
        return "|cffd896ff[GODSLAYER]|r"
    elseif tid == 4 then
        return "|cffffd166[JACKPOT KING]|r"
    elseif tid == 5 then
        return "|cff4ade80[RICH KID]|r"
    elseif tid == 6 then
        return "|cff38bdf8[UNTOUCHABLE]|r"
    elseif tid == 7 then
        return "|cffff3366[MYTHIC SMITH]|r"
    elseif tid == 8 then
        return "|cffff9f43[BANDIT KING]|r"
    elseif tid == 9 then
        return "|cff94a3b8[THANH NHO]|r"
    elseif tid == 10 then
        return "|cffff6b6b[PHOENIX]|r"
    elseif tid == 11 then
        return "|cffff0055[DEMON LORD]|r"
    elseif tid == 12 then
        return "|cff38bdf8[RUNE MASTER]|r"
    elseif tid == 13 then
        return "|cffffd166[TREASURE HUNTER]|r"
    elseif tid == 14 then
        return "|cffd896ff[CHAOS WALKER]|r"
    endif
    return ""
endfunction

function PAX_Title_Unlock takes integer pid, integer tid returns nothing
    local integer bit = PAX_Title_Bit(tid)
    local integer addStat = 0
    local integer addArm = 0
    local integer addGold = 0
    local string secretNote = ""
    if pid < 0 or pid >= 12 or bit == 0 or PAX_Title_Has(pid, tid) then
        return
    endif
    set PAX_TitleMask[pid] = PAX_TitleMask[pid] + bit
    if PAX_TitleCur[pid] == 0 or tid == 1 or tid >= 7 then
        set PAX_TitleCur[pid] = tid
    endif
    if tid == 7 then
        set addStat = 50
        set addArm = 15
        set secretNote = "+50 All Stats & +15 Armor"
    elseif tid == 8 then
        set addStat = 45
        set addGold = 1000
        set secretNote = "+45 All Stats & +1,000g"
    elseif tid == 9 then
        set addStat = 35
        set addGold = 2000
        set secretNote = "+35 All Stats & +2,000g (Troi thuong Thanh Nho! =)))"
    elseif tid == 10 then
        set addStat = 45
        set secretNote = "+45 All Stats"
    elseif tid == 11 then
        set addStat = 60
        set secretNote = "+60 All Stats"
    elseif tid == 12 then
        set addStat = 40
        set addGold = 1000
        set secretNote = "+40 All Stats & +1,000g"
    elseif tid == 13 then
        set addStat = 45
        set addGold = 1200
        set secretNote = "+45 All Stats & +1,200g"
    elseif tid == 14 then
        set addStat = 35
        set addGold = 800
        set secretNote = "+35 All Stats & +800g"
    endif
    if addStat > 0 then
        set PAX_Title_BonusStat[pid] = PAX_Title_BonusStat[pid] + addStat
    endif
    if addArm > 0 then
        set PAX_Title_BonusArm[pid] = PAX_Title_BonusArm[pid] + addArm
    endif
    if addGold > 0 then
        call AdjustPlayerStateBJ(addGold, Player(pid), PLAYER_STATE_RESOURCE_GOLD)
    endif
    if tid >= 7 then
        call PAX_Announce("|cffd896ff[SECRET TITLE UNLOCKED!]|r |cff7dd3fc" + GetPlayerName(Player(pid)) + "|r discovered " + PAX_Title_Text(tid) + " (|cffffd166" + secretNote + "|r)!", 9.0)
    else
        call DisplayTimedTextToPlayer(Player(pid), 0, 0, 8.0, "|cffffd166[TITLE UNLOCKED]|r |cffe8ecf2Earned|r " + PAX_Title_Text(tid) + "|cffe8ecf2! Type|r |cff7dd3fc-title|r |cffe8ecf2to switch or hide.|r")
    endif
endfunction

// Per hero: key 160 stores the title, key 161 stores its slot in PAX_ChampUnits, key 162 stores displayed title id.
function PAX_Champ_Sync takes unit u returns nothing
    local integer h = 0
    local integer pid = 0
    local integer slot = 0
    local integer tid = 0
    local boolean eligible = false
    local texttag tt = null
    if u == null then
        return
    endif
    set h = GetHandleId(u)
    if GetUnitTypeId(u) != 0 and GetWidgetLife(u) > 0.405 and IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitType(u, UNIT_TYPE_DEAD) then
        set pid = GetPlayerId(GetOwningPlayer(u))
        if pid < 12 then
            if League_Champ[pid] then
                call PAX_Title_Unlock(pid, 1)
            endif
            if F9[pid + 1] >= 5 then
                call PAX_Title_Unlock(pid, 2)
            endif
            if GetPlayerState(Player(pid), PLAYER_STATE_RESOURCE_GOLD) >= 20000 then
                call PAX_Title_Unlock(pid, 5)
            endif
            set tid = PAX_TitleCur[pid]
            if tid > 0 and PAX_Title_Has(pid, tid) then
                set eligible = true
            endif
        endif
    endif
    set tt = LoadTextTagHandle(PAX_Leg_HT, h, 160)
    if eligible then
        if tt == null then
            set tt = CreateTextTag()
            if tt != null then
                if SaveTextTagHandle(PAX_Leg_HT, h, 160, tt) then
                    call SetTextTagText(tt, PAX_Title_Text(tid), 0.015)
                    call SetTextTagColor(tt, 255, 255, 255, 255)
                    call SetTextTagPermanent(tt, true)
                    call SetTextTagVisibility(tt, true)
                    call SaveInteger(PAX_Leg_HT, h, 162, tid)
                    call GroupAddUnit(PAX_ChampG, u)
                    set PAX_ChampCount = PAX_ChampCount + 1
                    set PAX_ChampUnits[PAX_ChampCount] = u
                    call SaveInteger(PAX_Leg_HT, h, 161, PAX_ChampCount)
                else
                    call DestroyTextTag(tt)
                    set tt = null
                endif
            endif
        elseif LoadInteger(PAX_Leg_HT, h, 162) != tid then
            call SetTextTagText(tt, PAX_Title_Text(tid), 0.015)
            call SaveInteger(PAX_Leg_HT, h, 162, tid)
        endif
        if tt != null then
            call SetTextTagPos(tt, GetUnitX(u) - 42.0, GetUnitY(u), 120.0 + GetUnitFlyHeight(u))
        endif
    else
        if tt != null then
            call DestroyTextTag(tt)
        endif
        if HaveSavedHandle(PAX_Leg_HT, h, 160) then
            call RemoveSavedHandle(PAX_Leg_HT, h, 160)
        endif
        call SaveInteger(PAX_Leg_HT, h, 162, 0)
        call GroupRemoveUnit(PAX_ChampG, u)
        set slot = LoadInteger(PAX_Leg_HT, h, 161)
        if slot > 0 then
            if slot != PAX_ChampCount then
                set PAX_ChampUnits[slot] = PAX_ChampUnits[PAX_ChampCount]
                call SaveInteger(PAX_Leg_HT, GetHandleId(PAX_ChampUnits[slot]), 161, slot)
            endif
            set PAX_ChampUnits[PAX_ChampCount] = null
            set PAX_ChampCount = PAX_ChampCount - 1
            call RemoveSavedInteger(PAX_Leg_HT, h, 161)
        endif
    endif
    set tt = null
endfunction

function PAX_Champ_Tick takes nothing returns nothing
    local unit u = null
    local integer slot = 0
    if PAX_ChampCount == 0 then
        return
    endif
    call GroupAddGroup(PAX_ChampG, PAX_ChampScanG)
    loop
        set u = FirstOfGroup(PAX_ChampScanG)
        exitwhen u == null
        call GroupRemoveUnit(PAX_ChampScanG, u)
        call PAX_Champ_Sync(u)
    endloop
    call GroupClear(PAX_ChampScanG)
    // Removed units can disappear from group enumeration before their title is cleaned up.
    set slot = PAX_ChampCount
    loop
        exitwhen slot < 1
        set u = PAX_ChampUnits[slot]
        if GetUnitTypeId(u) == 0 then
            call PAX_Champ_Sync(u)
        endif
        set slot = slot - 1
    endloop
    set u = null
endfunction

function PAX_Leg_SpawnDummy takes real x, real y, real face, boolean canAtk, boolean fixedHome returns unit
    local unit u = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'n00H', x, y, face)
    local integer h = 0
    if u == null then
        return null
    endif
    set h = GetHandleId(u)
    call SaveInteger(Mega_HT, h, 33, 1)
    call BlzSetUnitName(u, "Training Dummy")
    call BlzSetUnitMaxHP(u, 500000)
    call SetWidgetLife(u, 500000.0)
    call BlzSetUnitArmor(u, 50.0)
    call SetUnitMoveSpeed(u, 0.0)
    if canAtk then
        call BlzSetUnitBaseDamage(u, 1, 0)
        call SetUnitAcquireRange(u, 500.0)
    else
        call BlzSetUnitBaseDamage(u, 0, 0)
        call SetUnitAcquireRange(u, 0.0)
    endif
    call SaveInteger(PAX_Leg_HT, h, 96, 1)
    if fixedHome then
        call SaveInteger(PAX_Leg_HT, h, 96, 2)
    endif
    call SaveReal(PAX_Leg_HT, h, 97, x)
    call SaveReal(PAX_Leg_HT, h, 98, y)
    call GroupAddUnit(PAX_Leg_DummyG, u)
    call PAX_Leg_Float(u, "Dummy 500k HP", 255, 220, 80, GetLocalPlayer(), GetLocalPlayer())
    return u
endfunction

function PAX_Leg_DummyCmd takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local unit u = null
    local unit dmy = null
    local string cmd = StringCase(GetEventPlayerChatString(), false)
    local boolean canAtk = false
    if cmd != "-dummy" and cmd != "-dummy atk" then
        set dmy = null
        set u = null
        set p = null
        return
    endif
    set canAtk = cmd == "-dummy atk"
    call GroupClear(Rand_Tmp)
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if IsUnitType(u, UNIT_TYPE_HERO) and GetWidgetLife(u) > 0.405 then
            set dmy = PAX_Leg_SpawnDummy(GetUnitX(u) + 220.0, GetUnitY(u), GetUnitFacing(u), canAtk, false)
            exitwhen true
        endif
    endloop
    if dmy == null then
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00-dummy: no living Pokemon.|r")
    else
        if canAtk then
            call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00Spawned attacking training dummy.|r")
        else
            call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00Spawned training dummy.|r")
        endif
    endif
    set dmy = null
    set u = null
    set p = null
endfunction

