function Fx_Init takes nothing returns nothing
    local trigger t = null
    local integer i = 0
    call ExecuteFunc("Fx_Data1")
    call ExecuteFunc("Fx_Data2")
    call ExecuteFunc("Fx_Data3")
    call ExecuteFunc("Fx_Data4")
    call ExecuteFunc("Fx_Data5")
    call ExecuteFunc("Fx_Data6")
    call ExecuteFunc("Fx_Data7")
    call ExecuteFunc("Fx_Data8")
    call ExecuteFunc("Fx_Data9")
    call ExecuteFunc("Fx_Data10")
    call ExecuteFunc("Fx_Data11")
    call ExecuteFunc("Fx_Data12")
    call ExecuteFunc("Fx_Data13")
    call ExecuteFunc("Fx_Data14")
    call ExecuteFunc("Fx_Data15")
    call ExecuteFunc("Fx_Data16")
    call ExecuteFunc("Fx_Texts")
    call ExecuteFunc("Dyna_Data")
    set Fx_StatName[1] = "Attack"
    set Fx_StatName[2] = "Defense"
    set Fx_StatName[3] = "Sp. Atk"
    set Fx_StatName[4] = "Sp. Def"
    set Fx_StatName[5] = "Speed"
    set Fx_StName[1] = "Burned!"
    set Fx_StName[2] = "Poisoned!"
    set Fx_StName[3] = "Badly poisoned!"
    set Fx_StName[4] = "Paralyzed!"
    set Fx_StName[5] = "Asleep!"
    set Fx_StName[6] = "Frozen!"
    set Fx_StatShort[1] = "Atk"
    set Fx_StatShort[2] = "Def"
    set Fx_StatShort[3] = "SpA"
    set Fx_StatShort[4] = "SpD"
    set Fx_StatShort[5] = "Spe"
    set Fx_StShort[1] = "Burn"
    set Fx_StShort[2] = "Poison"
    set Fx_StShort[3] = "Toxic"
    set Fx_StShort[4] = "Para"
    set Fx_StShort[5] = "Sleep"
    set Fx_StShort[6] = "Frozen"
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(t, Condition(function Fx_OnSpellCast))
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_ENDCAST)
    call TriggerAddCondition(t, Condition(function Fx_OnEndCast))
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(t, Condition(function Fx_OnDeath))
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SELL_ITEM)
    call TriggerAddCondition(t, Condition(function Fx_OnSell))
    set t = CreateTrigger()
    loop
        exitwhen i >= 12
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-tp", true)
        set i = i + 1
    endloop
    call TriggerAddAction(t, function Fx_TpChat)
    set t = CreateTrigger()
    set i = 0
    loop
        exitwhen i >= 12
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-home", true)
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-stuck", true)
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-unstuck", true)
        set i = i + 1
    endloop
    call TriggerAddAction(t, function Fx_HomeChat)
    call TimerStart(CreateTimer(), 0.5, true, function Fx_Tick)
    call TimerStart(CreateTimer(), 0.5, true, function Fx_LeagueTick)
    call Fx_LeagueSetup()
    set t = null
endfunction

function Ext_AfterHit takes unit src, unit t, boolean atk, real d returns nothing
    local real mx = 0.0
    if IsUnitType(src, UNIT_TYPE_HERO) then
        set mx = I2R(BlzGetUnitMaxHP(src))
        if Itm_Flag(src, 0) and GetWidgetLife(src) - 0.01 * mx > 0.2 * mx then  // Life Orb
            call SetWidgetLife(src, GetWidgetLife(src) - 0.01 * mx)
        endif
        if atk and Itm_Flag(src, 10) and GetRandomReal(0.0, 1.0) < 0.1 then  // King's Rock
            set Ab_FxCur = src
            call Ab_FxAdd(t, 3, 1.0, 0.0)
            set Ab_FxCur = null
        endif
    endif
    if atk and IsUnitType(t, UNIT_TYPE_HERO) and Itm_Flag(t, 7) and BlzGetUnitWeaponRealField(src, UNIT_WEAPON_RF_ATTACK_RANGE, 0) <= 250.0 then
        call Ab_Deal(t, src, 0.03 * I2R(BlzGetUnitMaxHP(src)))  // Rocky Helmet
    endif
endfunction

// Focus Sash: the final damage d of a hit on t
function Ext_Final takes unit t, real d returns real
    local integer ht = GetHandleId(t)
    if IsUnitType(t, UNIT_TYPE_HERO) and Itm_Flag(t, 5) and d >= GetWidgetLife(t) - 0.405 then
        if GetWidgetLife(t) > 0.5 * I2R(BlzGetUnitMaxHP(t)) and Mega_Time >= LoadReal(Ab_HT, ht, 126) then
            call SaveReal(Ab_HT, ht, 126, Mega_Time + 60.0)
            call Ab_Say(t, "Focus Sash!", 255, 200, 60, GetOwningPlayer(t), GetOwningPlayer(t))
            return GetWidgetLife(t) - 1.0
        endif
    endif
    return d
endfunction

// pct % more Str / Agi / Int (Shiny 10, Champion 15); keys 120..122 hold what was added
function Ext_Bonus takes unit u, integer pct returns nothing
    local integer h = GetHandleId(u)
    local integer strOld = LoadInteger(Ab_HT, h, 120)
    local integer agiOld = LoadInteger(Ab_HT, h, 121)
    local integer intOld = LoadInteger(Ab_HT, h, 122)
    local integer strNew = (GetHeroStr(u, false) - strOld) * pct / 100
    local integer agiNew = (GetHeroAgi(u, false) - agiOld) * pct / 100
    local integer intNew = (GetHeroInt(u, false) - intOld) * pct / 100
    if strNew != strOld then
        call SetHeroStr(u, GetHeroStr(u, false) - strOld + strNew, true)
        call SaveInteger(Ab_HT, h, 120, strNew)
    endif
    if agiNew != agiOld then
        call SetHeroAgi(u, GetHeroAgi(u, false) - agiOld + agiNew, true)
        call SaveInteger(Ab_HT, h, 121, agiNew)
    endif
    if intNew != intOld then
        call SetHeroInt(u, GetHeroInt(u, false) - intOld + intNew, true)
        call SaveInteger(Ab_HT, h, 122, intNew)
    endif
endfunction

// every second for each hero of the players (Ab_Hero)
function Ext_Pulse takes unit u returns nothing
    local integer h = GetHandleId(u)
    local player p = GetOwningPlayer(u)
    local integer pid = GetPlayerId(p)
    local real mx = I2R(BlzGetUnitMaxHP(u))
    local integer xp = GetHeroXP(u)
    local integer last = LoadInteger(Ab_HT, h, 127)
    local integer pct = 0
    local unit v = null
    call Itm_Refresh(u)
    if Itm_Flag(u, 4) then  // Leftovers
        call Ab_Heal(u, 0.01 * mx)
    endif
    if Itm_Flag(u, 15) and GetWidgetLife(u) < 0.5 * mx then  // Sitrus Berry
        call Ab_Heal(u, 0.25 * mx)
        call Itm_Use(u, Itm_Id[15])
        call Ab_Say(u, "Sitrus Berry", 120, 255, 120, p, p)
    endif
    if Itm_Flag(u, 16) and Ab_HasBad(u) then  // Lum Berry
        call Ab_Cleanse(u)
        call Itm_Use(u, Itm_Id[16])
        call Ab_Say(u, "Lum Berry", 120, 255, 120, p, p)
    endif
    if Itm_Flag(u, 12) and last > 0 and xp > last and not IsSuspendedXP(u) then  // Lucky Egg
        call AddHeroXP(u, (xp - last) / 2, true)
    endif
    call SaveInteger(Ab_HT, h, 127, GetHeroXP(u))
    // sandstorm / hail: 1% max HP every 2 seconds (not below 10%, suppressed by Strong Winds)
    if (Wth_Cur == 3 or Wth_Cur == 4) and Mega_Time >= LoadReal(Fx_HT, h, 104) and ModuloInteger(Ab_Beat / 2, 2) == 0 and GetWidgetLife(u) > 0.1 * mx + 0.01 * mx then
        if (Wth_Cur == 3 and not Ty_Has(u, T_ROCK) and not Ty_Has(u, T_GROUND) and not Ty_Has(u, T_STEEL)) or (Wth_Cur == 4 and not Ty_Has(u, T_ICE)) then
            call SetWidgetLife(u, GetWidgetLife(u) - 0.01 * mx)
        endif
    endif
    if LoadInteger(Ab_HT, h, 123) == 1 then
        call Shiny_Tint(u)
        if ModuloInteger(Ab_Beat / 2, 5) == 0 then
            call Ab_Pop(u, "Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", "overhead")
        endif
        set pct = pct + 10
    endif
    if pid < 12 and League_Champ[pid] then
        set pct = pct + 15
        if not HaveSavedHandle(Ab_HT, h, 129) then
            call SaveEffectHandle(Ab_HT, h, 129, AddSpecialEffectTarget("Abilities\\Spells\\Human\\DevotionAura\\DevotionAura.mdl", u, "origin"))
        endif
        // Champion Aura: allied Pokemon within 800 (and itself) deal 10% more and take 10% less damage
        call GroupEnumUnitsInRange(Ext_G, GetUnitX(u), GetUnitY(u), 800.0, null)
        loop
            set v = FirstOfGroup(Ext_G)
            exitwhen v == null
            call GroupRemoveUnit(Ext_G, v)
            if IsUnitType(v, UNIT_TYPE_HERO) and GetWidgetLife(v) > 0.405 and IsUnitAlly(v, p) then
                call SaveReal(Ab_HT, GetHandleId(v), 128, Mega_Time + 1.5)
            endif
        endloop
    endif
    call Ext_Bonus(u, pct)
    set p = null
endfunction

function Ext_OnPickup takes nothing returns boolean
    local unit u = GetTriggerUnit()
    local item it = GetManipulatedItem()
    if IsUnitType(u, UNIT_TYPE_HERO) then
        if it != null and PAX_IsLootItemId(GetItemTypeId(it)) and PAX_Loot_ContainsItem(u, it) then
            call SaveInteger(PAX_Item_HT, GetHandleId(it), 19, 1)
        endif
        call PAX_GodChu_OnPickup(u, it)
        call Itm_Refresh(u)
        call Fx_OnPickup(u, it)  // v3.4.11
        call PAX_TestItem_Sync(u)
        call Hero_HPSync(u)
    endif
    set u = null
    set it = null
    return false
endfunction

function PAX_TestItem_OnDrop takes nothing returns boolean
    local unit u = GetManipulatingUnit()
    local item it = GetManipulatedItem()
    if it != null and PAX_IsLootItemId(GetItemTypeId(it)) then
        call PAX_TestItem_SyncEx(u, it)
        call Hero_HPSync(u)
    endif
    set u = null
    set it = null
    return false
endfunction

// Amulet Coin: +50% of the bounty of what its holder kills
function Ext_OnKill takes nothing returns boolean
    local unit k = GetKillingUnit()
    local unit d = GetTriggerUnit()
    local integer gold = 0
    if k != null and IsUnitType(k, UNIT_TYPE_HERO) and GetWidgetLife(k) > 0.405 and GetPlayerId(GetOwningPlayer(k)) < 12 and IsUnitEnemy(d, GetOwningPlayer(k)) then
        call PAX_Loot_OnKill(k, d)
    endif
    if k != null and IsUnitType(k, UNIT_TYPE_HERO) and GetPlayerId(GetOwningPlayer(k)) < 12 and Itm_Flag(k, 13) and IsUnitEnemy(d, GetOwningPlayer(k)) then
        set gold = BlzGetUnitIntegerField(d, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE) / 2
        if gold > 0 then
            call AdjustPlayerStateBJ(gold, GetOwningPlayer(k), PLAYER_STATE_RESOURCE_GOLD)
            call Ab_Say(k, "+" + I2S(gold) + " gold", 255, 220, 0, GetOwningPlayer(k), GetOwningPlayer(k))
        endif
    endif
    set k = null
    set d = null
    return false
endfunction

// Escape Rope (a trigger action: it waits 3 seconds)
function Ext_OnUseItem takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local player p = GetOwningPlayer(u)
    local integer pid = GetPlayerId(p)
    local real x = 0.0
    local real y = 0.0
    if GetItemTypeId(GetManipulatedItem()) == Itm_Rope and pid < 12 then
        if Gym_Busy(pid) then
            call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffff4040No Escape Rope during a gym or League battle.|r")
            call UnitAddItemById(u, Itm_Rope)
        else
            call DisplayTimedTextToPlayer(p, 0, 0, 3.0, "|cffffcc00Escape Rope: back to base in 3 seconds...|r")
            call TriggerSleepAction(3.0)
            if GetWidgetLife(u) > 0.405 and not Gym_Busy(pid) then
                set x = GetStartLocationX(GetPlayerStartLocation(p))
                set y = GetStartLocationY(GetPlayerStartLocation(p))
                call SetUnitPosition(u, x, y)
                call PanCameraToTimedForPlayer(p, x, y, 0.3)
                call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", x, y))
            endif
        endif
    endif
    set u = null
    set p = null
endfunction

// Battle Shop and Item Shop next to the Mega Shops of both bases: the first free walkable spots of a list
function Ext_ShopSpot takes real x, real y returns boolean
    local unit v = null
    local boolean ok = not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY)
    if ok then
        call GroupEnumUnitsInRange(Ext_G, x, y, 170.0, null)
        set v = FirstOfGroup(Ext_G)
        set ok = v == null
        call GroupClear(Ext_G)
    endif
    set v = null
    return ok
endfunction

function Ext_PlaceShops takes nothing returns nothing
    local integer side = 0
    local real sx = 0.0
    local real x = 0.0
    local real face = 0.0
    local unit shop = null
    loop
        exitwhen side >= 2
        set sx = -1.0
        set face = 0.0
        if side == 1 then
            set sx = 1.0
            set face = 180.0
        endif
        // Top row (Y = 544.0, Facing South 270.0): Item Shop (nIS0 at 5440.0)
        set x = sx * 5440.0
        set shop = CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'nIS0', x, 544.0, 270.0)
        call PAX_MapLabel("|cffffcc00Item Shop|r", x - 38.0, 544.0, 165.0)

        // Bottom row (Y = -544.0, Facing North 90.0): Form Shop (nFS0 at 5440.0)
        set x = sx * 5440.0
        set shop = CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'nFS0', x, -544.0, 90.0)
        if shop != null then
            call SetUnitVertexColor(shop, 255, 215, 80, 255)
            call PAX_MapLabel("|cffffd750Form Shop|r", x - 42.0, -544.0, 165.0)
        endif

        // Vertical column along back wall (X = sx * 5950.0, aligned with PC Center at Y = 0.0):
        // Battle Shop at Y = +240.0 (Facing lawn)
        set x = sx * 5950.0
        set shop = CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'nBS0', x, 240.0, face)
        call PAX_MapLabel("|cffffcc00Battle Shop|r", x - 42.0, 240.0, 165.0)

        // Paradox Shop at Y = -240.0 (Facing lawn)
        set shop = CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'nFS1', x, -240.0, face)
        if shop != null then
            call SetUnitVertexColor(shop, 170, 130, 255, 255)
            call PAX_MapLabel("|cffd899ffParadox|r", x - 34.0, -240.0, 165.0)
        endif

        // Haunt Legend Mid Teleport Portal (Circle of Power next to Haunt Legend at Y = -sx * 740.0)
        call AddSpecialEffect("buildings\\other\\CircleOfPower\\CircleOfPower.mdl", sx * 5120.0, -sx * 740.0)
        call PAX_MapLabel("|cff00ffffTo Mid|r", sx * 5120.0 - 24.0, -sx * 740.0, 165.0)

        set side = side + 1
    endloop
    set shop = null
endfunction

function Ab_Hero takes unit u returns nothing
    local integer a = 0
    call Mv_Sync(u)
    call Mv_Tips(u)
    call Ab_Sync(u)
    set a = Ab_Num(u)
    call Ab_Pulse(u, a)
    call Ext_Pulse(u)
endfunction

// 0.5s clock: timed effects every tick, heroes every second (every 2nd tick)
function Ab_Tick takes nothing returns nothing
    local integer pi = 0
    local unit u = null
    set Ab_Beat = Ab_Beat + 1
    call Ab_FxRun()
    if Ab_Beat - (Ab_Beat / 2) * 2 == 0 then
        loop
            exitwhen pi >= 12
            call GroupEnumUnitsOfPlayer(Ab_Tmp, Player(pi), null)
            loop
                set u = FirstOfGroup(Ab_Tmp)
                exitwhen u == null
                call GroupRemoveUnit(Ab_Tmp, u)
                if IsUnitType(u, UNIT_TYPE_HERO) and Ab_Alive(u) then
                    call Ab_Hero(u)
                endif
            endloop
            set pi = pi + 1
        endloop
    endif
    set u = null
endfunction

function Ab_OnRevive takes nothing returns nothing
    local integer h = GetHandleId(GetTriggerUnit())
    call SaveReal(Ab_HT, h, 9, Mega_Time)
    call SaveInteger(Ab_HT, h, 62, 0)  // Speed Boost starts over
    call SaveReal(Ab_HT, h, 63, 0.0)
    call SaveInteger(Ab_HT, h, 76, 0)  // Trace forgets its copy
endfunction

// condition of the one damage trigger: Leg_OnDamage first, then the skill scale, the move's type and the Abilities
function Ab_OnDamaging takes nothing returns boolean
    local unit t = BlzGetEventDamageTarget()
    local unit src = null
    local player sp = null
    local player tp = null
    local real dmg = 0.0
    local real m = 1.0
    local real stat = 0.0
    local real eff = 1.0
    local integer et = -1
    local boolean atk = false
    local boolean skill = false
    local boolean user = false
    local boolean pvp = false
    local real fxm = 1.0
    local integer ta = 0
    local integer s_ab = 0
    local integer mt = -1
    local integer hs = 0
    local integer ht = 0
    set src = GetEventDamageSource()
    if Ab_Busy or PAX_Loot_InProc or PAX_Leg_InProc or src == null or src == t then
        set t = null
        set src = null
        return false
    endif
    call Leg_OnDamage()
    set dmg = GetEventDamage()
    if dmg <= 0.0 then
        set t = null
        set src = null
        return false
    endif
    if Env_IsSource(GetUnitTypeId(src)) then  // v3.3.1: traps / dummies of the legend lands
        set m = m * Env_DamageMult
    endif
    set sp = GetOwningPlayer(src)
    if not IsUnitEnemy(t, sp) then
        set t = null
        set src = null
        set sp = null
        return false
    endif
    set tp = GetOwningPlayer(t)
    if Fx_LeagueBlock(src, t) then  // v3.4.11: no PvP into an Elite Four battle
        call BlzSetEventDamage(0.0)
        set t = null
        set src = null
        set sp = null
        set tp = null
        return false
    endif
    set atk = BlzGetEventIsAttack()
    set skill = (not atk) and BlzGetEventDamageType() != DAMAGE_TYPE_NORMAL
    set user = GetPlayerId(sp) < 12
    set hs = GetHandleId(src)
    set ht = GetHandleId(t)
    // v3.4: the target of a neutral caster (Ai_Tick): the unit it hit, or the unit that hit it (no dummies)
    if sp == Player(PLAYER_NEUTRAL_AGGRESSIVE) and LoadInteger(Ab_HT, hs, 87) > 0 then
        call SaveUnitHandle(Ab_HT, hs, 86, t)
    endif
    if tp == Player(PLAYER_NEUTRAL_AGGRESSIVE) and LoadInteger(Ab_HT, ht, 87) > 0 and GetUnitAbilityLevel(src, 'Aloc') == 0 then
        call SaveUnitHandle(Ab_HT, ht, 86, src)
    endif
    set ta = Ab_Num(t)
    set s_ab = Ab_Num(src)
    // Intimidate: the first hit after 10s out of combat, on either side
    if ta == AB_INTIMIDATE and Mega_Time - LoadReal(Ab_HT, ht, 60) > 10.0 then
        call Ab_Intimidate(t)
    endif
    if s_ab == AB_INTIMIDATE and Mega_Time - LoadReal(Ab_HT, hs, 60) > 10.0 then
        call Ab_Intimidate(src)
    endif
    call SaveReal(Ab_HT, hs, 60, Mega_Time)
    call SaveReal(Ab_HT, ht, 60, Mega_Time)
    // skill damage: scaled by the main attribute of the hero (or of the owner's best hero for dummy units)
    if user and atk and IsUnitType(src, UNIT_TYPE_HERO) then
        if PAX_Form_Id(src) == 18 then
            set stat = PAX_Leg_MainStat(src)
        elseif LoadInteger(Mega_HT, hs, 0) - 1 == 13 or PAX_Form_Id(src) == 2 or LoadInteger(Mega_HT, GetUnitTypeId(src), 85) == 1 then
            set stat = I2R(GetHeroStr(src, true))
        else
            set stat = I2R(GetHeroInt(src, true))
        endif
        set dmg = (dmg + stat) * (100.0 / (100.0 + Fx_DefOf(t, 1)))
        set m = m * Ab_BasicMult
    endif
    if user and skill then
        if IsUnitType(src, UNIT_TYPE_HERO) then
            set stat = Fx_SkillStat(src)  // v3.4.11: STR for physical moves, INT for special moves
        else
            set stat = Ab_PlayerStat(sp)
        endif
        set m = m * Ab_SkillMult(stat)
        if IsUnitType(src, UNIT_TYPE_HERO) and GetHeroLevel(src) > 50 then
            set m = m * (1.0 + Ab_LevelK * I2R(GetHeroLevel(src) - 50))
        endif
    endif
    // v3.4: the type of the move (Aerilate / Pixilate turn Normal moves into Flying / Fairy)
    if (atk or skill) and s_ab == AB_MULTITYPE and GetUnitTypeId(src) == 'E02A' then
        call PAX_Plate_Adapt(src, t)
    endif
    if skill then
        set mt = Ty_Resolve(src)
        if mt == T_NORMAL and s_ab == AB_AERILATE then
            set mt = T_FLYING
        elseif mt == T_NORMAL and s_ab == AB_PIXILATE then
            set mt = T_FAIRY
        elseif mt == T_NORMAL and s_ab == AB_MULTITYPE and Ty_Of(src, 0) >= 0 then
            set mt = Ty_Of(src, 0)
        endif
    endif
    set m = m * Ab_StateMult(src, skill, mt)
    if s_ab > 0 then
        set m = m * Ab_OutMult(src, t, s_ab, ta, atk, skill, mt)
    endif
    // v3.4.2: effectiveness of skills (type of the move) and basic attacks (first type of the attacker)
    set et = mt
    if atk and et < 0 then
        set et = Ty_Of(src, 0)
    endif
    if Ty_Enabled and et >= 0 then
        set eff = Ty_Mult(et, t)
        if ta == AB_DELTASTREAM and eff > 1.0 then
            set eff = 1.0
        elseif eff > 1.0 and Mega_Time < LoadReal(Fx_HT, ht, 103) and Ty_Has(t, T_FLYING) and (et == T_ELECTRIC or et == T_ICE or et == T_ROCK) then
            set eff = 1.0
        endif
        set m = m * eff
    endif
    set m = m * PAX_LightBallDamageMult(src, atk or skill)
    set m = m * PAX_Loot_DmgMult(src, t, atk or skill)
    if Mega_Time < LoadReal(PAX_Leg_HT, hs, 171) then
        set m = m * 1.25
    endif
    if sp == Player(PLAYER_NEUTRAL_AGGRESSIVE) then
        if LoadInteger(PAX_Boss_HT, hs, 8) == 1 and skill then
            set m = m * 1.25
        endif
        if GetUnitTypeId(src) == 'n01J' then
            set m = m * 2.0
        elseif skill and not IsUnitType(src, UNIT_TYPE_HERO) and not Leg_IsLegend(GetUnitTypeId(src)) and not PAX_IsFixedBoss(GetUnitTypeId(src)) then
            set m = m * 0.40
        endif
    endif
    set pvp = user and IsUnitType(src, UNIT_TYPE_HERO) and IsUnitType(t, UNIT_TYPE_HERO) and GetPlayerId(tp) < 12
    if user and IsUnitType(src, UNIT_TYPE_HERO) and GetPlayerId(sp) < 12 and Mega_Time < PAX_Up_ElixirEnd[GetPlayerId(sp)] then
        set m = m * 1.15
    endif
    if IsUnitType(t, UNIT_TYPE_HERO) and GetPlayerId(tp) < 12 and Mega_Time < PAX_Up_ElixirEnd[GetPlayerId(tp)] then
        set m = m * 0.90
    endif
    if pvp then
        if PAX_Late_IsUnderdog(t) then
            if PAX_Leg_Awakened(src) then
                set m = m * 0.80
            else
                set m = m * 0.85
            endif
        endif
        if PAX_Leg_Awakened(t) and PAX_Late_TeamDeficit(GetPlayerId(sp)) >= 10 then
            set m = m * 1.20
        endif
    endif
    if LoadInteger(PAX_Leg_HT, hs, 175) == 1 then
        if atk then
            set m = m * RMinBJ(1.30, 1.0 + 0.003 * I2R(GetHeroLevel(src)))
        elseif skill then
            set m = m * RMinBJ(1.50, 1.0 + 0.005 * I2R(GetHeroLevel(src)))
        endif
        if pvp and PAX_Leg_Index(GetUnitTypeId(t)) > 0 then
            set m = m * 3.0
        endif
    endif
    set fxm = Ext_DamageMult(src, t, atk, skill, mt, eff) * Fx_OutMult(src, t, atk, skill, mt)
    if pvp then
        if fxm > 2.0 then
            set fxm = 2.0
        endif
        if skill then
            set m = m * 0.38
        elseif atk then
            set m = m * 0.48
        endif
    else
        set fxm = Fx_Cap(fxm)
    endif
    set m = m * fxm  // v4.1: PvP scaling (0.38x skill / 0.48x atk, 2.0x cap); PvE keeps 1.0x & 3.0x cap
    // the target's Ability (Mold Breaker ignores it)
    if ta > 0 and s_ab != AB_MOLDBREAKER then
        if skill and Ab_Absorbs(t, ta, mt, dmg * m) then
            call Ab_Say(t, "Absorbed", 120, 200, 255, sp, tp)
            call BlzSetEventDamage(0.0)
            set t = null
            set src = null
            set sp = null
            set tp = null
            return false
        endif
        set m = m * Ab_InMult(src, t, ta, s_ab, atk, skill, mt, dmg * m)
    endif
    if m > 0.0 then
        if s_ab > 0 then
            call Ab_OnHit(src, t, s_ab, atk, skill, dmg * m)
        endif
        call PAX_LightBallOnHit(src, t, atk or skill, dmg * m)
        if LoadInteger(Ab_HT, hs, 0) == AB_TRACE and (atk or skill) then
            call Ab_TraceCopy(src, t)
        endif
        if ta > 0 and atk and s_ab != AB_MOLDBREAKER and Ab_Alive(src) then
            call Ab_InContact(src, t, ta)
        endif
        if ta > 0 then
            call Ab_AfterHit(t, ta, dmg * m)
        endif
        call Ext_AfterHit(src, t, atk, dmg * m)
        call Fx_AfterHit(src, t, atk, skill, mt, dmg * m)  // v3.4.11
        if GetUnitTypeId(t) == Leg_MewtwoId or GetUnitTypeId(t) == Leg_RayquazaId then
            call Leg_TryMega(t, dmg * m)
        endif
        call League_TryMega(t, dmg * m)
        if et >= 0 and Mega_Time >= LoadReal(Ab_HT, ht, 57) and (eff > 1.01 or eff < 0.99) then
            call SaveReal(Ab_HT, ht, 57, Mega_Time + 1.0)
            if eff > 1.01 then
                call Ab_Say(t, "Super effective!", 255, 140, 0, sp, tp)
                call Ab_Pop(t, "Abilities\\Spells\\Human\\Feedback\\SpellBreakerAttack.mdl", "chest")
            else
                call Ab_Say(t, "Not very effective...", 170, 170, 170, sp, tp)
            endif
        endif
    endif
    if m > 0.0 then
        call PAX_Leg_OnDamageProgress(src, dmg * m)
        call PAX_Loot_OnHitEx(src, t, atk, skill, dmg * m)
        call PAX_Loot_OnDamaged(t, src, dmg * m)
    endif
    call SaveReal(Ab_HT, ht, 1, Mega_Time)
    set m = Ext_Final(t, dmg * m) / dmg  // v3.4 Focus Sash
    set m = Fx_Final(src, t, dmg * m) / dmg  // v3.4.11: Mewtwo shield, Ho-Oh rebirth, Regirock Sturdy
    set dmg = PAX_Leg_ModifyIncoming(src, t, atk, skill, dmg * m)
    set m = 1.0
    if dmg > 0.0 then
        call PAX_Leg_OnHit(src, t, atk, skill, dmg)
    endif
    if atk then
        call BlzSetEventDamageType(DAMAGE_TYPE_UNIVERSAL)
    endif
    call BlzSetEventDamage(dmg * m)
    set t = null
    set src = null
    set sp = null
    set tp = null
    return false
endfunction

// tester command "-stats": the numbers that decide balance (hero level, main stat, skill multiplier, HP, armor, tier)
function Dbg_Stats takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local unit u = null
    local unit h = null
    local real st = 0.0
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if h == null and IsUnitType(u, UNIT_TYPE_HERO) and (GetWidgetLife(u) > 0.405) then
            set h = u
        endif
    endloop
    if h == null then
        call DisplayTimedTextToPlayer(p, 0, 0, 8.0, "|cffffcc00-stats: no living Pokemon.|r")
    else
        set st = Ab_MainStat(h)
        call DisplayTimedTextToPlayer(p, 0, 0, 12.0, "|cffffcc00" + GetHeroProperName(h) + "|r lv " + I2S(GetHeroLevel(h)) + " | main stat " + I2S(R2I(st)) + " | skill damage x" + I2S(R2I(Ab_SkillMult(st) * 100.0)) + "% | HP " + I2S(R2I(GetWidgetLife(h))) + "/" + I2S(R2I(BlzGetUnitMaxHP(h))) + " | armor " + I2S(R2I(BlzGetUnitArmor(h))) + " | wild tier " + I2S(Wild_Tier))
        call Fx_Stats(p, h)  // v3.4.11
    endif
    set p = null
    set u = null
    set h = null
endfunction

// tester command "-spawn": the host gets a wild creep of the current tier next to his Pokemon
// tester command "-pos": prints the position of your living Pokemon (for placing NPCs)
function Dbg_Pos takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local unit h = null
    local unit u = null
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if h == null and IsUnitType(u, UNIT_TYPE_HERO) and (GetWidgetLife(u) > 0.405) then
            set h = u
        endif
    endloop
    if h == null then
        call DisplayTimedTextToPlayer(p, 0, 0, 8.0, "|cffffcc00-pos: no living Pokemon.|r")
    else
        call DisplayTimedTextToPlayer(p, 0, 0, 12.0, "|cffffcc00-pos|r X " + I2S(R2I(GetUnitX(h))) + " Y " + I2S(R2I(GetUnitY(h))))
    endif
    set p = null
    set u = null
    set h = null
endfunction

function Dbg_Spawn takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local unit h = null
    local unit u = null
    local integer pow = Wild_Tier + 1
    if GetPlayerId(p) != Host_Id() then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00Only the host can type -spawn.|r")
        set p = null
        return
    endif
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if h == null and IsUnitType(u, UNIT_TYPE_HERO) then
            set h = u
        endif
    endloop
    if pow > 10 then
        set pow = 10
    endif
    if h != null then
        set u = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), Wild_PickType(pow), GetUnitX(h) + 200.0, GetUnitY(h), 0.0)
        call Wild_Apply(u)
    endif
    set p = null
    set h = null
    set u = null
endfunction

// tester command "-lv100": open the player's level cap and level the living Pokemon to 100
function PAX_Dbg_Lv100 takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local integer pid = GetPlayerId(p)
    local unit h = null
    local unit u = null
    local integer g = 0
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if h == null and IsUnitType(u, UNIT_TYPE_HERO) and GetWidgetLife(u) > 0.405 then
            set h = u
        endif
    endloop
    loop
        exitwhen g >= 8
        set Badge_Has[pid * 8 + g] = true
        set g = g + 1
    endloop
    if h != null then
        call SetHeroLevel(h, 100, true)
        call Hero_HPSync(h)
        call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) + 50000)
        call DisplayTimedTextToPlayer(p, 0, 0, 8.0, "|cffffcc00-lv100: " + GetHeroProperName(h) + " reached Lv 100! +50000 gold.|r")
    else
        call DisplayTimedTextToPlayer(p, 0, 0, 8.0, "|cffffcc00-lv100: no living Pokemon.|r")
    endif
    set p = null
    set h = null
    set u = null
endfunction

// NPC: moves of the hero of player pid in one dialog; kind 1 = slot, 2 = forget, 3 = learn, 4 = back
function Mv_Clear takes unit u, integer s returns nothing
    local integer old = Mv_Slot(u, s)
    if old >= 0 then
        call UnitRemoveAbility(u, Mv_Id(s, old))
        call UnitRemoveAbility(u, Mv_Real(old))  // v3.4.10
    endif
    call SaveInteger(Ab_HT, GetHandleId(u), 40 + s, 0)
endfunction

function Npc_Label takes unit h, integer s returns string
    local integer m = Mv_Slot(h, s)
    if m < 0 then
        return "(empty)"
    endif
    return Mv_Label[m]
endfunction

function PAX_Npc_TMCost takes integer m returns integer
    local integer pow = 0
    if m >= 0 then
        set pow = Mv_Pow[m]
    endif
    if pow <= 0 then
        return 6000
    elseif pow <= 60 then
        return 3000
    elseif pow <= 80 then
        return 4500
    elseif pow <= 100 then
        return 6000
    elseif pow <= 120 then
        return 10000
    endif
    return 15000
endfunction

function PAX_Npc_MoveName takes integer m returns string
    local string s = ""
    local integer i = 0
    local integer len = 0
    if m < 0 then
        return "(empty)"
    endif
    set s = Mv_Label[m]
    set len = StringLength(s)
    loop
        exitwhen i + 2 > len
        if SubString(s, i, i + 2) == " (" then
            return SubString(s, 0, i)
        endif
        set i = i + 1
    endloop
    return s
endfunction

function PAX_Npc_PriceStr takes integer cost returns string
    if cost == 3000 then
        return "3k"
    elseif cost == 4500 then
        return "4.5k"
    elseif cost == 6000 then
        return "6k"
    elseif cost == 10000 then
        return "10k"
    elseif cost == 15000 then
        return "15k"
    endif
    return I2S(cost) + "g"
endfunction

function PAX_Npc_ShortMove takes integer m, integer cost returns string
    local string name = PAX_Npc_MoveName(m)
    local string type3 = "-"
    local string kind = "Status"
    if m >= 0 and Mv_Type[m] >= 0 and Mv_Type[m] < 18 then
        set type3 = SubString(Ty_Name[Mv_Type[m]], 0, 3)
    endif
    if m >= 0 and Mv_Phys[m] == 1 then
        set kind = "Phy|" + I2S(Mv_Pow[m])
    elseif m >= 0 and Mv_Phys[m] == 2 then
        set kind = "Spe|" + I2S(Mv_Pow[m])
    endif
    return name + " [" + type3 + "|" + kind + "] " + PAX_Npc_PriceStr(cost)
endfunction

function Npc_Show takes integer pid, unit h, integer s returns nothing
    local integer b = pid * 12
    local integer k = 0
    local integer n = 0
    local integer id = GetUnitTypeId(h)
    local integer m = 0
    local integer lv = 0
    local integer cnt = 0
    local integer shown = 0
    local string msg = ""
    local dialog d = Npc_Dlg[pid]
    local player p = Player(pid)
    set Npc_Slot[pid] = s
    call DialogClear(d)
    if s < 0 then
        set msg = "Moves of " + GetHeroProperName(h) + ". Choose a slot:"
        loop
            exitwhen k >= Mv_Slots
            set Npc_Btn[b + k] = DialogAddButton(d, "Slot " + I2S(k + 1) + ": " + Npc_Label(h, k), 0)
            set Npc_Kind[b + k] = 1
            set Npc_Val[b + k] = k
            set k = k + 1
        endloop
        set n = Mv_Slots
        set Npc_Btn[b + n] = DialogAddButton(d, "Close", 0)
        set Npc_Kind[b + n] = 0
        set n = n + 1
    elseif Npc_Mode[pid] == 1 then
        set msg = "TM/HM slot " + I2S(s + 1) + " (page " + I2S(Npc_TMPage[pid] + 1) + ")"
        set cnt = LoadInteger(Ab_HT, id, 299)
        set k = 0
        set lv = 0
        loop
            exitwhen k >= cnt
            set m = LoadInteger(Ab_HT, id, 300 + k)
            if not Mv_Known(h, m) then
                if lv >= Npc_TMPage[pid] * 8 and lv < Npc_TMPage[pid] * 8 + 8 then
                    set Npc_Btn[b + n] = DialogAddButton(d, PAX_Npc_ShortMove(m, PAX_Npc_TMCost(m)), 0)
                    set Npc_Kind[b + n] = 6
                    set Npc_Val[b + n] = m
                    set n = n + 1
                endif
                set lv = lv + 1
            endif
            set k = k + 1
        endloop
        if Npc_TMPage[pid] > 0 then
            set Npc_Btn[b + n] = DialogAddButton(d, "< Prev page", 0)
            set Npc_Kind[b + n] = 7
            set n = n + 1
        endif
        if lv > (Npc_TMPage[pid] + 1) * 8 then
            set Npc_Btn[b + n] = DialogAddButton(d, "Next page >", 0)
            set Npc_Kind[b + n] = 8
            set n = n + 1
        endif
        set Npc_Btn[b + n] = DialogAddButton(d, "Back", 0)
        set Npc_Kind[b + n] = 9
        set n = n + 1
    else
        set msg = "Slot " + I2S(s + 1) + ": " + Npc_Label(h, s) + ". Choose:"
        if Mv_Slot(h, s) >= 0 then
            set Npc_Btn[b + n] = DialogAddButton(d, "Forget " + PAX_Npc_MoveName(Mv_Slot(h, s)) + " (free)", 0)
            set Npc_Kind[b + n] = 2
            set Npc_Val[b + n] = s
            set n = n + 1
        endif
        // v3.4.10: the level-up moves are paged, 6 a page (buttons: forget + 6 + prev + next + TM + back <= 12)
        set cnt = LoadInteger(Ab_HT, id, 99)
        set shown = 0
        loop
            exitwhen k >= cnt
            set m = LoadInteger(Ab_HT, id, 100 + 2 * k)
            set lv = LoadInteger(Ab_HT, id, 101 + 2 * k)
            if lv <= GetHeroLevel(h) and not Mv_Known(h, m) then
                if shown >= Npc_LvPage[pid] * 6 and shown < Npc_LvPage[pid] * 6 + 6 then
                    set Npc_Btn[b + n] = DialogAddButton(d, PAX_Npc_ShortMove(m, Npc_LearnCost), 0)
                    set Npc_Kind[b + n] = 3
                    set Npc_Val[b + n] = m
                    set n = n + 1
                endif
                set shown = shown + 1
            endif
            set k = k + 1
        endloop
        if Npc_LvPage[pid] > 0 then
            set Npc_Btn[b + n] = DialogAddButton(d, "< Prev page", 0)
            set Npc_Kind[b + n] = 10
            set n = n + 1
        endif
        if shown > (Npc_LvPage[pid] + 1) * 6 then
            set Npc_Btn[b + n] = DialogAddButton(d, "Next page >", 0)
            set Npc_Kind[b + n] = 11
            set n = n + 1
        endif
        if LoadInteger(Ab_HT, id, 299) > 0 then
            set Npc_Btn[b + n] = DialogAddButton(d, "TM/HM moves (3k - 15k)", 0)
            set Npc_Kind[b + n] = 5
            set n = n + 1
        endif
        set Npc_Btn[b + n] = DialogAddButton(d, "Back", 0)
        set Npc_Kind[b + n] = 4
        set n = n + 1
    endif
    call DialogSetMessage(d, msg)
    call DialogDisplay(p, d, true)
    set d = null
    set p = null
endfunction

function Npc_Near takes unit h returns boolean
    local integer i = 0
    local real dx
    local real dy
    loop
        exitwhen i >= Npc_N
        set dx = GetUnitX(h) - Npc_X[i]
        set dy = GetUnitY(h) - Npc_Y[i]
        if dx * dx + dy * dy <= Npc_Range * Npc_Range then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

function Npc_OnChat takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local integer pid = GetPlayerId(p)
    local unit u = null
    local unit h = null
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if h == null and IsUnitType(u, UNIT_TYPE_HERO) and GetWidgetLife(u) > 0.405 then
            set h = u
        endif
    endloop
    if h == null then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00You need a living Pokemon.|r")
    elseif not Npc_Near(h) then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00Go to the moves NPC in your house first.|r")
    else
        set Npc_Unit[pid] = h
        set Npc_Mode[pid] = 0
        call Npc_Show(pid, h, -1)
    endif
    set p = null
    set u = null
    set h = null
endfunction

function Npc_OnClick takes nothing returns nothing
    local dialog d = GetClickedDialog()
    local button bt = GetClickedButton()
    local integer pid = 0
    local integer i = 0
    local integer b = 0
    local integer cost = 0
    local unit h = null
    loop
        exitwhen pid >= 12 or Npc_Dlg[pid] == d
        set pid = pid + 1
    endloop
    if pid < 12 then
        set b = pid * 12
        loop
            exitwhen i >= 12 or Npc_Btn[b + i] == bt
            set i = i + 1
        endloop
        set h = Npc_Unit[pid]
        if i < 12 and h != null and GetUnitTypeId(h) != 0 then
            if Npc_Kind[b + i] == 0 then
                call DialogDisplay(Player(pid), d, false)
            elseif Npc_Kind[b + i] == 1 then
                set Npc_LvPage[pid] = 0
                call Npc_Show(pid, h, Npc_Val[b + i])
            elseif Npc_Kind[b + i] == 10 then
                set Npc_LvPage[pid] = Npc_LvPage[pid] - 1
                call Npc_Show(pid, h, Npc_Slot[pid])
            elseif Npc_Kind[b + i] == 11 then
                set Npc_LvPage[pid] = Npc_LvPage[pid] + 1
                call Npc_Show(pid, h, Npc_Slot[pid])
            elseif Npc_Kind[b + i] == 2 then
                call Mv_Clear(h, Npc_Val[b + i])
                call Npc_Show(pid, h, -1)
            elseif Npc_Kind[b + i] == 5 then
                set Npc_Mode[pid] = 1
                set Npc_TMPage[pid] = 0
                call Npc_Show(pid, h, Npc_Slot[pid])
            elseif Npc_Kind[b + i] == 7 then
                set Npc_TMPage[pid] = Npc_TMPage[pid] - 1
                call Npc_Show(pid, h, Npc_Slot[pid])
            elseif Npc_Kind[b + i] == 8 then
                set Npc_TMPage[pid] = Npc_TMPage[pid] + 1
                call Npc_Show(pid, h, Npc_Slot[pid])
            elseif Npc_Kind[b + i] == 9 then
                set Npc_Mode[pid] = 0
                call Npc_Show(pid, h, Npc_Slot[pid])
            elseif Npc_Kind[b + i] == 6 then
                set cost = PAX_Npc_TMCost(Npc_Val[b + i])
                if GetPlayerState(Player(pid), PLAYER_STATE_RESOURCE_GOLD) >= cost then
                    call SetPlayerState(Player(pid), PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(Player(pid), PLAYER_STATE_RESOURCE_GOLD) - cost)
                    call Mv_Put(h, Npc_Slot[pid], Npc_Val[b + i])
                    call SaveInteger(Ab_HT, GetHandleId(h), 200 + Npc_Val[b + i], 1)
                    call Mv_Notify(h, Npc_Val[b + i])
                    set Npc_Mode[pid] = 0
                    call Npc_Show(pid, h, -1)
                else
                    call DisplayTimedTextToPlayer(Player(pid), 0, 0, 5.0, "|cffffcc00Not enough gold.|r")
                    call Npc_Show(pid, h, Npc_Slot[pid])
                endif
            elseif Npc_Kind[b + i] == 3 then
                if GetPlayerState(Player(pid), PLAYER_STATE_RESOURCE_GOLD) >= Npc_LearnCost then
                    call SetPlayerState(Player(pid), PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(Player(pid), PLAYER_STATE_RESOURCE_GOLD) - Npc_LearnCost)
                    call Mv_Put(h, Npc_Slot[pid], Npc_Val[b + i])
                    call SaveInteger(Ab_HT, GetHandleId(h), 200 + Npc_Val[b + i], 1)
                    call Mv_Notify(h, Npc_Val[b + i])
                    call Npc_Show(pid, h, -1)
                else
                    call DisplayTimedTextToPlayer(Player(pid), 0, 0, 5.0, "|cffffcc00Not enough gold.|r")
                    call Npc_Show(pid, h, Npc_Slot[pid])
                endif
            else
                call Npc_Show(pid, h, -1)
            endif
        endif
    endif
    set d = null
    set bt = null
    set h = null
endfunction

// ---------------------------------------------------------------------------------------------
// Pokemon picker (v3.3): select the tavern (or type -pick) while you still hold the picker wisp
// buttons per player: 9 Pokemon + Prev + Next + Close = 12; Pick_Val: >= 0 Pokemon index, -1 prev, -2 next, -3 close
// ---------------------------------------------------------------------------------------------
function Pick_Show takes integer pid, integer page returns nothing
    local dialog d = Pick_Dlg[pid]
    local integer b = pid * 12
    local integer g = Pick_Grp[pid]
    local integer total = Pick_TN
    local integer base = 0
    local integer k = 0
    local integer n = 0
    local integer pages = 0
    local string msg = ""
    if Pick_N == 0 then
        return
    endif
    if g >= 0 then
        set total = Pick_TCount[g]
        set base = Pick_TFirst[g]
    endif
    set pages = (total + 7) / 8
    if page < 0 then
        set page = 0
    endif
    set Pick_Page[pid] = page
    call DialogClear(d)
    loop
        exitwhen k >= 8 or page * 8 + k >= total
        if g < 0 then
            set Pick_Btn[b + n] = DialogAddButton(d, Pick_TName[page * 8 + k] + " (" + I2S(Pick_TCount[page * 8 + k]) + ")", 0)
            set Pick_Val[b + n] = 1000 + page * 8 + k
        else
            set Pick_Btn[b + n] = DialogAddButton(d, Pick_Name[base + page * 8 + k], 0)
            set Pick_Val[b + n] = base + page * 8 + k
        endif
        set n = n + 1
        set k = k + 1
    endloop
    if page > 0 then
        set Pick_Btn[b + n] = DialogAddButton(d, "< Prev page", 0)
        set Pick_Val[b + n] = -1
        set n = n + 1
    endif
    if page < pages - 1 then
        set Pick_Btn[b + n] = DialogAddButton(d, "Next page >", 0)
        set Pick_Val[b + n] = -2
        set n = n + 1
    endif
    if g >= 0 then
        set Pick_Btn[b + n] = DialogAddButton(d, "Back to types", 0)
        set Pick_Val[b + n] = -4
        set n = n + 1
        set msg = Pick_TName[g] + " Pokemon (page " + I2S(page + 1) + " of " + I2S(pages) + ")"
    else
        set msg = "Choose a type (page " + I2S(page + 1) + " of " + I2S(pages) + ")"
    endif
    set Pick_Btn[b + n] = DialogAddButton(d, "Close", 0)
    set Pick_Val[b + n] = -3
    call DialogSetMessage(d, msg)
    call DialogDisplay(Player(pid), d, true)
    set d = null
endfunction

function Pick_Choose takes integer pid, integer idx returns nothing
    local player p = Player(pid)
    local unit w = Rand_FindWisp(p)
    local unit h = null
    if w == null then
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00You already have a Pokemon. Type -repick in the first 2 minutes to get a random one instead.|r")
    elseif Rand_IsTaken(Pick_Type[idx]) then
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00Another player already has that Pokemon.|r")
        call Pick_Show(pid, Pick_Page[pid])
    else
        set h = CreateUnit(p, Pick_Type[idx], GetUnitX(w), GetUnitY(w), 270.0)
        call Repick_Restore(h)
        call Mv_Sync(h)
        call RemoveUnit(w)
        call SelectUnitForPlayerSingle(h, p)
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffffcc00" + GetPlayerName(p) + "|r has chosen |cffffcc00" + GetHeroProperName(h) + "|r")
    endif
    set p = null
    set w = null
    set h = null
endfunction

function Pick_OnClick takes nothing returns nothing
    local dialog d = GetClickedDialog()
    local button bt = GetClickedButton()
    local integer pid = 0
    local integer i = 0
    local integer b = 0
    loop
        exitwhen pid >= 12 or Pick_Dlg[pid] == d
        set pid = pid + 1
    endloop
    if pid < 12 then
        set b = pid * 12
        loop
            exitwhen i >= 12 or Pick_Btn[b + i] == bt
            set i = i + 1
        endloop
        if i < 12 then
            if Pick_Val[b + i] >= 1000 then
                set Pick_Grp[pid] = Pick_Val[b + i] - 1000
                call Pick_Show(pid, 0)
            elseif Pick_Val[b + i] >= 0 then
                call Pick_Choose(pid, Pick_Val[b + i])
            elseif Pick_Val[b + i] == -4 then
                set Pick_Grp[pid] = -1
                call Pick_Show(pid, 0)
            elseif Pick_Val[b + i] == -1 then
                call Pick_Show(pid, Pick_Page[pid] - 1)
            elseif Pick_Val[b + i] == -2 then
                call Pick_Show(pid, Pick_Page[pid] + 1)
            endif
        endif
    endif
    set d = null
    set bt = null
endfunction

function Pick_OnSelect takes nothing returns nothing
    if GetUnitTypeId(GetTriggerUnit()) == 'nTV5' and Rand_FindWisp(GetTriggerPlayer()) != null then
        set Pick_Grp[GetPlayerId(GetTriggerPlayer())] = -1
        call Pick_Show(GetPlayerId(GetTriggerPlayer()), 0)
    endif
endfunction

function Pick_OnChat takes nothing returns nothing
    if Rand_FindWisp(GetTriggerPlayer()) != null then
        set Pick_Grp[GetPlayerId(GetTriggerPlayer())] = -1
        call Pick_Show(GetPlayerId(GetTriggerPlayer()), 0)
    else
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 6.0, "|cffffcc00You already have a Pokemon.|r")
    endif
endfunction

function Pick_Init takes nothing returns nothing
    local trigger pk_sel = CreateTrigger()
    local trigger pk_chat = CreateTrigger()
    local trigger pk_dlg = CreateTrigger()
    local integer i = 0
    call Pick_InitData()
    loop
        exitwhen i >= 12
        set Pick_Dlg[i] = DialogCreate()
        set Pick_Grp[i] = -1
        call TriggerRegisterPlayerChatEvent(pk_chat, Player(i), "-pick", true)
        call TriggerRegisterDialogEvent(pk_dlg, Pick_Dlg[i])
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen i >= 12
        call TriggerRegisterPlayerUnitEvent(pk_sel, Player(i), EVENT_PLAYER_UNIT_SELECTED, null)
        set i = i + 1
    endloop
    call TriggerAddAction(pk_sel, function Pick_OnSelect)
    call TriggerAddAction(pk_chat, function Pick_OnChat)
    call TriggerAddAction(pk_dlg, function Pick_OnClick)
    set pk_sel = null
    set pk_chat = null
    set pk_dlg = null
endfunction

// Haunt Legendary shop (v3.3): the Celebi and Darkrai teleport items move the buyer next to their rooms
function LegTele_OnSell takes nothing returns boolean
    local integer it = GetItemTypeId(GetSoldItem())
    local unit b = GetBuyingUnit()
    if it == 'IL00' then
        call SetUnitPosition(b, 9600.0, -2588.0)
    elseif it == 'IL01' then
        call SetUnitPosition(b, Fx_LLX, Fx_LLY)  // v3.4.11: the Pokemon League lobby
    elseif it == 'IL02' then
        call SetUnitPosition(b, -128.0, 16.0)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", b, "origin"))
    else
        set b = null
        return false
    endif
    call PanCameraToTimedForPlayer(GetOwningPlayer(b), GetUnitX(b), GetUnitY(b), 0.25)
    set b = null
    return false
endfunction

// v3.3: a hero that dies drops the Souls it carries (item names end with "Soul")
function Soul_DropOnDeath takes nothing returns boolean
    local unit u = GetDyingUnit()
    local integer s = 0
    local item it = null
    local string n = ""
    local string dropped = ""
    local integer len = 0
    if IsUnitType(u, UNIT_TYPE_HERO) then
        loop
            exitwhen s >= 6
            set it = UnitItemInSlot(u, s)
            if it != null then
                set n = GetItemName(it)
                set len = StringLength(n)
                if len >= 4 and SubString(n, len - 4, len) == "Soul" then
                    call UnitRemoveItem(u, it)
                    if dropped == "" then
                        set dropped = n
                    else
                        set dropped = dropped + ", " + n
                    endif
                endif
            endif
            set s = s + 1
        endloop
    endif
    if dropped != "" and GetPlayerId(GetOwningPlayer(u)) < 12 then
        call PAX_Announce("|cffffd166[SOUL DROP]|r |cffffd166" + GetUnitName(u) + "|r |cffe8ecf2dropped|r |cffffd166" + dropped + "|r.", 8.0)
    endif
    set u = null
    set it = null
    return false
endfunction

// v3.3: floating damage number over the target for skill damage (not basic attacks) dealt by a player; the owner sees it
function Dmg_OnDamaged takes nothing returns boolean
    local unit src = GetEventDamageSource()
    local unit t = GetTriggerUnit()
    local player p = null
    local real d = GetEventDamage()
    local texttag tt = null
    local string str = ""
    set Dmg_Type = 0
    if src != null and d >= 1.0 and Dmg_Tags < Dmg_TagMax and not BlzGetEventIsAttack() then
        set Dmg_Type = Ty_Resolve(src) + 1  // v3.4.1: the move just used, else the Pokemon's first type
        if Dmg_Type <= 0 and IsUnitType(src, UNIT_TYPE_HERO) then
            set Dmg_Type = Ty_Of(src, 0) + 1
        endif
        set p = GetOwningPlayer(src)
        if GetPlayerId(p) < 12 and IsUnitEnemy(t, p) then
            set Dmg_Tags = Dmg_Tags + 1
            set tt = CreateTextTag()
            set str = I2S(R2I(d))
            if Dmg_Type > 0 then  // v3.3.5: the number in the colour of the type, with its name
                set str = Type_Color[Dmg_Type] + str + " " + Type_Label[Dmg_Type] + "|r"
            else
                set str = "|cffffd228" + str + "|r"
            endif
            call SetTextTagText(tt, str, 0.025)
            call SetTextTagPos(tt, GetUnitX(t) - 40.0, GetUnitY(t), 80.0)
            call SetTextTagColor(tt, 255, 255, 255, 255)
            call SetTextTagVelocity(tt, 0.0, 0.04)
            call SetTextTagPermanent(tt, false)
            call SetTextTagLifespan(tt, 1.3)
            call SetTextTagFadepoint(tt, 0.7)
            call SetTextTagVisibility(tt, GetLocalPlayer() == p)
        endif
    endif
    set src = null
    set t = null
    set p = null
    set tt = null
    return false
endfunction

function Dmg_Reset takes nothing returns nothing
    set Dmg_Tags = 0
endfunction

function Type_Has takes string name, string word returns boolean
    local integer i = 0
    local integer n = StringLength(name)
    local integer w = StringLength(word)
    loop
        exitwhen i + w > n
        if SubString(name, i, i + w) == word then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

// a type item bought by a Pokemon of another type is taken back and the gold refunded
function Type_OnSell takes nothing returns boolean
    local item it = GetSoldItem()
    local unit b = GetBuyingUnit()
    local integer id = GetItemTypeId(it)
    local integer i = 0
    loop
        exitwhen i >= Type_N
        if Type_Item[i] == id then
            if not Type_Has(GetUnitName(b), Type_Word[i]) then
                call RemoveItem(it)
                call SetPlayerState(GetOwningPlayer(b), PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(GetOwningPlayer(b), PLAYER_STATE_RESOURCE_GOLD) + Type_Cost[i])
                call DisplayTimedTextToPlayer(GetOwningPlayer(b), 0, 0, 6.0, "|cffffcc00Only " + Type_Word[i] + " type Pokemon can buy this item.|r")
            endif
            set it = null
            set b = null
            return false
        endif
        set i = i + 1
    endloop
    set it = null
    set b = null
    return false
endfunction

// ---------------------------------------------------------------------------------------------
// Duel (v3.4): -duel <player name start>, then the other player types -accept. Both Pokemon are healed and the guest is
// moved next to the challenger; the duel ends when one Pokemon is under 15% HP (or dies), after 2 minutes (draw) or
// when a Pokemon is gone. Winner: +500 gold and a win in -rank.
function Duel_Hero takes integer pid returns unit
    local unit u = null
    local unit r = null
    call GroupEnumUnitsOfPlayer(Rand_Tmp, Player(pid), null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if r == null and IsUnitType(u, UNIT_TYPE_HERO) and GetUnitTypeId(u) != 'earc' and GetWidgetLife(u) > 0.405 then
            set r = u
        endif
    endloop
    set u = null
    return r
endfunction

function Duel_Heal takes unit u returns nothing
    if u != null and GetUnitTypeId(u) != 0 then
        call SetUnitState(u, UNIT_STATE_LIFE, I2R(BlzGetUnitMaxHP(u)))
        call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA))
    endif
endfunction

function Duel_Find takes string arg, integer self returns integer
    local string a = StringCase(arg, false)
    local string n = ""
    local integer i = 0
    if a == "" then
        return -1
    endif
    loop
        exitwhen i >= 12
        if i != self and GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
            set n = StringCase(GetPlayerName(Player(i)), false)
            if SubString(n, 0, StringLength(a)) == a then
                return i
            endif
        endif
        set i = i + 1
    endloop
    return -1
endfunction

function Duel_Finish takes integer a, integer b, integer win returns nothing
    local integer lose = -1
    if win == a then
        set lose = b
    elseif win == b then
        set lose = a
    endif
    call SetPlayerAlliance(Player(a), Player(b), ALLIANCE_PASSIVE, Duel_Allied[a * 12 + b])
    call SetPlayerAlliance(Player(b), Player(a), ALLIANCE_PASSIVE, Duel_Allied[b * 12 + a])
    if GetUnitTypeId(Duel_U[a]) != 0 then
        if GetWidgetLife(Duel_U[a]) <= 0.405 then
            call ReviveHero(Duel_U[a], GetUnitX(Duel_U[a]), GetUnitY(Duel_U[a]), false)
        endif
        call Duel_Heal(Duel_U[a])
        call SetUnitPosition(Duel_U[a], Duel_RX[a], Duel_RY[a])
    endif
    if GetUnitTypeId(Duel_U[b]) != 0 then
        if GetWidgetLife(Duel_U[b]) <= 0.405 then
            call ReviveHero(Duel_U[b], GetUnitX(Duel_U[b]), GetUnitY(Duel_U[b]), false)
        endif
        call Duel_Heal(Duel_U[b])
        call SetUnitPosition(Duel_U[b], Duel_RX[b], Duel_RY[b])
    endif
    set Duel_Foe[a] = -1
    set Duel_Foe[b] = -1
    set Duel_U[a] = null
    set Duel_U[b] = null
    if win >= 0 then
        set Duel_Wins[win] = Duel_Wins[win] + 1
        set Duel_Losses[lose] = Duel_Losses[lose] + 1
        call SetPlayerState(Player(win), PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(Player(win), PLAYER_STATE_RESOURCE_GOLD) + 500)
        call PAX_Announce("|cff4ade80[DUEL VICTORY]|r |cff7dd3fc" + GetPlayerName(Player(win)) + "|r |cffe8ecf2beat|r |cff7dd3fc" + GetPlayerName(Player(lose)) + "|r! (|cffffd166+500g|r)", 8.0)
    else
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffffcc00Duel: " + GetPlayerName(Player(a)) + " and " + GetPlayerName(Player(b)) + " drew.|r")
    endif
endfunction

function Duel_Start takes integer a, integer b returns nothing
    local unit dha = Duel_Hero(a)
    local unit dhb = Duel_Hero(b)
    if dha == null or dhb == null then
        call DisplayTimedTextToPlayer(Player(a), 0, 0, 6.0, "|cffffcc00Both players need a Pokemon.|r")
        call DisplayTimedTextToPlayer(Player(b), 0, 0, 6.0, "|cffffcc00Both players need a Pokemon.|r")
    else
        set Duel_Foe[a] = b
        set Duel_Foe[b] = a
        set Duel_Ask[a] = -1
        set Duel_Ask[b] = -1
        set Duel_U[a] = dha
        set Duel_U[b] = dhb
        set Duel_T[a] = 0.0
        set Duel_RX[a] = GetUnitX(dha)
        set Duel_RY[a] = GetUnitY(dha)
        set Duel_RX[b] = GetUnitX(dhb)
        set Duel_RY[b] = GetUnitY(dhb)
        set Duel_Allied[a * 12 + b] = GetPlayerAlliance(Player(a), Player(b), ALLIANCE_PASSIVE)
        set Duel_Allied[b * 12 + a] = GetPlayerAlliance(Player(b), Player(a), ALLIANCE_PASSIVE)
        call SetPlayerAlliance(Player(a), Player(b), ALLIANCE_PASSIVE, false)
        call SetPlayerAlliance(Player(b), Player(a), ALLIANCE_PASSIVE, false)
        call SetUnitPosition(dhb, GetUnitX(dha) + 400.0, GetUnitY(dha))
        call Duel_Heal(dha)
        call Duel_Heal(dhb)
        call PanCameraToTimedForPlayer(Player(b), GetUnitX(dhb), GetUnitY(dhb), 0.25)
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffff8800Duel: " + GetPlayerName(Player(a)) + " vs " + GetPlayerName(Player(b)) + "! The first Pokemon under 15% HP loses.|r")
    endif
    set dha = null
    set dhb = null
endfunction

function Duel_Tick takes nothing returns nothing
    local integer a = 0
    local integer b = 0
    local unit dha = null
    local unit dhb = null
    loop
        exitwhen a >= 12
        set b = Duel_Foe[a]
        if b > a then
            set Duel_T[a] = Duel_T[a] + 0.25
            if GetUnitTypeId(Duel_U[a]) == 0 then
                set Duel_U[a] = Duel_Hero(a)
            endif
            if GetUnitTypeId(Duel_U[b]) == 0 then
                set Duel_U[b] = Duel_Hero(b)
            endif
            set dha = Duel_U[a]
            set dhb = Duel_U[b]
            if dha == null or GetUnitTypeId(dha) == 0 then
                call Duel_Finish(a, b, b)
            elseif dhb == null or GetUnitTypeId(dhb) == 0 then
                call Duel_Finish(a, b, a)
            elseif GetWidgetLife(dha) <= 0.405 or GetWidgetLife(dha) < 0.15 * I2R(BlzGetUnitMaxHP(dha)) then
                call Duel_Finish(a, b, b)
            elseif GetWidgetLife(dhb) <= 0.405 or GetWidgetLife(dhb) < 0.15 * I2R(BlzGetUnitMaxHP(dhb)) then
                call Duel_Finish(a, b, a)
            elseif Duel_T[a] >= 120.0 then
                call Duel_Finish(a, b, -1)
            endif
        endif
        set a = a + 1
    endloop
    set dha = null
    set dhb = null
endfunction

function Duel_OnChat takes nothing returns nothing
    local integer me = GetPlayerId(GetTriggerPlayer())
    local string s = GetEventPlayerChatString()
    local string arg = SubString(s, 6, StringLength(s))
    local integer foe = Duel_Find(arg, me)
    if Duel_Foe[me] >= 0 then
        call DisplayTimedTextToPlayer(Player(me), 0, 0, 6.0, "|cffffcc00You are already in a duel.|r")
    elseif foe < 0 then
        call DisplayTimedTextToPlayer(Player(me), 0, 0, 8.0, "|cffffcc00Type -duel and the start of a player's name, for example -duel Ash.|r")
    elseif Duel_Foe[foe] >= 0 or Gym_Busy(me) or Gym_Busy(foe) then
        call DisplayTimedTextToPlayer(Player(me), 0, 0, 6.0, "|cffffcc00That player (or you) is busy in a duel or gym.|r")
    elseif Duel_Hero(me) == null or Duel_Hero(foe) == null then
        call DisplayTimedTextToPlayer(Player(me), 0, 0, 6.0, "|cffffcc00Both players need a Pokemon.|r")
    else
        set Duel_Ask[foe] = me
        call DisplayTimedTextToPlayer(Player(foe), 0, 0, 12.0, "|cffff8800" + GetPlayerName(Player(me)) + " challenges you to a duel! Type -accept or -decline.|r")
        call DisplayTimedTextToPlayer(Player(me), 0, 0, 8.0, "|cffffcc00Challenge sent to " + GetPlayerName(Player(foe)) + ".|r")
    endif
endfunction

function Duel_OnAccept takes nothing returns nothing
    local integer me = GetPlayerId(GetTriggerPlayer())
    local integer a = Duel_Ask[me]
    if a < 0 or Duel_Foe[a] >= 0 or Duel_Foe[me] >= 0 or Gym_Busy(me) or Gym_Busy(a) then
        call DisplayTimedTextToPlayer(Player(me), 0, 0, 6.0, "|cffffcc00Nobody is waiting for your answer.|r")
    else
        call Duel_Start(a, me)
    endif
endfunction

function Duel_OnDecline takes nothing returns nothing
    local integer me = GetPlayerId(GetTriggerPlayer())
    local integer a = Duel_Ask[me]
    if a >= 0 then
        set Duel_Ask[me] = -1
        call DisplayTimedTextToPlayer(Player(a), 0, 0, 6.0, "|cffffcc00" + GetPlayerName(Player(me)) + " declined the duel.|r")
    endif
endfunction

function Duel_OnRank takes nothing returns nothing
    local integer i = 0
    local player p = GetTriggerPlayer()
    call DisplayTimedTextToPlayer(p, 0, 0, 12.0, "|cffffcc00Duel record (wins / losses) and badges:|r")
    loop
        exitwhen i >= 12
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
            call DisplayTimedTextToPlayer(p, 0, 0, 12.0, GetPlayerName(Player(i)) + ": " + I2S(Duel_Wins[i]) + " / " + I2S(Duel_Losses[i]) + " | badges " + I2S(Badge_Count(i)) + "/8, level cap " + I2S(Badge_Cap(i)))
        endif
        set i = i + 1
    endloop
    set p = null
endfunction

function Duel_Init takes nothing returns nothing
    local trigger dq1 = CreateTrigger()
    local trigger dq2 = CreateTrigger()
    local trigger dq3 = CreateTrigger()
    local trigger duelq4 = CreateTrigger()
    local integer i = 0
    loop
        exitwhen i >= 12
        set Duel_Foe[i] = -1
        set Duel_Ask[i] = -1
        call TriggerRegisterPlayerChatEvent(dq1, Player(i), "-duel", false)
        call TriggerRegisterPlayerChatEvent(dq2, Player(i), "-accept", true)
        call TriggerRegisterPlayerChatEvent(dq3, Player(i), "-decline", true)
        call TriggerRegisterPlayerChatEvent(duelq4, Player(i), "-rank", true)
        call TriggerRegisterPlayerChatEvent(duelq4, Player(i), "-badges", true)
        set i = i + 1
    endloop
    call TriggerAddAction(dq1, function Duel_OnChat)
    call TriggerAddAction(dq2, function Duel_OnAccept)
    call TriggerAddAction(dq3, function Duel_OnDecline)
    call TriggerAddAction(duelq4, function Duel_OnRank)
    call TimerStart(Duel_Timer, 0.25, true, function Duel_Tick)
    set dq1 = null
    set dq2 = null
    set dq3 = null
    set duelq4 = null
endfunction

function Npc_IsMan takes nothing returns boolean
    local integer i = 0
    loop
        exitwhen i >= Npc_N
        if GetTriggerUnit() == Npc_Man[i] then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

// v3.4 (generated by tools/v34/content.py): new Megas, Pokemon, legend, wild creeps and Souls
// ======== [END FILE: 07_sys_combat_fx_duel.j] ========
// ======== [BEGIN FILE: 08_data_v34_ab_ty_ui.j] ========
function V34_Data1 takes nothing returns nothing
    set Mega_Base[25] = 'P3NA'
