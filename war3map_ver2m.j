    call ExecuteFunc("PkFx_More20")  // v3.4.16
    call ExecuteFunc("PkFx_More21")  // v3.4.16
    call ExecuteFunc("PkFx_More22")  // v3.4.16
    call ExecuteFunc("PkFx_More23")  // v3.4.16
    call TriggerRegisterAnyUnitEventBJ(fxTrig, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(fxTrig, Condition(function PkFx_OnCast))
