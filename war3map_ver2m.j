function PAX_Leg_SyncStats takes unit u returns nothing
    local integer h = 0
    local boolean awake = false
    local integer appStr = 0
    local integer appAgi = 0
    local integer appInt = 0
    local integer baseStr = 0
    local integer baseAgi = 0
    local integer baseInt = 0
    local integer wantStr = 0
    local integer wantAgi = 0
    local integer wantInt = 0
    local real bonusPct = 0.0
    local real strPct = 0.0
    local real agiPct = 0.0
    local real intPct = 0.0
    local integer formId = 0
    local integer held = 0
    if u == null or not IsUnitType(u, UNIT_TYPE_HERO) then
        return
    endif
    set h = GetHandleId(u)
    set awake = PAX_Leg_Awakened(u)
    set appStr = LoadInteger(PAX_Leg_HT, h, 70)
    set appAgi = LoadInteger(PAX_Leg_HT, h, 71)
    set appInt = LoadInteger(PAX_Leg_HT, h, 72)
    set baseStr = GetHeroStr(u, false) - appStr
    set baseAgi = GetHeroAgi(u, false) - appAgi
    set baseInt = GetHeroInt(u, false) - appInt
    if baseStr < 1 then
        set baseStr = 1
    endif
    if baseAgi < 1 then
        set baseAgi = 1
    endif
    if baseInt < 1 then
        set baseInt = 1
    endif
    set formId = PAX_Form_Id(u)
    if awake then
        if formId >= 13 then
            set bonusPct = bonusPct + 0.15
        else
            set bonusPct = bonusPct + 0.30
        endif
    endif
    if LoadInteger(PAX_Leg_HT, h, 128) > 0 then
        set bonusPct = bonusPct + 0.15
    endif
    set held = LoadInteger(PAX_Leg_HT, h, 144)
    set strPct = bonusPct
    set agiPct = bonusPct
    set intPct = bonusPct
    if formId == 1 then
        set agiPct = agiPct + 0.05
        set intPct = intPct + 0.25
    elseif formId == 2 then
        set strPct = strPct + 0.30
        set agiPct = agiPct + 0.20
        set intPct = intPct - 0.10
    elseif formId == 3 then
        set agiPct = agiPct + 0.05
        set intPct = intPct + 0.25
    elseif formId == 4 then
        set strPct = strPct + 0.25
        set agiPct = agiPct + 0.10
        set intPct = intPct + 0.20
    elseif formId == 5 then
        set agiPct = agiPct + 0.05
        set intPct = intPct + 0.25
    elseif formId == 6 then
        set agiPct = agiPct + 0.20
        set intPct = intPct + 0.25
    elseif formId == 7 then
        set strPct = strPct + 0.40
        set agiPct = agiPct + 0.15
        set intPct = intPct + 0.40
    elseif formId == 9 then
        set strPct = strPct + 0.10
        set agiPct = agiPct + 0.45
        set intPct = intPct + 0.10
    elseif formId == 10 then
        set agiPct = agiPct + 0.10
        set intPct = intPct + 0.20
    elseif formId == 11 then
        set strPct = strPct + 0.25
        set agiPct = agiPct + 0.05
        set intPct = intPct + 0.10
    elseif formId == 12 then
        set agiPct = agiPct + 0.10
        set intPct = intPct + 0.25
    elseif formId == 13 then
        set strPct = strPct + 0.25
        set agiPct = agiPct + 0.20
    elseif formId == 14 then
        set agiPct = agiPct + 0.15
        set intPct = intPct + 0.20
    elseif formId == 15 then
        set agiPct = agiPct + 0.20
        set intPct = intPct + 0.30
    elseif formId == 16 then
        set agiPct = agiPct + 0.10
        set intPct = intPct + 0.15
    elseif formId == 17 then
        set strPct = strPct + 0.20
        set intPct = intPct + 0.10
    elseif formId == 18 then
        set strPct = strPct + 0.20
        set agiPct = agiPct + 0.15
        set intPct = intPct + 0.20
    elseif formId == 19 then
        set agiPct = agiPct + 0.15
        set intPct = intPct + 0.25
    endif
    set wantStr = R2I(I2R(baseStr) * (1.0 + strPct) + 0.5) - baseStr + held
    set wantAgi = R2I(I2R(baseAgi) * (1.0 + agiPct) + 0.5) - baseAgi + held
    set wantInt = R2I(I2R(baseInt) * (1.0 + intPct) + 0.5) - baseInt + held
    if wantStr != appStr then
        call SetHeroStr(u, baseStr + wantStr, true)
        call SaveInteger(PAX_Leg_HT, h, 70, wantStr)
    endif
    if wantAgi != appAgi then
        call SetHeroAgi(u, baseAgi + wantAgi, true)
        call SaveInteger(PAX_Leg_HT, h, 71, wantAgi)
    endif
    if wantInt != appInt then
        call SetHeroInt(u, baseInt + wantInt, true)
        call SaveInteger(PAX_Leg_HT, h, 72, wantInt)
    endif
endfunction

function PAX_Leg_MegaAbId takes integer mi returns integer
    if mi == 33 then
        return 'AXP0'
    elseif mi == 34 then
        return 'AXP1'
    elseif mi == 15 then
        return 'AXP2'
    elseif mi == 13 then
        return 'AXP3'
    elseif mi == 14 then
        return 'AXP4'
    elseif mi == 35 then
        return 'AXP5'
    endif
    return 0
endfunction

function PAX_Leg_Sync takes unit u returns nothing
    local integer idx = 0
    local integer pid = 0
    local integer formId = 0
    local integer abId = 0
    local integer aw = 0
    local integer wantAb = 0
    local integer megaAb = 0
    local integer mi = -1
    local integer i = 1
    if u == null then
        return
    endif
    set idx = PAX_Leg_Index(GetUnitTypeId(u))
    set pid = GetPlayerId(GetOwningPlayer(u))
    set mi = LoadInteger(Mega_HT, GetHandleId(u), 0) - 1
    set formId = PAX_Form_Id(u)
    if pid < 12 and (idx > 0 or formId >= 13) then
        if PAX_Leg_Awakened(u) then
            set megaAb = PAX_Leg_MegaAbId(mi)
            set wantAb = PAX_Form_AbId(formId)
            if megaAb != 0 then
                set wantAb = megaAb
            elseif wantAb == 0 then
                set wantAb = PAX_Leg_AwAbId(idx)
            endif
        elseif idx > 0 then
            set wantAb = PAX_Leg_AbId(idx)
        endif
    endif
    loop
        exitwhen i > PAX_Leg_Count()
        set abId = PAX_Leg_AbId(i)
        set aw = PAX_Leg_AwAbId(i)
        if abId == wantAb then
            if GetUnitAbilityLevel(u, abId) == 0 then
                call UnitAddAbility(u, abId)
            endif
        else
            if GetUnitAbilityLevel(u, abId) > 0 then
                call UnitRemoveAbility(u, abId)
            endif
        endif
        if aw == wantAb then
            if GetUnitAbilityLevel(u, aw) == 0 then
                call UnitAddAbility(u, aw)
            endif
        else
            if GetUnitAbilityLevel(u, aw) > 0 then
                call UnitRemoveAbility(u, aw)
            endif
        endif
        set i = i + 1
    endloop
    set i = 0
    loop
        exitwhen i >= 25
        set abId = PAX_Leg_MegaSlotAb(i)
        if abId == wantAb then
            if GetUnitAbilityLevel(u, abId) == 0 then
                call UnitAddAbility(u, abId)
            endif
        else
            if GetUnitAbilityLevel(u, abId) > 0 then
                call UnitRemoveAbility(u, abId)
            endif
        endif
        set i = i + 1
    endloop
    call PAX_Leg_SyncStats(u)
endfunction

function PAX_Form_HasOrb takes unit u, integer expectedId returns boolean
    local integer slot = 0
    local integer id = 0
    loop
        exitwhen slot >= 6
        set id = GetItemTypeId(UnitItemInSlot(u, slot))
        if PAX_Form_ItemIndex(id) > 0 and (expectedId == 0 or id == expectedId) then
            return true
        endif
        set slot = slot + 1
    endloop
    return false
endfunction

function PAX_Form_SyncHeldStats takes unit u returns nothing
    local integer h = 0
    local integer bonus = 0
    local integer ut = 0
    local integer s = 0
    local integer i = 0
    local integer it = 0
    if u == null or not IsUnitType(u, UNIT_TYPE_HERO) then
        return
    endif
    set h = GetHandleId(u)
    if PAX_Form_HasOrb(u, 0) then
        set bonus = 60
    else
        set ut = GetUnitTypeId(u)
        loop
            exitwhen s >= 6 or bonus > 0
            set it = GetItemTypeId(UnitItemInSlot(u, s))
            if it != 0 then
                set i = 0
                loop
                    exitwhen i >= Mega_N or bonus > 0
                    if Mega_Base[i] == ut and Mega_Stone[i] == it then
                        set bonus = 40
                    endif
                    set i = i + 1
                endloop
            endif
            set s = s + 1
        endloop
    endif
    if bonus != LoadInteger(PAX_Leg_HT, h, 144) then
        call SaveInteger(PAX_Leg_HT, h, 144, bonus)
        call PAX_Leg_SyncStats(u)
    endif
endfunction

function PAX_Form_CheckReady takes unit u, integer slot returns string
    local integer h = 0
    local real left = 0.0
    if u == null or not PAX_Form_ItemMatches(GetUnitTypeId(u), slot) or not IsUnitType(u, UNIT_TYPE_HERO) then
        return "This Form Orb belongs to a different Pokemon."
    endif
    if GetWidgetLife(u) <= 0.405 or GetPlayerId(GetOwningPlayer(u)) >= 12 then
        return "Choose a living Pokemon first."
    endif
    set h = GetHandleId(u)
    if LoadInteger(Mega_HT, h, 0) > 0 then
        return "Wait for the Mega form to end before switching forms."
    endif
    if Mega_Time < LoadReal(PAX_Leg_HT, h, 150) then
        return "Wait for the evolution already in progress."
    endif
    set left = LoadReal(PAX_Leg_HT, h, 142) - Mega_Time
    if left > 0.0 then
        return "Form switch is recharging: " + I2S(R2I(left + 0.99)) + "s."
    endif
    if LoadInteger(PAX_Leg_HT, h, 141) == 1 and GetPlayerState(GetOwningPlayer(u), PLAYER_STATE_RESOURCE_GOLD) < 10000 then
        return "Switching form again costs 10,000 gold."
    endif
    return ""
endfunction

