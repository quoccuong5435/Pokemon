//MEGA_PRELUDE_BEGIN
// Replaces every ReplaceUnitBJ of the original map (inserted right after endglobals so all triggers can use it).
// An evolution trigger runs once per level gained and waits 1.5s; several level-ups inside that wait used to
// replace the same unit several times, leaving duplicate Pokemon. Only the first replacement of a unit counts.
// v3.3: forms reached through a Soul (the 14 legend heroes of the map and every form a Soul of ours gives) start with
// no learned moves, so they learn the moves of their own species instead of keeping the old Pokemon's
function Mega_ResetsMoves takes integer id returns boolean
    local integer i = 0
    if id == 'E020' or id == 'E021' or id == 'E022' or id == 'E023' or id == 'E024' or id == 'E025' or id == 'E026' then
        return true
    endif
    if id == 'E027' or id == 'E028' or id == 'E029' or id == 'E02A' or id == 'E03J' or id == 'E04C' or id == 'E04D' then
        return true
    endif
    loop
        exitwhen i >= Soul_N
        if Soul_Hero[i] == id then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

// v3.4: does u carry an item of type id (early helper: Everstone, Mega Ring)
function Itm_Has takes unit u, integer id returns boolean
    local integer s = 0
    if id == 0 then
        return false
    endif
    loop
        exitwhen s >= 6
        if GetItemTypeId(UnitItemInSlot(u, s)) == id then
            return true
        endif
        set s = s + 1
    endloop
    return false
endfunction

// v3.4: is `to` a direct evolution of `from` (gym evolution data: Ab_HT 699 / 700 + 2k on the type)
function Mega_IsEvolution takes integer from, integer to returns boolean
    local integer k = 0
    loop
        exitwhen k >= LoadInteger(Ab_HT, from, 699)
        if LoadInteger(Ab_HT, from, 700 + 2 * k) == to then
            return true
        endif
        set k = k + 1
    endloop
    return false
endfunction

function Mega_SafeReplace takes unit u, integer newId, integer method returns nothing
    local integer h = GetHandleId(u)
    local integer i = 0
    local integer xp = 0
    local unit nu = null
    if u == null or GetUnitTypeId(u) == 0 or GetUnitTypeId(u) == newId then
        return
    endif
    if not Mega_EvoItem and Itm_Has(u, Itm_Everstone) and Mega_IsEvolution(GetUnitTypeId(u), newId) then
        return  // v3.4 Everstone: no level evolution (stones and Souls set Mega_EvoItem)
    endif
    if HaveSavedReal(Mega_HT, h, 9) and Mega_Time - LoadReal(Mega_HT, h, 9) < 10.0 then
        return
    endif
    call SaveReal(Mega_HT, h, 9, Mega_Time)
    if IsUnitType(u, UNIT_TYPE_HERO) then
        set xp = GetHeroXP(u)
    endif
    call ReplaceUnitBJ(u, newId, method)
    // learned moves (slots 40..43, "already considered" flags 200 + move) stay with the Pokemon
    set nu = bj_lastReplacedUnit
    if nu != null then
        call SaveInteger(Ab_HT, GetHandleId(nu), 123, LoadInteger(Ab_HT, h, 123))  // v3.4 Shiny stays
        call SaveInteger(Ab_HT, GetHandleId(nu), 124, 1)
        // experience (and so the level) stays with the Pokemon when it is replaced or evolves
        if IsUnitType(nu, UNIT_TYPE_HERO) and xp > 0 then
            call SetHeroXP(nu, xp, false)
        endif
        if not Mega_ResetsMoves(newId) then
            set i = 40
            loop
                exitwhen i > 43
                call SaveInteger(Ab_HT, GetHandleId(nu), i, LoadInteger(Ab_HT, h, i))
                set i = i + 1
            endloop
            set i = 0
            loop
                exitwhen i >= Mv_N
                call SaveInteger(Ab_HT, GetHandleId(nu), 200 + i, LoadInteger(Ab_HT, h, 200 + i))
                set i = i + 1
            endloop
        endif
    endif
    set nu = null
endfunction
//MEGA_PRELUDE_END

function Fy takes real Gy returns nothing
local real Hy
local real st=TimerGetElapsed(Ay)
if st<=0 then
set Ay=CreateTimer()
call TimerStart(Ay,1000000,false,null)
endif
if(Gy>0)then
loop
set Hy=Gy-TimerGetElapsed(Ay)+st
exitwhen Hy<=0
if(Hy>bj_POLLED_WAIT_SKIP_THRESHOLD)then
call TriggerSleepAction(0.1*Hy)
else
call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
endif
endloop
endif
endfunction
function Iy takes location ly,real Jy,real Ky returns location
return Location(GetLocationX(ly)+Jy*Cos(Ky*bj_DEGTORAD),GetLocationY(ly)+Jy*Sin(Ky*bj_DEGTORAD))
endfunction
function Ly takes nothing returns boolean
local real dx=GetDestructableX(GetFilterDestructable())-By
local real dy=GetDestructableY(GetFilterDestructable())-by
return(dx*dx+dy*dy<=bj_enumDestructableRadius)
endfunction
function My takes real Ny,location Oy,code Py returns nothing
local rect r
if(Ny>=0)then
set By=GetLocationX(Oy)
set by=GetLocationY(Oy)
set bj_enumDestructableRadius=Ny*Ny
set r=Rect(By-Ny,by-Ny,By+Ny,by+Ny)
call EnumDestructablesInRect(r,filterEnumDestructablesInCircleBJ,Py)
call RemoveRect(r)
set r=null
endif
endfunction
function Qy takes rect r,boolexpr Ry returns group
set Cy=CreateGroup()
call GroupEnumUnitsInRect(Cy,r,Ry)
call DestroyBoolExpr(Ry)
return Cy
endfunction
function Sy takes rect r returns group
set Cy=CreateGroup()
call GroupEnumUnitsInRect(Cy,r,Dy)
return Cy
endfunction
function Ty takes real Ny,location Uy,boolexpr Ry returns group
