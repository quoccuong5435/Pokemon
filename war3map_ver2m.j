    elseif formId == 6 then
        set name = "Palkia (Origin Form)"
        set green = 180
        set blue = 220
    elseif formId == 7 then
        set name = "Deoxys (Attack Form)"
        set green = 155
        set blue = 135
    elseif formId == 8 then
        set name = "Deoxys (Defense Form)"
        set red = 150
        set green = 200
    elseif formId == 9 then
        set name = "Deoxys (Speed Form)"
        set red = 160
        set blue = 200
    elseif formId == 10 then
        set name = "Walking Wake"
        set green = 195
        set blue = 145
    elseif formId == 11 then
        set name = "Gouging Fire"
        set green = 195
        set blue = 145
    elseif formId == 12 then
        set name = "Raging Bolt"
        set green = 195
        set blue = 145
    elseif formId == 13 then
        set name = "Roaring Moon"
        set green = 195
        set blue = 145
    elseif formId == 14 then
        set name = "Sandy Shocks"
        set green = 195
        set blue = 145
    elseif formId == 15 then
        set name = "Flutter Mane"
