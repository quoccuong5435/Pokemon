    call PAX_Leg_SetTip('AXLM', "Hidden Power: |cff999999Locked (Regigigas)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: During the first 8s after spawning or reviving, takes 15% less damage. After Slow Start, hits have a 35% chance (3s ICD) to deal 95% scaled STR in 300 AoE, stuns 0.6s, slows movement and attack speed by 40% for 2.5s, lowers Defense by 1 for 5s, and heals 5% max HP.")
    call PAX_Leg_SetTip('AXWM', "Awakened: |cffffcc00Crush Grip|r", "+30% All Stats. During the first 8s after spawning or reviving, takes 15% less damage. After Slow Start, hits have a 35% chance (3s ICD) to deal 95% scaled STR in 300 AoE, stuns 0.6s, slows movement and attack speed by 40% for 2.5s, lowers Defense by 1 for 5s, and heals 5% max HP.")
    call PAX_Leg_SetTip('AXLN', "Hidden Power: |cff999999Locked (Deoxys)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Move hits always trigger Psycho Boost and basic attacks have a 35% chance to trigger it (2.5s ICD). Psycho Boost deals 100% scaled highest STR/INT in 300 AoE, slows movement by 30% for 2s, lowers Defense and Sp. Def by 1 for 4s, and grants +35% attack speed and +20% movement speed for 3s.")
    call PAX_Leg_SetTip('AXWN', "Awakened: |cffffcc00Psycho Boost|r", "+30% All Stats. Move hits always trigger Psycho Boost and basic attacks have a 35% chance to trigger it (2.5s ICD). Psycho Boost deals 100% scaled highest STR/INT in 300 AoE, slows movement by 30% for 2s, lowers Defense and Sp. Def by 1 for 4s, and grants +35% attack speed and +20% movement speed for 3s.")
    call PAX_Leg_SetTip('AXLO', "Hidden Power: |cff999999Locked (Arceus)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Move hits always trigger Judgment and basic attacks have a 35% chance to trigger it (3s ICD). Judgment deals 95% scaled highest STR/INT in 360 AoE, stuns 0.4s, slows movement and attack speed by 30% for 2.5s, lowers Defense and Sp. Def by 1 for 5s, and cleanses Arceus. Blesses allies in 450 AoE: heals 5% max HP, restores 10% max mana, grants +1 Attack/Sp. Atk for 4s and a 15% damage barrier for 3s.")
    call PAX_Leg_SetTip('AXWO', "Awakened: |cffffcc00Judgment|r", "+30% All Stats. Move hits always trigger Judgment and basic attacks have a 35% chance to trigger it (3s ICD). Judgment deals 95% scaled highest STR/INT in 360 AoE, stuns 0.4s, slows movement and attack speed by 30% for 2.5s, lowers Defense and Sp. Def by 1 for 5s, and cleanses Arceus. Blesses allies in 450 AoE: heals 5% max HP, restores 10% max mana, grants +1 Attack/Sp. Atk for 4s and a 15% damage barrier for 3s.")
    call PAX_Leg_SetTip('AXLP', "Hidden Power: |cff999999Locked (Buzzwole)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Hits have a 35% chance (2.5s ICD) to deal 80% scaled STR in 260 AoE, stuns 0.4s, lowers Defense by 1 for 4s, grants +1 Attack/Speed for 5s and +30% attack speed for 3s, and heals Buzzwole for 8% max HP.")
    call PAX_Leg_SetTip('AXWP', "Awakened: |cffffcc00Beast Drain|r", "+30% All Stats. Hits have a 35% chance (2.5s ICD) to deal 80% scaled STR in 260 AoE, stuns 0.4s, lowers Defense by 1 for 4s, grants +1 Attack/Speed for 5s and +30% attack speed for 3s, and heals Buzzwole for 8% max HP.")
    call PAX_Leg_SetTip('AXLH', "Hidden Power: |cff999999Locked (Regirock)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Reduces basic attack damage taken by 15%. When hit by an attack or skill (3s ICD), retaliates in 300 AoE for 55% scaled STR plus 4% max HP, slows movement and attack speed by 35% for 2.5s, and heals you for 4% max HP.")
