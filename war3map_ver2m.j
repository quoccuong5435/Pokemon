function PkFx_Init takes nothing returns nothing
    local trigger fxTrig = CreateTrigger()
    call ExecuteFunc("PkFx_Data1")
    call ExecuteFunc("PkFx_Data2")
    call ExecuteFunc("PkFx_Data3")
    call ExecuteFunc("PkFx_Data4")
    call ExecuteFunc("PkFx_Data5")
