function PAX_Leg_SyncTooltips takes nothing returns nothing
    call PAX_Leg_SetTip('AXL1', "Hidden Power: |cff999999Locked (Articuno)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Attacks and moves slow movement and attack speed by 35% for 2s and lower Speed and Sp. Def by 1 for 4s. Each hit has a 35% chance (3.5s per-target cooldown) to freeze for 2s and deal 110% scaled INT in 350 AoE, slowing both speeds by 35% for 3s and lowering Defense and Sp. Def by 1 for 5s. The burst heals you and allies in 450 AoE for 5% max HP, restores 15% max Mana, and grants +1 Def/Sp. Def for 5s.")
    call PAX_Leg_SetTip('AXW1', "Awakened: |cffffcc00Absolute Zero|r", "+30% All Stats. Attacks and moves slow MS/AS by 35% for 2s and lower Speed and Sp. Def by 1 for 4s. Each hit has a 35% chance (3.5s per-target CD) to freeze 2s and deal 75% scaled INT in 350 AoE (-35% MS/AS 3s, -1 Def/Sp.Def 5s). Heals allies in 450 AoE for 12% max HP, 20% max Mana, +2 Def/Sp.Def (5s), and a 20% damage barrier (3.5s).")
    call PAX_Leg_SetTip('AXL2', "Hidden Power: |cff999999Locked (Zapdos)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Every 5s, lightning hits 1 target for 65% scaled INT or up to 3 targets for 40% scaled INT each.")
    call PAX_Leg_SetTip('AXW2', "Awakened: |cffffcc00Thunderbird Awakening|r", "+30% All Stats. Every 3s in combat, lightning hits 1 target for 85% scaled INT or up to 3 targets for 60% scaled INT each in 550 AoE, stuns 0.4s, lowers Sp. Def by 1 (4s), and grants +25% AS/MS for 2.5s.")
    call PAX_Leg_SetTip('AXL3', "Hidden Power: |cff999999Locked (Moltres)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Move casts have a 35% chance (6s ICD) to trigger Flame Phoenix for 50% scaled INT in 280 AoE plus 10% scaled INT/s burn for 3s; a surviving 1.5s Fire Egg hatches for 60% scaled INT in 400 AoE.")
    call PAX_Leg_SetTip('AXW3', "Awakened: |cffffcc00Phoenix Sovereign|r", "+30% All Stats. Hits and move casts have a 35% chance (3.5s ICD) to trigger Flame Phoenix for 75% scaled INT in 300 AoE (-1 Sp. Def 4s) plus 12% scaled INT/s burn for 3s. Fatal damage forms a breakable 1.5s Fire Egg at 50% HP; if it survives, it hatches with a 60% scaled INT burst in 400 AoE.")
    call PAX_Leg_SetTip('AXL4', "Hidden Power: |cff999999Locked (Mewtwo)|r", "+30% All Stats. Moves grant up to 3 Psychic Orbs; basic attacks generate one every 2s. Every attack releases each orb for 50% scaled INT in 300 AoE, with 35% movement and 30% attack-speed slow for 2.5s and -1 Defense/Sp. Def for 4s; 2+ orbs also stun for 0.6s.")
    call PAX_Leg_SetTip('AXW4', "Awakened: |cffffcc00Telekinetic Dominator|r", "+30% All Stats. Moves grant up to 3 Psychic Orbs; basic attacks generate one every 2s. Every attack releases each orb for 50% scaled INT in 300 AoE, with 35% movement and 30% attack-speed slow for 2.5s and -1 Defense/Sp. Def for 4s; 2+ orbs also stun for 0.6s. Melee hits push attackers 450 away, deal 55% scaled INT, stun 0.75s, and slow both speeds by 40% for 2.5s (4s ICD).")
    call PAX_Leg_SetTip('AXL5', "Hidden Power: |cff999999Locked (Mew)|r", "+30% All Stats. Move casts have a 50% chance and basic attacks have a 25% chance (8s ICD) to activate a 6s Mirage (+25% AS). Every 0.75s it fires a 35% scaled Main Stat bolt in 240 AoE; bolts may Burn for 12%/s for 3s, Poison, or Paralyze and stun for 0.3s.")
    call PAX_Leg_SetTip('AXW5', "Awakened: |cffffcc00Genetic Mirage|r", "+30% All Stats. Move casts have a 50% chance and basic attacks have a 25% chance (6s ICD) to cleanse, heal 10% max HP/Mana, and activate a 6s Mirage (+25% AS). Every 0.75s it fires a 35% scaled Main Stat bolt in 240 AoE that may Burn, Poison, or Paralyze and stun 0.3s.")
    call PAX_Leg_SetTip('AXL6', "Hidden Power: |cff999999Locked (Raikou)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Attacks within 500 trigger a 50% scaled INT burst, 0.4s stun, and +40% AS/MS for 2.5s (4s ICD).")
    call PAX_Leg_SetTip('AXW6', "Awakened: |cffffcc00Thunderstep Flash|r", "+30% All Stats. Attacks within 500 range (3s ICD) trigger a 75% scaled INT burst in 220 AoE, 0.4s stun, and +40% AS/MS for 2.5s; dash to the target only beyond 110 range.")
    call PAX_Leg_SetTip('AXL7', "Hidden Power: |cff999999Locked (Entei)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Basic attacks have a 35% chance (3s ICD) to erupt magma for 50% scaled STR in 260 AoE, stuns for 0.5s, and burns for 12% scaled STR/s for 3s.")
    call PAX_Leg_SetTip('AXW7', "Awakened: |cffffcc00Volcanic Eruption|r", "+30% All Stats. Basic attacks have a 35% chance (3s ICD) to erupt magma for 70% scaled STR in 280 AoE, stun 0.5s, lower Defense by 1 (4s), burn 12% scaled STR/s for 3s, and heal Entei for 8% max HP.")
    call PAX_Leg_SetTip('AXL8', "Hidden Power: |cff999999Locked (Suicune)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: In combat, gains a 25% max HP Aurora Mirror lasting up to 6s (5s cooldown after shatter). While active, reflects 50% of absorbed skill damage (cap: 120% scaled INT). On break or after 6s, shatters for 110% scaled INT in 380 AoE, slows movement and attack speed by 45% for 3s, lowers Attack/Sp. Atk by 1 for 5s, heals Suicune 10% plus allies 6% in 450 AoE, and grants +25% MS for 3s, +1 Def/Sp. Def for 5s, and a 25% damage-reduction barrier for 4s. Hits have a 35% chance (3s ICD) to unleash an 80% scaled INT Aurora Wave in 320 AoE with 35% movement/attack-speed slow for 2.5s and -1 Speed for 4s, healing you and allies in 400 AoE for 4% max HP and 10% max Mana.")
    call PAX_Leg_SetTip('AXW8', "Awakened: |cffffcc00Aurora Mirror|r", "+30% All Stats. In combat, gains a 30% max HP Aurora Mirror for up to 6s (5s CD after shatter), reflecting 50% of absorbed skill damage. On shatter, deals 70% scaled INT in 380 AoE (-45% MS/AS 3s, -1 Atk/Sp.Atk 5s), heals Suicune 15% and allies 12% in 450 AoE, and grants +25% MS (3s), +2 Def/Sp.Def (5s), and a 30% damage barrier (4.5s). Hits have a 35% chance (3s ICD) for a 55% scaled INT Aurora Wave healing allies 8% HP and 12% Mana.")
    call PAX_Leg_SetTip('AXL9', "Hidden Power: |cff999999Locked (Lugia)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Hits have a 35% chance (4s ICD) to release Aeroblast in 450 AoE for 100% scaled INT, slowing movement and attack speed by 35% for 2.5s and lowering Attack/Sp. Atk by 1 for 4s; heals you and allies for 7% max HP, restores 10% max Mana, and grants +25% MS for 3s, +1 Sp. Atk/Sp. Def for 5s, and a 25% damage-reduction barrier for 3.5s.")
    call PAX_Leg_SetTip('AXW9', "Awakened: |cffffcc00Aeroblast|r", "+30% All Stats. Hits have a 35% chance (4s ICD) to release Aeroblast in 450 AoE for 80% scaled INT (-35% MS/AS 2.5s, -1 Atk/Sp.Atk 4s), heal allies 12% max HP and 15% max Mana, and grant +25% MS (3s), +2 Sp.Atk/Sp.Def (5s), and a 30% damage barrier (4s).")
    call PAX_Leg_SetTip('AXLA', "Hidden Power: |cff999999Locked (Ho-Oh)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Hits have a 35% chance (2.5s ICD) to release Sacred Ash for 65% scaled STR in 280 AoE, burns for 12% scaled STR/s for 3s, cleanses you, heals you for 5% max HP, and heals allies for 4% in 350 AoE.")
    call PAX_Leg_SetTip('AXWA', "Awakened: |cffffcc00Sacred Ash|r", "+30% All Stats. Hits have a 35% chance (2.5s ICD) to release Sacred Ash for 65% scaled STR in 280 AoE, burns for 12% scaled STR/s for 3s, cleanses you, heals you for 5% max HP, and heals allies for 4% in 350 AoE.")
    call PAX_Leg_SetTip('AXLB', "Hidden Power: |cff999999Locked (Celebi)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Move casts have a 50% chance and basic attacks have a 25% chance (6s ICD) to create a 4s Time Sanctuary. Each second, it cleanses and heals you and allies in 450 AoE for 5% max HP, 12% max Mana, +30% AS/MS for 1.5s, and +1 Attack/Sp. Atk for 4s, while enemies in 400 AoE take 35% scaled INT, are slowed by 35% for 1.5s, and lose 1 Speed for 4s.")
    call PAX_Leg_SetTip('AXWB', "Awakened: |cffffcc00Time Sanctuary|r", "+30% All Stats. Move casts have a 50% chance and basic attacks have a 25% chance (6s ICD) to create a 4s Time Sanctuary. Each second, it cleanses and heals allies in 450 AoE for 8% max HP, 15% max Mana, +35% AS/MS (1.5s), and +2 Atk/Sp.Atk (4.5s), while enemies in 400 AoE take 25% scaled INT, -35% MS/AS, and -1 Speed.")
    call PAX_Leg_SetTip('AXLC', "Hidden Power: |cff999999Locked (Kyogre)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Move hits always trigger Tidal Surge and basic attacks have a 35% chance to trigger it (3s ICD). Tidal Surge deals 85% scaled INT in 340 AoE; damage is multiplied by 1.25 against targets in Drizzle rain or already slowed. Slows movement and attack speed by 35% for 2.5s and lowers Sp. Def by 1 for 5s.")
    call PAX_Leg_SetTip('AXWC', "Awakened: |cffffcc00Tidal Surge|r", "+30% All Stats. Move hits always trigger Tidal Surge and basic attacks have a 35% chance to trigger it (3s ICD). Tidal Surge deals 85% scaled INT in 340 AoE; damage is multiplied by 1.25 against targets in Drizzle rain or already slowed. Slows movement and attack speed by 35% for 2.5s and lowers Sp. Def by 1 for 5s.")
    call PAX_Leg_SetTip('AXLD', "Hidden Power: |cff999999Locked (Groudon)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Hits have a 35% chance (4s ICD) to open a Tectonic Fissure for 75% scaled STR in 300 AoE, stuns for 0.4s, lowers Defense by 1 for 5s, and burns for 10% scaled STR/s for 3s.")
    call PAX_Leg_SetTip('AXWD', "Awakened: |cffffcc00Tectonic Fissure|r", "+30% All Stats. Hits have a 35% chance (4s ICD) to open a Tectonic Fissure for 75% scaled STR in 300 AoE, stuns for 0.4s, lowers Defense by 1 for 5s, and burns for 10% scaled STR/s for 3s.")
    call PAX_Leg_SetTip('AXLE', "Hidden Power: |cff999999Locked (Rayquaza)|r", "+30% All Stats. Complete Awakening Quest Chain (-quest). Unlocked: Hits have a 35% chance (3.5s ICD) to unleash Skybound Ascent for 65% scaled Main Stat in 320 AoE and stuns for 0.3s. Grants +15% AS for 3s and +1 Attack and Speed for 2.5s.")
