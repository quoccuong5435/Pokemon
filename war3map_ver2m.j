function sa takes nothing returns nothing
local widget ta=null
local unit ua=null
local integer va=0
local boolean wa=true
set ta=bj_lastDyingWidget
if(ta==null)then
set ua=GetTriggerUnit()
endif
if(ua!=null)then
set wa=not IsUnitHidden(ua)
if(wa and GetChangingUnit()!=null)then
set wa=(GetChangingUnitPrevOwner()==Player(PLAYER_NEUTRAL_AGGRESSIVE))
endif
endif
if(wa)then
call RandomDistReset()
call RandomDistAddItem('I00B',100)
set va=RandomDistChoose()
if(ua!=null)then
call Az(ua,va)
else
call WidgetDropItem(ta,va)
endif
endif
set bj_lastDyingWidget=null
call DestroyTrigger(GetTriggeringTrigger())
endfunction
function xa takes nothing returns nothing
set bn=CreateSound("Sound\\Interface\\BattleNetTick.wav",false,false,false,10,10,"DefaultEAXON")
call SetSoundParamsFromLabel(bn,"ChatroomTimerTick")
call SetSoundDuration(bn,476)
call SetSoundChannel(bn,0)
call SetSoundVolume(bn,106)
endfunction
