    set Type_Label[6] = "Fighting"
    set Type_Color[6] = "|cffc22e28"
    set Type_Label[7] = "Fire"
    set Type_Color[7] = "|cffee8130"
    set Type_Label[8] = "Flying"
    set Type_Color[8] = "|cffa98ff3"
    set Type_Label[9] = "Ghost"
    set Type_Color[9] = "|cff735797"
    set Type_Label[10] = "Grass"
    set Type_Color[10] = "|cff7ac74c"
