function Fx_Texts takes nothing returns nothing
    set Ab_N = 90
    set Ab_Name[74] = "Pressure"
    set Ab_Info[74] = "Legend Pressure: enemies within 800 pay double mana for moves, their cooldowns run 30% slower, -25% attack speed and -1 Attack / Sp. Atk. The holder ignores stat drops and flinching. Mewtwo: Psychic +20%, a psychic shield (20% max HP, 8s) below 50% HP every 90s. Zapdos: 30% paralysis on melee attackers. Articuno / Moltres: +20% freeze / burn. Raikou: +1 Speed every 8s in combat. Giratina: 15% of hits pass through. Deoxys: Psychic +15%, cooldowns -15%. Dialga: own cooldowns -25%. Palkia: 20% critical, enemies slowed."
    call BlzSetAbilityTooltip(Ab_InfoId(74), "Ability: |cffffcc00Pressure|r", 0)
