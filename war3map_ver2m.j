function PAX_Leg_ShowDlg takes integer pid returns nothing
    local dialog d = null
    local integer base = 0
    local integer pages = 0
    local integer page = 0
    local integer k = 0
    local integer n = 0
    local integer idx = 0
    local integer b = 0
    if pid < 0 or pid >= 12 then
        return
    endif
    set d = PAX_Leg_Dlg[pid]
    set b = pid * 12
    set page = PAX_Leg_DlgPage[pid]
    set pages = (PAX_Leg_Count() + 7) / 8
    if page < 0 then
        set page = 0
    elseif page >= pages then
        set page = pages - 1
    endif
    set PAX_Leg_DlgPage[pid] = page
    set base = page * 8
    call DialogClear(d)
    loop
        exitwhen k >= 12
        set PAX_Leg_DlgBtn[b + k] = null
        set PAX_Leg_DlgVal[b + k] = 0
        set k = k + 1
    endloop
    set k = 0
    loop
        exitwhen k >= 8 or base + k >= PAX_Leg_Count()
        set idx = base + k + 1
        set PAX_Leg_DlgBtn[b + n] = DialogAddButton(d, PAX_Leg_Name(idx), 0)
        set PAX_Leg_DlgVal[b + n] = idx
        set n = n + 1
        set k = k + 1
    endloop
    if PAX_Leg_Count() > 8 and page > 0 then
        set PAX_Leg_DlgBtn[b + n] = DialogAddButton(d, "< Prev page", 0)
        set PAX_Leg_DlgVal[b + n] = -1
        set n = n + 1
    endif
    if PAX_Leg_Count() > 8 and page < pages - 1 then
        set PAX_Leg_DlgBtn[b + n] = DialogAddButton(d, "Next page >", 0)
        set PAX_Leg_DlgVal[b + n] = -2
        set n = n + 1
    endif
    set PAX_Leg_DlgBtn[b + n] = DialogAddButton(d, "Close", 0)
    set PAX_Leg_DlgVal[b + n] = 0
    call DialogSetMessage(d, "Legend Selection (page " + I2S(page + 1) + " of " + I2S(pages) + ")")
    call DialogDisplay(Player(pid), d, true)
    set d = null
endfunction

function PAX_Leg_LegCmd takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local integer pid = GetPlayerId(p)
    if pid >= 0 and pid < 12 then
        set PAX_Leg_DlgPage[pid] = 0
        call PAX_Leg_ShowDlg(pid)
    endif
    set p = null
endfunction
function PAX_Leg_QKey takes integer pid, integer idx returns integer
    return 1000 + pid * 64 + idx
endfunction

function PAX_Leg_Stage takes integer qk returns integer
    local integer stage = LoadInteger(PAX_Leg_HT, qk, 0)
    if stage <= 1 then
        return 1
    endif
    return stage
endfunction

function PAX_Form_Id takes unit u returns integer
    if u == null then
        return 0
    endif
    return LoadInteger(PAX_Leg_HT, GetHandleId(u), 140)
endfunction

function PAX_Leg_Awakened takes unit u returns boolean
    local integer idx = 0
    local integer pid = 0
    local integer qk = 0
    if u == null or not IsUnitType(u, UNIT_TYPE_HERO) then
        return false
    endif
    set idx = PAX_Leg_Index(GetUnitTypeId(u))
    set pid = GetPlayerId(GetOwningPlayer(u))
    if pid >= 12 then
        return false
    endif
    // Non-legend Paradox Pokemon must complete Awakening Quest (-quest) just like Legends
    if idx == 0 then
        return false
    endif
    set qk = PAX_Leg_QKey(pid, idx)
    return LoadInteger(PAX_Leg_HT, qk, 0) == 4
endfunction

function PAX_Form_BonusHP takes unit u returns integer
    local integer formId = PAX_Form_Id(u)
    if formId == 1 or formId == 3 then
        return 400
    elseif formId == 4 then
        return -1200
    elseif formId == 5 then
        return 600
    elseif formId == 7 then
        return -800
    elseif formId == 8 then
        return 3500
    elseif formId == 16 then
        return 1800
    elseif formId == 17 then
        return 2000
    endif
    return 0
endfunction

function PAX_Form_Type takes unit u, integer k returns integer
    local integer formId = PAX_Form_Id(u)
    if k == 1 and formId >= 1 and formId <= 3 then
        return T_FLYING
    endif
    if k == 0 then
        if formId == 1 then
            return T_PSYCHIC
        elseif formId == 2 then
            return T_FIGHTING
        elseif formId == 3 then
            return T_DARK
        endif
    endif
    if k < 0 or k > 1 then
        return -1
    endif
    if formId == 10 then
        if k == 0 then
            return T_WATER
        endif
        return T_DRAGON
    elseif formId == 11 then
        if k == 0 then
            return T_FIRE
        endif
        return T_DRAGON
    elseif formId == 12 then
        if k == 0 then
            return T_ELECTRIC
        endif
        return T_DRAGON
    elseif formId == 13 then
        if k == 0 then
            return T_DRAGON
        endif
        return T_DARK
    elseif formId == 14 then
        if k == 0 then
            return T_ELECTRIC
        endif
        return T_GROUND
    elseif formId == 15 then
        if k == 0 then
            return T_GHOST
        endif
        return T_FAIRY
    elseif formId == 16 then
        if k == 0 then
            return T_FAIRY
        endif
        return T_PSYCHIC
    elseif formId == 17 then
        if k == 0 then
            return T_ROCK
        endif
        return T_ELECTRIC
    elseif formId == 18 then
        if k == 0 then
            return T_FAIRY
        endif
        return T_FIGHTING
    elseif formId == 19 then
        if k == 0 then
            return T_DARK
        endif
        return T_FLYING
    endif
    return LoadInteger(Ab_HT, GetUnitTypeId(u), 53 + k) - 1
endfunction

// Form item and cast rawcodes here share the same consecutive final digit.
function PAX_Form_ItemIndex takes integer id returns integer
    if id >= 'IM11' and id <= 'IM19' then
        return id - 'IM11' + 1
    elseif id >= 'AM11' and id <= 'AM19' then
        return id - 'AM11' + 1
    elseif id >= 'IM1A' and id <= 'IM1H' then
        return id - 'IM1A' + 10
    elseif id >= 'AM1A' and id <= 'AM1H' then
        return id - 'AM1A' + 10
    endif
    return 0
endfunction

function PAX_Form_ItemMatches takes integer id, integer slot returns boolean
    if slot == 1 then
        return id == 'E020'
    elseif slot == 2 then
        return id == 'E03J'
    elseif slot == 3 then
        return id == 'E021'
    elseif slot == 4 then
        return id == 'E028'
    elseif slot == 5 then
        return id == 'E04C'
    elseif slot == 6 then
        return id == 'E04D'
    elseif slot == 7 then
        return id == 'E027'
    elseif slot == 8 then
        return id == 'P3XA'
    elseif slot == 9 then
        return id == 'P1DA'
    elseif slot == 10 then
        return id == 'P39A'
    elseif slot == 11 then
        return id == 'EN0F'
    elseif slot == 12 then
        return id == 'E032' or id == 'P4XA' or id == 'P2LA'
    elseif slot == 13 then
        return id == 'P2UA' or id == 'P2VA'
    elseif slot == 14 then
        return id == 'P20A' or id == 'P4IA'
    elseif slot == 15 then
        return id == 'EN08'
    elseif slot == 16 then
        return id == 'EN0B' or id == 'EN0C'
    elseif slot == 17 then
        return id == 'P1YA'
    endif
    return false
endfunction

function PAX_Form_ItemAbility takes integer slot returns integer
    if slot >= 1 and slot <= 9 then
        return 'AM11' + slot - 1
    elseif slot >= 10 and slot <= 17 then
        return 'AM1A' + slot - 10
    endif
    return 0
endfunction

