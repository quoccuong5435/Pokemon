function PAX_Leg_OnDlgClick takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local dialog d = GetClickedDialog()
    local button bt = GetClickedButton()
    local unit h = null
    local unit u = null
    local unit nu = null
    local integer pid = 0
    local integer slot = 0
    local integer b = 0
    local integer legIdx = 0
    local integer hId = 0
    loop
        exitwhen pid >= 12 or PAX_Leg_Dlg[pid] == d
        set pid = pid + 1
    endloop
    if pid < 12 then
        call DialogDisplay(p, d, false)
        set b = pid * 12
        loop
            exitwhen slot >= 12 or PAX_Leg_DlgBtn[b + slot] == bt
            set slot = slot + 1
        endloop
        if slot < 12 then
            set legIdx = PAX_Leg_DlgVal[b + slot]
            if legIdx == -1 then
                set PAX_Leg_DlgPage[pid] = PAX_Leg_DlgPage[pid] - 1
                call PAX_Leg_ShowDlg(pid)
            elseif legIdx == -2 then
                set PAX_Leg_DlgPage[pid] = PAX_Leg_DlgPage[pid] + 1
                call PAX_Leg_ShowDlg(pid)
            elseif legIdx > 0 and legIdx <= PAX_Leg_Count() then
                call GroupClear(Rand_Tmp)
                call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
                loop
                    set u = FirstOfGroup(Rand_Tmp)
                    exitwhen u == null
                    call GroupRemoveUnit(Rand_Tmp, u)
                    if h == null and IsUnitType(u, UNIT_TYPE_HERO) and GetWidgetLife(u) > 0.405 then
                        set h = u
                    endif
                endloop
                if h == null then
                    call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00-leg: no living Pokemon to replace.|r")
                else
                    set hId = GetHandleId(h)
                    call RemoveSavedReal(Mega_HT, hId, 9)
                    call Mega_SafeReplace(h, PAX_Leg_Type(legIdx), bj_UNIT_STATE_METHOD_RELATIVE)
                    set nu = bj_lastReplacedUnit
                    if nu != null then
                        call Ab_Sync(nu)
                        call Hero_HPSync(nu)
                        call SelectUnitForPlayerSingle(nu, p)
                        call DisplayTimedTextToPlayer(p, 0, 0, 7.0, "|cffffcc00-leg: switched to " + PAX_Leg_Name(legIdx) + ".|r")
                    else
                        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00-leg: replacement failed.|r")
                    endif
                endif
                call GroupClear(Rand_Tmp)
            endif
        endif
    endif
    set p = null
    set d = null
    set bt = null
    set h = null
    set u = null
    set nu = null
endfunction

function PAX_Plate_OnDlgClick takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local dialog d = GetClickedDialog()
    local button bt = GetClickedButton()
    local integer pid = 0
    local integer slot = 0
    local integer b = 0
    local integer val = 0
    loop
        exitwhen pid >= 12 or PAX_Plate_Dlg[pid] == d
        set pid = pid + 1
    endloop
    if pid < 12 then
        call DialogDisplay(p, d, false)
        set b = pid * 12
        loop
            exitwhen slot >= 12 or PAX_Plate_DlgBtn[b + slot] == bt
            set slot = slot + 1
        endloop
        if slot < 12 then
            set val = PAX_Plate_DlgVal[b + slot]
            if val == -1 then
                set PAX_Plate_DlgPage[pid] = PAX_Plate_DlgPage[pid] - 1
                call PAX_Plate_ShowDlg(pid)
            elseif val == -2 then
                set PAX_Plate_DlgPage[pid] = PAX_Plate_DlgPage[pid] + 1
                call PAX_Plate_ShowDlg(pid)
            elseif val > 0 and val <= 19 then
                call PAX_Plate_ApplyChoice(pid, val)
            endif
        endif
    endif
    set p = null
    set d = null
    set bt = null
endfunction

function Mega_Init takes nothing returns nothing
    local trigger t = CreateTrigger()
    local trigger lt = null
    local trigger sdt = null
    local trigger nst = null
    local trigger dmt = null
    local trigger tyt = null
    local trigger hostLeave = null
    local texttag ntt = null
    local integer i = 0
    call Stat_InitData()
    call Mega_InitData()
    call Rand_InitData()
    call Evo_InitData()
    call Leg_InitData()
    call ExecuteFunc("Ab_InitData")
    call ExecuteFunc("Ty_InitData")
    call ExecuteFunc("Ty_InitUnits")
    call Mv_Init()
    call Pick_Init()
    call Gym_Init()
    call Duel_Init()
    set sdt = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(sdt, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(sdt, Condition(function Soul_DropOnDeath))
    set lt = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(lt, EVENT_PLAYER_UNIT_SELL_ITEM)
    call TriggerAddCondition(lt, Condition(function LegTele_OnSell))
    call Wild_InitData()
    call ExecuteFunc("V34_Data1")
    call ExecuteFunc("V34_Data2")
    call ExecuteFunc("V34_Data3")
    call ExecuteFunc("V34_Data4")
    call ExecuteFunc("Wild_IndexPool")
    call Wild_RegisterCamps()
    call Ty_InitKits()
    call TimerStart(Wild_Timer, 2.0, true, function Wild_Tick)
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Mega_OnCast))
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(t, Condition(function Ty_OnCast))
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(t, Condition(function Mega_OnBeginCast))
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_USE_ITEM)
    call TriggerAddCondition(t, Condition(function Mega_OnUseItem))
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(t, Condition(function Mega_OnDeath))
    set t = CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(t, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(t, Condition(function Mega_OnAttacked))
    call TimerStart(Mega_Timer, 0.25, true, function Mega_Tick)
    call Base_Init()
    call Ext_PlaceShops()
    call Mob_InitMana()  // v3.4.1 (v3.3.4): wild Pokemon spawn with full mana
    call Item_InitData()
    call Dmg_InitTypes()
    call TimerStart(CreateTimer(), 0.1, false, function TyUI_Init)  // v3.4.4
    call HomeGate_Init()  // v3.4.5
    call PkFx_Init()  // v3.4.9
    call ExecuteFunc("Fx_Init")  // v3.4.11: initializes Fx_Texts
    call PAX_DecorateMap()
    call PAX_CelebiDeathInit()
    call PAX_InitChatHelp()
    call PAX_Leg_Init()
    call FogEnable(PAX_FogEnabled)
    call FogMaskEnable(PAX_FogEnabled)
    set t = CreateTrigger()
    set hostLeave = CreateTrigger()
    set i = 0
    loop
        exitwhen i >= 12
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-fog", true)
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-vision", true)
        call TriggerRegisterPlayerEvent(hostLeave, Player(i), EVENT_PLAYER_LEAVE)
        set i = i + 1
    endloop
    call TriggerAddAction(t, function PAX_FogCmd)
    call TriggerAddAction(hostLeave, function PAX_HostLeave)
    set hostLeave = null
    set i = 0
    call Mega_Quests()
    set t = CreateTrigger()
    loop
        exitwhen i >= 12
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-random", true)
        set i = i + 1
    endloop
    call TriggerAddAction(t, function Rand_OnChat)
    set t = CreateTrigger()
    set i = 0
    loop
        exitwhen i >= 12
        call TriggerRegisterPlayerChatEvent(t, Player(i), "-repick", true)
        set i = i + 1
    endloop
