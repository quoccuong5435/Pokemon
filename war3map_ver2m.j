function pz takes nothing returns nothing
local integer pickedItemId
local itemtype qz
local integer rz=0
local integer sz=0
local integer oz
set oz=1
loop
if(bj_stockAllowedPermanent[oz])then
set sz=sz+1
if(GetRandomInt(1,sz)==1)then
set qz=ITEM_TYPE_PERMANENT
set rz=oz
endif
endif
if(bj_stockAllowedCharged[oz])then
set sz=sz+1
if(GetRandomInt(1,sz)==1)then
set qz=ITEM_TYPE_CHARGED
set rz=oz
endif
endif
if(bj_stockAllowedArtifact[oz])then
set sz=sz+1
if(GetRandomInt(1,sz)==1)then
set qz=ITEM_TYPE_ARTIFACT
set rz=oz
endif
endif
set oz=oz+1
exitwhen oz>bj_MAX_ITEM_LEVEL
endloop
if(sz==0)then
set qz=null
return
endif
call mz(qz,rz)
set qz=null
endfunction
