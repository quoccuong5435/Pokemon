// ---------------------------------------------------------------------------------------------
// Mega Evolution (Pokemon Arena v2.0). Per-unit state in Mega_HT, parent key = handle id:
//   0 = active mega index + 1 (0 = not mega), 1 = end time, 2 = original proper name,
//   3 = aura effect, 4 = Kangaskhan Kid, 5 = last Kid hit time, 100 + i = cooldown end of button i
// ---------------------------------------------------------------------------------------------
// ======== [END FILE: 03_data_moves_pick_item.j] ========
// ======== [BEGIN FILE: 04_sys_hero_mega_wild_ty.j] ========
function Mega_HasStone takes unit u, integer idx returns boolean
    local integer i = 0
    local integer n = UnitInventorySize(u)
    loop
        exitwhen i >= n
        if GetItemTypeId(UnitItemInSlot(u, i)) == Mega_Stone[idx] then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

// v3.3: a hero whose level allows its next evolution evolves (also after a Soul or a level reached by other means)
function Evo_Check takes unit u returns nothing
    local integer id = GetUnitTypeId(u)
    local integer i = 0
    if LoadInteger(Mega_HT, GetHandleId(u), 0) > 0 or PAX_Form_Id(u) > 0 or LoadInteger(PAX_Leg_HT, GetHandleId(u), 175) == 1 then
        return
    endif
    if GetHeroLevel(u) <= LoadInteger(Mega_HT, GetHandleId(u), 35) then
        return
    endif
    loop
        exitwhen i >= Evo_N
        if Evo_From[i] == id and GetHeroLevel(u) >= Evo_Level[i] then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl", u, "chest"))
            call Mega_SafeReplace(u, Evo_To[i], bj_UNIT_STATE_METHOD_RELATIVE)
            return
        endif
        set i = i + 1
    endloop
endfunction

// v3.3: playable Pokemon max HP x2 in total. Most of their HP comes from Strength (25 per point), so the
// extra is total Strength * 25 * (Hero_HPExtra), kept in Mega_HT key 60 so it can be corrected later.
function Badge_Count takes integer pid returns integer
    local integer g = 0
    local integer n = 0
    loop
        exitwhen g >= 8
        if Badge_Has[pid * 8 + g] then
            set n = n + 1
        endif
        set g = g + 1
    endloop
    return n
endfunction

// v3.3.1: milestone = number of cleared gym pairs in order (gym 1+2, then 3+4, 5+6, 7+8), 0..4
function Gym_Milestone takes integer pid returns integer
    local integer s = 0
    loop
        exitwhen s >= 4
        exitwhen not (Badge_Has[pid * 8 + 2 * s] and Badge_Has[pid * 8 + 2 * s + 1])
        set s = s + 1
    endloop
    return s
endfunction

function Badge_Cap takes integer pid returns integer
    local integer s = Gym_Milestone(pid)
    if s == 0 then
        return Gym_Cap0
    elseif s == 1 then
        return Gym_Cap1
    elseif s == 2 then
        return Gym_Cap2
    elseif s == 3 then
        return Gym_Cap3
    endif
    return Gym_Cap4
endfunction

// gym g (0..7) can be challenged: gyms 1..2 (milestone 0), 1..4 (1), 1..6 (2), 1..8 (3 and 4)
// v4.3.3: minimum hero level to enter gym g (0..7)
function Gym_MinLevel takes integer g returns integer
    return 10 * (g + 1)
endfunction

function Gym_Allowed takes integer pid, integer g returns boolean
    return g == 0 or Badge_Has[pid * 8 + g - 1]  // v4.3.3: in order, the badge of the gym before
endfunction

// level above the cap (Rare Candy, chicken...): back to the cap
function Badge_LevelCap takes unit u, integer pid returns nothing
    local integer cap = Badge_Cap(pid)
    if GetHeroLevel(u) > cap then
        call UnitStripHeroLevel(u, GetHeroLevel(u) - cap)
        call DisplayTimedTextToPlayer(Player(pid), 0, 0, 8.0, "|cffff8800Level cap " + I2S(cap) + ": clear the next 2 gyms to raise it.|r")
    endif
    call SuspendHeroXP(u, GetHeroLevel(u) >= cap)
endfunction

// v3.3.1: environment damage sources of the legend lands (dummy units of the old traps)
function Env_IsSource takes integer id returns boolean
    return id == 'h010' or id == 'n03A' or id == 'h01A' or id == 'h01B' or id == 'h01C' or id == 'h01D' or id == 'h01F' or id == 'h01G' or id == 'n037'
endfunction

// v3.3.1: at most Item_MaxBadges badges and Item_MaxStat stat items (kind at key 90 of the item type); Souls are free
function Item_OnPickup takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local item it = GetManipulatedItem()
    local integer k = LoadInteger(Mega_HT, GetItemTypeId(it), 90)
    local integer n = 0
    local integer s = 0
    local integer lim = Item_MaxStat
    local item x = null
    local integer itH = 0
    local integer ownerPid = 0
    if u != null and it != null and IsUnitType(u, UNIT_TYPE_HERO) and GetPlayerId(GetOwningPlayer(u)) < 12 then
        set itH = GetHandleId(it)
        set ownerPid = GetPlayerId(GetOwningPlayer(u))
        if LoadInteger(PAX_Leg_HT, itH, 100) == 1 and LoadInteger(PAX_Leg_HT, itH, 102) != ownerPid then
            call UnitRemoveItem(u, it)
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 5.0, "|cffff4040[SOULBOUND] This item belongs to Player " + I2S(LoadInteger(PAX_Leg_HT, itH, 102) + 1) + " and cannot be used!|r")
            set u = null
            set it = null
            return
        endif
        if LoadReal(PAX_Leg_HT, itH, 101) == 0.0 then
            call SaveReal(PAX_Leg_HT, itH, 101, Mega_Time)
            call SaveInteger(PAX_Leg_HT, itH, 102, ownerPid)
            call SaveInteger(PAX_Leg_HT, itH, 100, 0)
        endif
    endif
    if IsUnitType(u, UNIT_TYPE_HERO) and GetPlayerId(GetOwningPlayer(u)) < 12 and PAX_IsLootItemId(GetItemTypeId(it)) then
        if PAX_CountLootExcept(u, null) > 2 then
            call UnitRemoveItem(u, it)
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 5.0, "|cffff4040At most 2 dropped items can be equipped.|r")
            set u = null
            set it = null
            set x = null
            return
        endif
    endif
    // Vitamin Stat Cap (Protein, Calcium, Carbos, HP Up): Infinite purchases, max 100 consumption per Pokemon
    if IsUnitType(u, UNIT_TYPE_HERO) and GetPlayerId(GetOwningPlayer(u)) < 12 then
        set s = GetItemTypeId(it)
        set n = 0
        set lim = 0
        if s == 'I005' then      // Protein (+1 Str, 200g)
            set n = 1
            set lim = 200
        elseif s == 'I004' then  // Calcium (+1 Int, 200g)
            set n = 1
            set lim = 200
        elseif s == 'I006' then  // Carbos (+1 Agi, 200g)
            set n = 1
            set lim = 200
        elseif s == 'I003' then  // HP Up (+50 HP, 200g)
            set n = 1
            set lim = 200
        elseif s == 'I002' then  // Protein x5 (+5 Str, 150g)
            set n = 5
            set lim = 150
        elseif s == 'I001' then  // Calcium x5 (+5 Int, 150g)
            set n = 5
            set lim = 150
        elseif s == 'I000' then  // Carbos x5 (+5 Agi, 150g)
            set n = 5
            set lim = 150
        endif
        if n > 0 then
            set k = LoadInteger(PAX_Leg_HT, GetHandleId(u), 90)
            if k + n > 100 then
                // Revert stat gain
                if s == 'I005' or s == 'I002' then
                    call SetHeroStr(u, GetHeroStr(u, false) - n, true)
                elseif s == 'I004' or s == 'I001' then
                    call SetHeroInt(u, GetHeroInt(u, false) - n, true)
                elseif s == 'I006' or s == 'I000' then
                    call SetHeroAgi(u, GetHeroAgi(u, false) - n, true)
                elseif s == 'I003' then
                    call BlzSetUnitMaxHP(u, BlzGetUnitMaxHP(u) - 50)
                    if GetWidgetLife(u) > I2R(BlzGetUnitMaxHP(u)) then
                        call SetWidgetLife(u, I2R(BlzGetUnitMaxHP(u)))
                    endif
                endif
                // Refund gold
                call AdjustPlayerStateBJ(lim, GetOwningPlayer(u), PLAYER_STATE_RESOURCE_GOLD)
                call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, "|cffff5c5c[VITAMINS]|r Maximum 100 Vitamin limit reached (" + I2S(k) + "/100)! Gold refunded.|r")
                set u = null
                set it = null
                set x = null
                return
            else
                call SaveInteger(PAX_Leg_HT, GetHandleId(u), 90, k + n)
                call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 4.0, "|cff4ade80[VITAMINS]|r Vitamin applied (" + I2S(k + n) + "/100).|r")
            endif
        endif
    endif
    if k == 0 or GetPlayerId(GetOwningPlayer(u)) >= 12 then
        set u = null
        set it = null
        return
    endif
    if k == 1 then
        set lim = Item_MaxBadges
    endif
    if k == 3 then  // v3.4 battle items
        set lim = 3
    endif
    loop
        exitwhen s >= 6
        set x = UnitItemInSlot(u, s)
        if x != null and LoadInteger(Mega_HT, GetItemTypeId(x), 90) == k then
            set n = n + 1
        endif
        set s = s + 1
    endloop
    if n > lim then
        call UnitRemoveItem(u, it)
        if k == 1 then
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, "|cffff4040At most " + I2S(lim) + " gym badges can be carried.|r")
        elseif k == 3 then
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, "|cffff4040At most 3 battle items can be held.|r")
        else
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, "|cffff4040At most " + I2S(lim) + " stat items (power items and Mega Stones) can be carried.|r")
        endif
    endif
    set u = null
    set it = null
    set x = null
endfunction

// each gym badge (item) a hero carries gives +5 x gym number to Strength, Agility and Intelligence (tracked at key 36)
function Badge_Buff takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer want = 0
    local integer old = LoadInteger(Mega_HT, h, 36)
    local integer s = 0
    local integer g = 0
    local item it = null
    loop
        exitwhen s >= 6
        set it = UnitItemInSlot(u, s)
        if it != null then
            set g = 0
            loop
                exitwhen g >= 8
                if GetItemTypeId(it) == Gym_Item[g] then
                    set want = want + 5 * (g + 1)
                endif
                set g = g + 1
            endloop
        endif
        set s = s + 1
    endloop
    if want != old then
        call SetHeroStr(u, GetHeroStr(u, false) + want - old, true)
        call SetHeroAgi(u, GetHeroAgi(u, false) + want - old, true)
        call SetHeroInt(u, GetHeroInt(u, false) + want - old, true)
        call SaveInteger(Mega_HT, h, 36, want)
    endif
    set it = null
endfunction

// v3.2.16: HP, attack and attack speed of a Pokemon from its PokemonDB stats (keys 80..86 under its type id).
// max HP = HP x 100 x (1 + 2% per level) + 25 per bonus Str; the game's own HP per Str point is taken back.
// attack = primary attribute x 0.8 .. x 1.2; attack cooldown / (1 + 2% per bonus Agi).
// armor = (Def + SpDef) / 4 + 0.3 per bonus Agi.
// Per-unit keys: 60 HP added to the game's value, 61 applied cooldown x 1000, 62 applied primary attribute + 1,
// 63 bonus Agi whose armor was added.
// =============================================================================================
// v3.4.11 move / status engine, part 1 (inserted before Hero_HPSync): only reads data, no calls into later code.
// Fx_HT layout (the move / Ability rework plan approved 2026-11-14)
//   unit handle: 1..5 stat stage (1 Atk 2 Def 3 SpA 4 SpD 5 Spe), 11..15 stage end time, 20 main status
//     (1 burn 2 poison 3 toxic 4 paralysis 5 sleep 6 freeze), 21 status end, 22 toxic step, 24 confusion end,
//     25 silence end, 26 accuracy-down end, 30 move key of the last cast, 31 cast time, 32 cast serial,
//     33 serial whose self effects are done, 34 held gym type item + 1, 35 hard-CC window end, 36 item proc time,
//     37 charging (1), 38 fake-out armed serial, 41 Mewtwo shield ready, 42 shield HP, 43 shield end,
//     44 Ho-Oh rebirth ready, 45 Regirock Sturdy ready, 46 last speed tick, 47 rain zone end, 48 rain owner + 1,
//     49 sun zone end, 50 sun owner + 1, 51 pressure end, 52 pressure tier, 53 Slow Start stage given, 60 portal ready
//   move key (100000 + move index) or kit skill ability id: 1 flags, 2 recoil permille, 3 drain permille, 4 status,
//     5 status chance, 6 flinch chance, 7 self chance, 8 target chance, 10..14 self stage, 20..24 target stage,
//     26 accuracy down (1), 30 class (1 physical, 2 special), 31 type + 1
//   unit type: 1 Def, 2 Sp. Def, 3 legend code, 4 Pressure tier (2 legend, 3 Dialga, 4 Palkia)
//   item type: 1 type index + 1 (type items), 2 = 1 one per Pokemon, 3 gold price
//   200000 + type index: 1 type item, 2 ability count, 10 + k abilities of the item (gym holders)
// =============================================================================================
function Fx_StageMult takes unit u, integer s returns real
    local integer hand = GetHandleId(u)
    local integer stage = LoadInteger(Fx_HT, hand, s)
    local real step = 0.25
    if stage == 0 or Mega_Time >= LoadReal(Fx_HT, hand, 10 + s) then
        return 1.0
    endif
    if s == 5 then
        set step = 0.15
    endif
    if stage > 0 then
        return 1.0 + step * I2R(stage)
    endif
    return 1.0 / (1.0 + step * I2R(-stage))
endfunction

function Fx_HasKind takes unit u, integer k returns boolean
    if u == null or k < 1 or k > 6 then
        return false
    endif
    return Mega_Time < LoadReal(Fx_HT, GetHandleId(u), 80 + k)
endfunction

function Fx_HasStatus takes unit u returns boolean
    local integer k = 1
    loop
        exitwhen k > 6
        if Fx_HasKind(u, k) then
            return true
        endif
        set k = k + 1
    endloop
    return false
endfunction

function Fx_StatusOf takes unit u returns integer
    local integer k = 1
    loop
        exitwhen k > 6
        if Fx_HasKind(u, k) then
            return k
        endif
        set k = k + 1
    endloop
    return 0
endfunction

function Fx_Silenced takes unit u returns boolean
    return Mega_Time < LoadReal(Fx_HT, GetHandleId(u), 25)
endfunction

// key of the move a unit cast within Ty_Window (100000 + move index, or the kit skill id), 0 = none
function Fx_CurMove takes unit u returns integer
    local integer hand = GetHandleId(u)
    if Mega_Time - LoadReal(Fx_HT, hand, 31) <= Ty_Window then
        return LoadInteger(Fx_HT, hand, 30)
    endif
    return 0
endfunction

function Fx_MoveHas takes unit u, integer flag returns boolean
    local integer mkey = Fx_CurMove(u)
    local integer bits = 0
    if mkey == 0 then
        return false
    endif
    set bits = LoadInteger(Fx_HT, mkey, 1)
    return ModuloInteger(bits / flag, 2) == 1
endfunction

// class of the move a unit just used: 1 physical, 2 special (Ty_OnCast keeps it in Ab_HT 56)
function Fx_CurPhys takes unit u returns integer
    local integer hand = GetHandleId(u)
    if LoadInteger(Ab_HT, hand, 51) > 0 and Mega_Time - LoadReal(Ab_HT, hand, 52) <= Ty_Window then
        if LoadInteger(Ab_HT, hand, 56) == 1 then
            return 1
        endif
    endif
    return 2
endfunction

// the stat that scales a hero's move: STR for physical moves, INT for special moves (v3.4.11, was the larger one)
function Fx_SkillStat takes unit u returns real
    if PAX_Form_Id(u) == 18 then
        return PAX_Leg_MainStat(u)
    endif
    if Fx_CurPhys(u) == 1 then
        return I2R(GetHeroStr(u, true))
    endif
    return I2R(GetHeroInt(u, true))
endfunction

// attack speed factor: Speed stage, Chlorophyll / Swift Swim in their weather, Regigigas after Slow Start
function Fx_ASMult takes unit u returns real
    local integer hand = GetHandleId(u)
    local integer abil = LoadInteger(Ab_HT, hand, 0)
    local real mult = Fx_StageMult(u, 5)
    if ((abil == AB_CHLOROPHYLL and Wth_Cur == 2) or (abil == AB_SWIFTSWIM and Wth_Cur == 1)) and Mega_Time >= LoadReal(Fx_HT, hand, 104) then
        set mult = mult * 1.3
    endif
    if LoadInteger(Fx_HT, GetUnitTypeId(u), 3) == 18 and Mega_Time - LoadReal(Ab_HT, hand, 9) >= 8.0 then
        set mult = mult * 1.3
    endif
    if abil == AB_DELTASTREAM then
        set mult = mult * 1.15
    endif
    if abil == AB_DEOXYSFORM and PAX_Form_Id(u) == 9 then
        set mult = mult * 1.30
    endif
    if PAX_Paradox_Active(u, abil) then
        set mult = mult * 1.15
    endif
    return mult
endfunction

// extra move speed from the Speed stage (Ab_MoveBonus adds it)
function Fx_MSBonus takes unit u returns real
    return (Fx_StageMult(u, 5) - 1.0) * GetUnitDefaultMoveSpeed(u)
endfunction

// v3.4.14 safety: a charge never keeps the user paused longer than 1.5s (key 72 = charge serial)
function Fx_ChargeTimeout takes nothing returns nothing
    local timer tm = GetExpiredTimer()
    local integer k = GetHandleId(tm)
    local unit u = LoadUnitHandle(Fx_HT, k, 0)
    if u != null and LoadInteger(Fx_HT, GetHandleId(u), 37) == 1 and LoadInteger(Fx_HT, GetHandleId(u), 72) == LoadInteger(Fx_HT, k, 1) then
        call SaveInteger(Fx_HT, GetHandleId(u), 37, 0)
        call BlzPauseUnitEx(u, false)
    endif
    call FlushChildHashtable(Fx_HT, k)
    call DestroyTimer(tm)
    set tm = null
    set u = null
endfunction

// Mv_Queue: a charging move (Solar Beam, Sky Attack ...) waits 1.2s, the user cannot act meanwhile.
// v3.4.14: pressing the move again while it charges must not pause the user a second time (BlzPauseUnitEx counts:
// two pauses and one unpause left the Pokemon frozen for good).
function Fx_QueueDelay takes unit u, integer mvi returns real
    local integer bits = 0
    local integer hand = GetHandleId(u)
    local timer tm = null
    if mvi < 0 then
        return 0.0
    endif
    set bits = LoadInteger(Fx_HT, 100000 + mvi, 1)
    if ModuloInteger(bits / 2, 2) == 0 then
        return 0.0
    endif
    if ModuloInteger(bits / 2097152, 2) == 1 and Wth_Cur == 2 then  // Solar Beam / Solar Blade in harsh sun
        return 0.0
    endif
    if LoadInteger(Fx_HT, hand, 37) == 1 then  // already charging: no second pause
        return 1.2
    endif
    call SaveInteger(Fx_HT, hand, 37, 1)
    call SaveInteger(Fx_HT, hand, 72, LoadInteger(Fx_HT, hand, 72) + 1)
    call BlzPauseUnitEx(u, true)
    set tm = CreateTimer()
    call SaveUnitHandle(Fx_HT, GetHandleId(tm), 0, u)
    call SaveInteger(Fx_HT, GetHandleId(tm), 1, LoadInteger(Fx_HT, hand, 72))
    call TimerStart(tm, 1.5, false, function Fx_ChargeTimeout)
    set tm = null
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl", u, "origin"))
    return 1.2
endfunction

function Fx_ChargeEnd takes unit u returns nothing
    local integer hand = GetHandleId(u)
    if LoadInteger(Fx_HT, hand, 37) == 1 then
        call SaveInteger(Fx_HT, hand, 37, 0)
        call BlzPauseUnitEx(u, false)
    endif
endfunction

function Hero_HPSync takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer t = GetUnitTypeId(u)
    local integer old = LoadInteger(Mega_HT, h, 60)
    local integer want = 0
    local integer wantMana = 0
    local real f = 0.0
    local integer nat = 0
    local integer tot = 0
    local integer pri = 0
    local integer lo = 0
    local integer hi = 0
    local integer cd = 0
    local real pct = 0.0
    local real manaPct = 0.0
    if LoadInteger(Mega_HT, t, 80) <= 0 then
        return
    endif
    set f = 1.0 + Stat_Growth * I2R(GetHeroLevel(u) - 1)
    // HP: the game gives base field + Hero_StrHP x Str; we want HP x 100 x f + Stat_BonusHP x (Str - natural Str)
    set nat = R2I(I2R(LoadInteger(Mega_HT, t, 82)) * f)
    set tot = GetHeroStr(u, true)
    set want = R2I(I2R(LoadInteger(Mega_HT, t, 80)) * f + Stat_BonusHP * I2R(tot - nat) - Hero_StrHP * I2R(tot)) - LoadInteger(Mega_HT, t, 81)
    if LoadInteger(Ab_HT, GetHandleId(u), 0) == AB_THICKFAT then  // v3.4: Thick Fat +10% max HP
        set want = want + R2I(0.1 * I2R(LoadInteger(Mega_HT, t, 80)) * f)
    endif
    if LoadInteger(Mega_HT, h, 0) > 0 then
        set want = want + Mega_BonusHP[LoadInteger(Mega_HT, h, 0) - 1]
    endif
    set want = want + PAX_Form_BonusHP(u)
    if GetPlayerId(GetOwningPlayer(u)) < 12 then
        set want = want + PAX_Up_VitLv[GetPlayerId(GetOwningPlayer(u))] * 500
    endif
    if LoadInteger(Fx_HT, t, 1) >= 110 or LoadInteger(Fx_HT, t, 2) >= 115 or PAX_Form_Id(u) == 8 or PAX_Form_Id(u) == 16 or PAX_Form_Id(u) == 17 then
        set want = R2I(I2R(want) * 1.35)
    endif
    if BlzGetUnitMaxHP(u) + want - old < 1 then
        set want = old + 1 - BlzGetUnitMaxHP(u)
    endif
    if want != old then
        set pct = GetUnitLifePercent(u)
        call BlzSetUnitMaxHP(u, BlzGetUnitMaxHP(u) + want - old)
        call SetUnitLifePercentBJ(u, pct)
        call SaveInteger(Mega_HT, h, 60, want)
    endif
    set wantMana = 400 + 15 * GetHeroLevel(u) + 2 * GetHeroInt(u, true)
    if wantMana != BlzGetUnitMaxMana(u) then
        if BlzGetUnitMaxMana(u) > 0 then
            set manaPct = GetUnitState(u, UNIT_STATE_MANA) / I2R(BlzGetUnitMaxMana(u))
        endif
        call BlzSetUnitMaxMana(u, wantMana)
        call SetUnitState(u, UNIT_STATE_MANA, I2R(R2I(I2R(wantMana) * manaPct)))
        call SaveInteger(Mega_HT, h, 64, wantMana)
    endif
    // attack: 0.8 .. 1.2 x the primary attribute. v3.2.17 fix: a hero's runtime base damage (BlzGet/SetUnitBaseDamage)
    // already includes the primary attribute, so it is set to min - 1 (v3.2.16 also took the attribute off: min 0)
    if PAX_Form_Id(u) == 18 then
        set pri = R2I(PAX_Leg_MainStat(u))
    elseif LoadInteger(Mega_HT, h, 0) - 1 == 13 or PAX_Form_Id(u) == 2 then
        set pri = GetHeroStr(u, true)
    elseif LoadInteger(Mega_HT, t, 85) == 1 then
        set pri = GetHeroStr(u, true)
    else
        set pri = GetHeroInt(u, true)
    endif
    if pri + 1 != LoadInteger(Mega_HT, h, 62) then
        set lo = R2I(I2R(pri) * Stat_AtkMin + 0.5)
        set hi = R2I(I2R(pri) * Stat_AtkMax + 0.5)
        if lo < 1 then
            set lo = 1
        endif
        if hi < lo then
            set hi = lo
        endif
        call BlzSetUnitDiceNumber(u, 1, 0)
        call BlzSetUnitDiceSides(u, hi - lo + 1, 0)
        set lo = lo - 1
        if LoadInteger(Mega_HT, h, 0) > 0 then  // in Mega form: keep the damage bonus Mega_Start added
            set lo = lo + LoadInteger(Mega_HT, h, 13)
        endif
        call BlzSetUnitBaseDamage(u, lo, 0)
        call SaveInteger(Mega_HT, h, 62, pri + 1)
    endif
    // attack speed and armor: only Agi above the natural value counts (the game constants are 0)
    set nat = GetHeroAgi(u, true) - R2I(I2R(LoadInteger(Mega_HT, t, 83)) * f)
    if nat != LoadInteger(Mega_HT, h, 63) then
        call BlzSetUnitArmor(u, BlzGetUnitArmor(u) + Stat_BonusArmor * I2R(nat - LoadInteger(Mega_HT, h, 63)))
        call SaveInteger(Mega_HT, h, 63, nat)
    endif
    set pct = 1.0 + 0.001 * I2R(GetHeroAgi(u, true)) + Stat_BonusAS * I2R(nat) + PAX_Loot_GetAS(u) + PAX_Leg_GetAS(u)
    if Mega_Time < LoadReal(PAX_Leg_HT, h, 170) then
        set pct = pct + 0.35
    endif
    if pct < 0.2 then
        set pct = 0.2
    endif
    // v3.4: x Hero_ASBoost, x the Ability / attack-slow multiplier that Ab_Pulse keeps in Ab_HT key 84
    set pct = pct * Hero_ASBoost
    if LoadReal(Ab_HT, h, 84) > 0.0 then
        set pct = pct * LoadReal(Ab_HT, h, 84)
    endif
    set pct = pct * Fx_ASMult(u)  // v3.4.11
    set cd = R2I(I2R(LoadInteger(Mega_HT, t, 86)) / pct)
    if cd < Stat_MinAtkCD then
        set cd = Stat_MinAtkCD
    endif
    if cd != LoadInteger(Mega_HT, h, 61) then
        call BlzSetUnitAttackCooldown(u, I2R(cd) / 1000.0, 0)
        call SaveInteger(Mega_HT, h, 61, cd)
    endif
endfunction

// every second: HP / attack / attack speed (Hero_HPSync), evolution and badges of every Pokemon
// (v3.2.19: Mega Evolve is used from the Mega Stone item, there is no Mega button on the card any more)
function Hero_Tick takes nothing returns nothing
    local integer pid = 0
    local unit u = null
    loop
        exitwhen pid >= 12
        call GroupEnumUnitsOfPlayer(Rand_Tmp, Player(pid), null)
        loop
            set u = FirstOfGroup(Rand_Tmp)
            exitwhen u == null
            call GroupRemoveUnit(Rand_Tmp, u)
            if IsUnitType(u, UNIT_TYPE_HERO) and (GetWidgetLife(u) > 0.405) then
                call PAX_TestItem_Sync(u)
                call PAX_Form_SyncHeldStats(u)
                call PAX_GodChu_Sync(u)
                call PAX_Late_SyncHero(u)
                call Hero_HPSync(u)
                call Evo_Check(u)
                call Badge_Buff(u)
                call Badge_LevelCap(u, pid)
            endif
        endloop
        set pid = pid + 1
    endloop
    set u = null
endfunction

function Mega_KidFollow takes unit u, unit kid returns nothing
    local real a = (GetUnitFacing(u) + 150.0) * bj_DEGTORAD
    local real tx = GetUnitX(u) + 90.0 * Cos(a)
    local real ty = GetUnitY(u) + 90.0 * Sin(a)
    local real dx = tx - GetUnitX(kid)
    local real dy = ty - GetUnitY(kid)
    local real d = SquareRoot(dx * dx + dy * dy)
    if d > 600.0 then
        call SetUnitPosition(kid, tx, ty)
        call SetUnitFacing(kid, GetUnitFacing(u))
    elseif d > 50.0 then
        call IssuePointOrder(kid, "move", tx, ty)
    else
        call SetUnitFacing(kid, GetUnitFacing(u))
    endif
endfunction

function Mega_End takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer idx = LoadInteger(Mega_HT, h, 0) - 1
    local effect fx = null
    local unit kid = null
    if idx < 0 then
        return
    endif
    set fx = LoadEffectHandle(Mega_HT, h, 3)
    set kid = LoadUnitHandle(Mega_HT, h, 4)
    call SaveInteger(Mega_HT, h, 0, 0)
    call GroupRemoveUnit(Mega_Group, u)
    if fx != null then
        call DestroyEffect(fx)
        call RemoveSavedHandle(Mega_HT, h, 3)
    endif
    if kid != null then
        call RemoveUnit(kid)
        call RemoveSavedHandle(Mega_HT, h, 4)
    endif
    if GetUnitTypeId(u) != 0 then
        // remove exactly the bonus Mega_Start added (stats may have grown meanwhile)
        call SetHeroStr(u, GetHeroStr(u, false) - LoadInteger(Mega_HT, h, 10), true)
        call SetHeroAgi(u, GetHeroAgi(u, false) - LoadInteger(Mega_HT, h, 11), true)
        call SetHeroInt(u, GetHeroInt(u, false) - LoadInteger(Mega_HT, h, 12), true)
        call BlzSetUnitBaseDamage(u, BlzGetUnitBaseDamage(u, 0) - LoadInteger(Mega_HT, h, 13), 0)
        call UnitRemoveAbility(u, 'AMB1')
        call UnitRemoveAbility(u, 'AMB2')
        call UnitRemoveAbility(u, 'AMB3')
        call BlzSetUnitSkin(u, GetUnitTypeId(u))
        call SetUnitScale(u, Mega_BaseScale[idx], Mega_BaseScale[idx], Mega_BaseScale[idx])
        call SetUnitVertexColor(u, 255, 255, 255, 255)
        call BlzSetHeroProperName(u, LoadStr(Mega_HT, h, 2))
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", GetUnitX(u), GetUnitY(u)))
        set PAX_MegaSyncU = u
        call ExecuteFunc("PAX_MegaSyncX")
        set PAX_MegaSyncU = null
    endif
    set fx = null
    set kid = null
endfunction

function Mega_Start takes unit u, integer idx returns nothing
    local integer h = GetHandleId(u)
    local integer i = 0
    local player p = GetOwningPlayer(u)
    local integer bs = 0
    local integer b_agi = 0
    local integer bi = 0
    local integer bd = 0
    local string banner = "[MEGA EVOLVE]"
    if LoadInteger(Mega_HT, h, 0) > 0 then
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffff66ccMega refused: already in Mega form|r")
        set p = null
        return
    endif
    // v3.2.16: stat bonus = points x Mega_PctPerPoint % of the current stat; the points are the PokemonDB change
    // (Mega stat / normal stat - 1, in %), so they can be negative (Mega Beedrill SpA)
    set bs = R2I(I2R(GetHeroStr(u, true)) * I2R(Mega_PStr[idx] * Mega_PctPerPoint) / 100.0)
    set b_agi = R2I(I2R(GetHeroAgi(u, true)) * I2R(Mega_PAgi[idx] * Mega_PctPerPoint) / 100.0)
    set bi = R2I(I2R(GetHeroInt(u, true)) * I2R(Mega_PInt[idx] * Mega_PctPerPoint) / 100.0)
    // damage bonus = Mega_DamageBonus x (base damage + highest stat) (0 since v3.2.16)
    set bd = GetHeroStr(u, true)
    if GetHeroAgi(u, true) > bd then
        set bd = GetHeroAgi(u, true)
    endif
    if GetHeroInt(u, true) > bd then
        set bd = GetHeroInt(u, true)
    endif
    set bd = R2I(Mega_DamageBonus * I2R(BlzGetUnitBaseDamage(u, 0) + bd))
    call SaveInteger(Mega_HT, h, 10, bs)
    call SaveInteger(Mega_HT, h, 11, b_agi)
    call SaveInteger(Mega_HT, h, 12, bi)
    call SaveInteger(Mega_HT, h, 13, bd)
    call SaveInteger(Mega_HT, h, 0, idx + 1)
    if Itm_Has(u, Itm_MegaRing) then  // v3.4 Mega Ring: 90s
        call SaveReal(Mega_HT, h, 1, Mega_Time + Mega_Duration + 30.0)
    else
        call SaveReal(Mega_HT, h, 1, Mega_Time + Mega_Duration)
    endif
    call SaveStr(Mega_HT, h, 2, GetHeroProperName(u))
    // X and Y buttons of the same Pokemon share the cooldown
    loop
        exitwhen i >= Mega_N
        if Mega_Base[i] == Mega_Base[idx] then
            if Itm_Has(u, Itm_MegaRing) then  // v3.4 Mega Ring: recharges 30% faster
                call SaveReal(Mega_HT, h, 100 + i, Mega_Time + Mega_Cooldown * 0.7)
            else
                call SaveReal(Mega_HT, h, 100 + i, Mega_Time + Mega_Cooldown)
            endif
            if i != idx and GetUnitAbilityLevel(u, Mega_Evolve[i]) > 0 then
                call BlzStartUnitAbilityCooldown(u, Mega_Evolve[i], Mega_Cooldown)
            endif
        endif
        set i = i + 1
    endloop
    call GroupAddUnit(Mega_Group, u)
    call BlzSetUnitSkin(u, Mega_Skin[idx])
    call SetUnitScale(u, Mega_Scale[idx], Mega_Scale[idx], Mega_Scale[idx])
    call SetUnitVertexColor(u, Mega_R[idx], Mega_G[idx], Mega_B[idx], 255)
    call BlzSetHeroProperName(u, Mega_Name[idx])
    call SetHeroStr(u, GetHeroStr(u, false) + bs, true)
    call SetHeroAgi(u, GetHeroAgi(u, false) + b_agi, true)
    call SetHeroInt(u, GetHeroInt(u, false) + bi, true)
    call BlzSetUnitBaseDamage(u, BlzGetUnitBaseDamage(u, 0) + bd, 0)
    call UnitAddAbility(u, 'AMB1')
    call UnitAddAbility(u, 'AMB2')
    call UnitAddAbility(u, 'AMB3')
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", GetUnitX(u), GetUnitY(u)))
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIim\\AIimTarget.mdl", GetUnitX(u), GetUnitY(u)))
    if Mega_Fx[idx] != "" then
        call SaveEffectHandle(Mega_HT, h, 3, AddSpecialEffectTarget(Mega_Fx[idx], u, "origin"))
    endif
    if idx == Mega_KangIdx then
        call SaveUnitHandle(Mega_HT, h, 4, CreateUnit(p, Mega_KidId, GetUnitX(u), GetUnitY(u), GetUnitFacing(u)))
        call SaveReal(Mega_HT, h, 5, 0.0)
    endif
    if idx == 33 or idx == 34 then
        set banner = "[PRIMAL REVERSION]"
    endif
    call PAX_Announce("|cffd896ff" + banner + "|r |cff7dd3fc" + GetPlayerName(p) + "|r's |cffe8ecf2" + LoadStr(Mega_HT, h, 2) + " became|r |cffd896ff" + Mega_Name[idx] + "|r!", 8.0)
    if Ab_MegaAb[idx] > 0 then
        call DisplayTimedTextToPlayer(p, 0, 0, 10.0, "|cffff66cc" + Mega_Name[idx] + "|r Ability: |cffffcc00" + Ab_Name[Ab_MegaAb[idx]] + "|r - " + Ab_Info[Ab_MegaAb[idx]])
    endif
    set PAX_MegaSyncU = u
    call ExecuteFunc("PAX_MegaSyncX")
    if Ab_MegaAb[idx] == AB_INTIMIDATE then
        call RemoveSavedReal(Ab_HT, h, 73)
        set PAX_MegaSyncU = u
        call ExecuteFunc("PAX_MegaIntimidateX")
    endif
    set PAX_MegaSyncU = null
    set p = null
endfunction

// ---------------------------------------------------------------------------------------------
// Wild creeps. Per-unit keys in Mega_HT: 20 base max HP, 21 base damage, 22 base armor, 23 base gold,
// 24 applied tier + 1, 25 camp + 1. Wild unit types are marked with key 7 under their type id.
// ---------------------------------------------------------------------------------------------
function Wild_IsWildType takes integer id returns boolean
    return LoadBoolean(Mega_HT, id, 7)
endfunction

// scale a wild creep to its level, always from its stored base values (v3.2.16: PokemonDB stats).
// Its object data holds the stats of its own level (key 26); the shown level is max(own level, Wild_AvgLevel)
// and HP / damage grow Stat_Growth per level from there. Elites: HP, damage and armor x the elite factors.
// Keys: 20 base max HP, 21 base damage, 22 base armor, 23 base gold, 24 applied average level + 1, 37 average damage.
function Wild_Scale takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer own = LoadInteger(Mega_HT, h, 26)
    local integer lv = own
    local real m = 1.0
    local real gm = 1.0 + Wild_TierStep * I2R(Wild_Tier)
    local real hpf = 1.0
    local real dmf = 1.0
    local real armf = 1.0
    local real goldf = 1.0
    local real pct = 0.0
    local real avg = 0.0
    local integer lo = 0
    local integer hi = 0
    if own < 1 then
        set own = 1
    endif
    if Wild_AvgLevel > lv then
        set lv = Wild_AvgLevel
    endif
    set m = (1.0 + Stat_Growth * I2R(lv - 1)) / (1.0 + Stat_Growth * I2R(own - 1))
    if LoadInteger(Mega_HT, h, 29) == 1 then
        set hpf = Wild_EliteHP
        set dmf = Wild_EliteDmg
        set goldf = Wild_EliteGold
        set armf = Wild_EliteArmor
    endif
    if LoadInteger(Mega_HT, h, 44) > 0 then  // v3.4 Mega elite
        set hpf = hpf * 1.2
        set dmf = dmf * 1.2
    endif
    set pct = GetUnitLifePercent(u)
    // v3.4: HP = the v3.2.15 table of its power (key 31; else by its own level) x the tier step
    set lo = LoadInteger(Mega_HT, h, 31)
    if lo < 1 then
        set lo = 1
        loop
            exitwhen lo >= 10 or Wild_PowLv[lo + 1] > own
            set lo = lo + 1
        endloop
    endif
    if lo > 10 then
        set lo = 10
    endif
    call BlzSetUnitMaxHP(u, R2I(Wild_PowHP[lo] * m * hpf))
    call SetUnitLifePercentBJ(u, pct)
    set avg = LoadReal(Mega_HT, h, 37) * m * dmf * Wild_DmgMult
    set lo = R2I(avg * Stat_AtkMin + 0.5)
    set hi = R2I(avg * Stat_AtkMax + 0.5)
    if lo < 1 then
        set lo = 1
    endif
    if hi < lo then
        set hi = lo
    endif
    call BlzSetUnitDiceNumber(u, 1, 0)
    call BlzSetUnitDiceSides(u, hi - lo + 1, 0)
    call BlzSetUnitBaseDamage(u, lo - 1, 0)
    call BlzSetUnitArmor(u, LoadReal(Mega_HT, h, 22) * armf + I2R(Wild_Tier * Wild_TierArmor))
    call BlzSetUnitIntegerField(u, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE, R2I(I2R(LoadInteger(Mega_HT, h, 23)) * gm * goldf * Wild_GoldMult))
endfunction

function Wild_PowStats takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer powi = LoadInteger(Mega_HT, h, 31)
    if powi > 10 then
        set powi = 10
    endif
    call SaveReal(Mega_HT, h, 37, Wild_PowDmg[powi])
    call SaveReal(Mega_HT, h, 22, Wild_PowArm[powi])
    call SaveInteger(Mega_HT, h, 23, Wild_PowGold[powi])
    call SaveInteger(Mega_HT, h, 26, Wild_PowLv[powi])
endfunction

function Wild_Apply takes unit u returns nothing
    local integer h = GetHandleId(u)
    if LoadInteger(Mega_HT, h, 33) == 1 then
        return
    endif
    call SaveInteger(Ab_HT, h, 0, LoadInteger(Ab_HT, GetUnitTypeId(u), 0))  // v3.3: wild creeps have the Ability of their species
    if LoadInteger(Mega_HT, h, 24) == Wild_AvgLevel + 1 then
        return
    endif
    if LoadInteger(Mega_HT, h, 24) == 0 then
        call SaveInteger(Mega_HT, h, 20, BlzGetUnitMaxHP(u))
        call SaveInteger(Mega_HT, h, 21, BlzGetUnitBaseDamage(u, 0))
        call SaveReal(Mega_HT, h, 37, I2R(BlzGetUnitBaseDamage(u, 0)) + I2R(BlzGetUnitDiceNumber(u, 0) * (BlzGetUnitDiceSides(u, 0) + 1)) / 2.0)
        call SaveReal(Mega_HT, h, 22, BlzGetUnitArmor(u))
        call SaveInteger(Mega_HT, h, 23, BlzGetUnitIntegerField(u, UNIT_IF_GOLD_BOUNTY_AWARDED_BASE))
        if not HaveSavedInteger(Mega_HT, h, 26) then
            call SaveInteger(Mega_HT, h, 26, GetUnitLevel(u))
        endif
        if LoadInteger(Mega_HT, GetUnitTypeId(u), 39) > 0 and LoadInteger(Mega_HT, h, 31) > 0 then
            call Wild_PowStats(u)
        endif
    endif
    call SaveInteger(Mega_HT, h, 24, Wild_AvgLevel + 1)
    call Wild_Scale(u)
endfunction

// an elite creep of a camp: more HP, damage, armor and gold, bigger and gold-coloured
// v3.4: an elite of a species that has a Mega is a Mega elite 1 time in 4 (Mega skin, +20% HP and damage,
// 5% to drop its Mega Stone). Mega_HT: key 41 on the type = Mega index + 1, key 44 on the unit
function Wild_EliteMega takes unit u returns nothing
    local integer mi = LoadInteger(Mega_HT, GetUnitTypeId(u), 41) - 1
    local real megasc = 0.0
    if mi < 0 or mi >= Mega_N or GetRandomReal(0.0, 1.0) >= Wild_MegaChance then
        return
    endif
    call SaveInteger(Mega_HT, GetHandleId(u), 44, mi + 1)
    call BlzSetUnitSkin(u, Mega_Skin[mi])
    set megasc = Wild_EliteScale * Mega_Scale[mi] / RMaxBJ(Mega_BaseScale[mi], 0.1)
    call SetUnitScale(u, megasc, megasc, megasc)
    call SetUnitVertexColor(u, Mega_R[mi], Mega_G[mi], Mega_B[mi], 255)
    call BlzSetUnitName(u, Mega_Name[mi])
    call Wild_Scale(u)
endfunction

function Wild_MakeElite takes unit u returns nothing
    local integer k = LoadInteger(Mega_HT, GetUnitTypeId(u), 30)
    local integer j = 0
    call SaveInteger(Mega_HT, GetHandleId(u), 29, 1)
    call Wild_Scale(u)
    call SetUnitScale(u, Wild_EliteScale, Wild_EliteScale, Wild_EliteScale)
    call SetUnitVertexColor(u, 255, 215, 0, 255)
    // the elite fights with the 5 skills of its type
    if k > 0 then
        loop
            exitwhen j >= 5
            call UnitAddAbility(u, Wild_KitSkill[(k - 1) * 5 + j])
            set j = j + 1
        endloop
        call SaveInteger(Ab_HT, GetHandleId(u), 87, k)  // v3.4: Ai_Tick casts them
        set Fx_ArgU = u  // v3.4.13: a status move button in place of one kit skill
        set Fx_ArgK = k - 1
        set Fx_ArgJ = -1
        call ExecuteFunc("Fx_KitStatusX")
    endif
    call Wild_EliteMega(u)
endfunction

// shown level of a wild creep = max(its own level, average hero level); key 26 own level, 27 applied level
function Wild_ApplyLevel takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer lv = 0
    if not HaveSavedInteger(Mega_HT, h, 26) then
        call SaveInteger(Mega_HT, h, 26, GetUnitLevel(u))
    endif
    set lv = LoadInteger(Mega_HT, h, 26)
    if Wild_AvgLevel > lv then
        set lv = Wild_AvgLevel
    endif
    if LoadInteger(Mega_HT, h, 27) != lv then
        call SaveInteger(Mega_HT, h, 27, lv)
        call BlzSetUnitIntegerField(u, UNIT_IF_LEVEL, lv)
    endif
endfunction

function Wild_Scan takes nothing returns nothing
    local unit u = null
    call GroupEnumUnitsOfPlayer(Wild_Tmp, Player(PLAYER_NEUTRAL_AGGRESSIVE), null)
    loop
        set u = FirstOfGroup(Wild_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Wild_Tmp, u)
        if not IsUnitType(u, UNIT_TYPE_DEAD) and Wild_IsWildType(GetUnitTypeId(u)) and LoadInteger(Mega_HT, GetHandleId(u), 33) != 1 then
            call Wild_Apply(u)
            call Wild_ApplyLevel(u)
        endif
    endloop
endfunction

// tier = average level of the players' Pokemon / 10 (max 10)
// every 5 minutes: tier = average level of the 2 lowest players / 10 (each player = their highest hero)
function Wild_UpdateTier takes nothing returns nothing
    local integer i = 0
    local integer n = 0
    local integer best = 0
    local integer low_a = 0
    local integer low_b = 0
    local integer t = 0
    local unit u = null
    loop
        exitwhen i >= 12
        set best = 0
        call GroupEnumUnitsOfPlayer(Wild_Tmp, Player(i), null)
        loop
            set u = FirstOfGroup(Wild_Tmp)
            exitwhen u == null
            call GroupRemoveUnit(Wild_Tmp, u)
            if IsUnitType(u, UNIT_TYPE_HERO) and GetUnitTypeId(u) != 'earc' and GetHeroLevel(u) > best then
                set best = GetHeroLevel(u)
            endif
        endloop
        if best > 0 then
            set n = n + 1
            if n == 1 or best < low_a then
                set low_b = low_a
                set low_a = best
            elseif n == 2 or best < low_b then
                set low_b = best
            endif
        endif
        set i = i + 1
    endloop
    if n == 0 then
        return
    endif
    if n == 1 then
        set Wild_AvgLevel = low_a
    else
        set Wild_AvgLevel = (low_a + low_b) / 2
    endif
    set t = Wild_AvgLevel / Wild_LevelsPerTier
    if t > Wild_TierMax then
        set t = Wild_TierMax
    endif
    if t > Wild_Tier then
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10.0, "|cffff8800Wild Pokemon grew stronger! (Tier " + I2S(t) + ", average level " + I2S(Wild_AvgLevel) + ")|r")
    endif
    set Wild_Tier = t
endfunction

// pick a random pool type of the wanted power (or the closest lower power that exists)
// v3.4: the pool has ~1000 entries (211 new species, one entry per power they appear at); the old pick scanned it
// twice per camp, too much for one thread when many camps spawn. Wild_IndexPool (once, at init) indexes it by power.
function Wild_IndexPool takes nothing returns nothing
    local integer i = 0
    local integer powi = 0
    loop
        exitwhen i >= Wild_PoolN
        set powi = Wild_PoolPow[i]
        if powi >= 1 and powi <= 10 and Wild_PowCnt[powi] < Wild_PowStride then
            set Wild_PowAt[powi * Wild_PowStride + Wild_PowCnt[powi]] = i
            set Wild_PowCnt[powi] = Wild_PowCnt[powi] + 1
        endif
        set i = i + 1
    endloop
endfunction

// a random species of that power (or of the highest lower power that has one)
function Wild_PickType takes integer pow returns integer
    local integer p = pow
    if p > 10 then
        set p = 10
    endif
    loop
        exitwhen p < 1
        if Wild_PowCnt[p] > 0 then
            return Wild_Pool[Wild_PowAt[p * Wild_PowStride + GetRandomInt(0, Wild_PowCnt[p] - 1)]]
        endif
        set p = p - 1
    endloop
    return Wild_Pool[0]
endfunction


function Wild_ReinforceCamp takes integer c returns nothing
    local integer pow = Wild_CampPow[c] + Wild_Tier
    local integer base_t = LoadInteger(Mega_HT, c + 500, 3)
    local integer new_t = 0
    local integer attempts = 0
    local unit u = null
    if pow > 10 then
        set pow = 10
    endif
    set new_t = Wild_PickType(pow)
    loop
        exitwhen new_t != base_t or attempts >= 6
        set new_t = Wild_PickType(pow)
        set attempts = attempts + 1
    endloop
    if new_t == base_t and Wild_PoolN > 1 then
        set new_t = Wild_Pool[ModuloInteger(c + 3, Wild_PoolN)]
    endif
    // Spawn 2 regular creeps of the different elemental type
    set u = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), new_t, Wild_CampX[c] + GetRandomReal(-120.0, 120.0), Wild_CampY[c] + GetRandomReal(-120.0, 120.0), GetRandomReal(0.0, 360.0))
    call SaveInteger(Mega_HT, GetHandleId(u), 25, c + 1)
    call SaveInteger(Mega_HT, GetHandleId(u), 31, pow)
    call Wild_Apply(u)

    set u = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), new_t, Wild_CampX[c] + GetRandomReal(-120.0, 120.0), Wild_CampY[c] + GetRandomReal(-120.0, 120.0), GetRandomReal(0.0, 360.0))
    call SaveInteger(Mega_HT, GetHandleId(u), 25, c + 1)
    call SaveInteger(Mega_HT, GetHandleId(u), 31, pow)
    call Wild_Apply(u)

    // Spawn 1 additional ELITE creep of the different elemental type!
    set u = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), new_t, Wild_CampX[c] + GetRandomReal(-120.0, 120.0), Wild_CampY[c] + GetRandomReal(-120.0, 120.0), GetRandomReal(0.0, 360.0))
    call SaveInteger(Mega_HT, GetHandleId(u), 25, c + 1)
    call SaveInteger(Mega_HT, GetHandleId(u), 31, pow)
    call Wild_Apply(u)
    call Wild_MakeElite(u)

    set Wild_CampAlive[c] = Wild_CampAlive[c] + 3
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", Wild_CampX[c], Wild_CampY[c]))
    call PAX_Fun_PublicFloat(u, "|cffff3333REINFORCED (+ELITE)!|r", 255, 60, 60, 2.5)
    set u = null
endfunction

function Wild_SpawnCamp takes integer c returns nothing
    local integer pow = Wild_CampPow[c] + Wild_Tier
    local integer t = 0
    local integer i = 0
    local unit u = null
    local integer elite = -1
    if pow > 10 then
        set pow = 10
    endif
    set t = Wild_PickType(pow)
    set Wild_CampDue[c] = 0.0
    set Wild_CampAlive[c] = Wild_CampSize[c]
    call SaveReal(Mega_HT, c + 500, 1, Wild_Time)
    call SaveInteger(Mega_HT, c + 500, 2, 0)
    call SaveInteger(Mega_HT, c + 500, 3, t)
    call SaveInteger(Mega_HT, c + 500, 4, 1)
    if Wild_CampSize[c] > 0 then
        set elite = GetRandomInt(0, Wild_CampSize[c] - 1)
    endif
    loop
        exitwhen i >= Wild_CampSize[c]
        set u = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), t, Wild_CampX[c] + GetRandomReal(-150.0, 150.0), Wild_CampY[c] + GetRandomReal(-150.0, 150.0), GetRandomReal(0.0, 360.0))
        call SaveInteger(Mega_HT, GetHandleId(u), 25, c + 1)
        call SaveInteger(Mega_HT, GetHandleId(u), 31, pow)
        call Wild_Apply(u)
        if i == elite then
            call Wild_MakeElite(u)
        endif
        set i = i + 1
    endloop
    set u = null
endfunction

// v3.3: when the tier goes up, creeps that were not hit yet (full HP) become the species of the new tier,
// one species per camp, keeping position, camp, elite status and HP
// v3.4: what a camp becomes when the tier goes up: its own next form once that form's power is reached
// (Mega_HT on the type: 45 next form, 47 / 48 the powers it appears at), the same species while still in range,
// else a random species of the power as before
function Wild_NextForm takes integer t, integer pow returns integer
    local integer cur = t
    local integer nt = LoadInteger(Mega_HT, t, 45)
    local integer guard = 0
    loop
        exitwhen nt == 0 or LoadInteger(Mega_HT, nt, 47) > pow or guard >= 3
        set cur = nt
        set nt = LoadInteger(Mega_HT, cur, 45)
        set guard = guard + 1
    endloop
    if cur != t then
        return cur
    endif
    if LoadInteger(Mega_HT, t, 48) >= pow then
        return t
    endif
    return Wild_PickType(pow)
endfunction

function Wild_Upgrade takes nothing returns nothing
    local integer c = 0
    local unit u = null
    local unit nu = null
    local integer h = 0
    local integer pow = 0
    loop
        exitwhen c >= Wild_CampN
        set Wild_UpT[c] = 0
        set c = c + 1
    endloop
    call GroupEnumUnitsOfPlayer(Wild_Tmp, Player(PLAYER_NEUTRAL_AGGRESSIVE), null)
    loop
        set u = FirstOfGroup(Wild_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Wild_Tmp, u)
        set h = GetHandleId(u)
        set c = LoadInteger(Mega_HT, h, 25) - 1
        if c >= 0 and Wild_IsWildType(GetUnitTypeId(u)) and GetWidgetLife(u) > 0.405 and GetUnitLifePercent(u) >= 99.9 then
            set pow = Wild_CampPow[c] + Wild_Tier
            if pow > 10 then
                set pow = 10
            endif
            if LoadInteger(Mega_HT, h, 31) < pow then
                if Wild_UpT[c] == 0 then
                    set Wild_UpT[c] = Wild_NextForm(GetUnitTypeId(u), pow)
                endif
                set nu = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), Wild_UpT[c], GetUnitX(u), GetUnitY(u), GetUnitFacing(u))
                call SaveInteger(Mega_HT, GetHandleId(nu), 25, c + 1)
                call SaveInteger(Mega_HT, GetHandleId(nu), 31, pow)
                call Wild_Apply(nu)
                if LoadInteger(Mega_HT, h, 29) == 1 then
                    call Wild_MakeElite(nu)
                endif
                call FlushChildHashtable(Mega_HT, h)
                call RemoveUnit(u)
            endif
        endif
    endloop
    set u = null
    set nu = null
endfunction

// ---------------------------------------------------------------------------------------------
// Type chart (v3.4). A move deals Ty_Eff[move type * 18 + target type] for each type of the target, the product kept
// in [Ty_ImmuneMult, Ty_MaxMult]. Types of a unit type: Ab_HT keys 53, 54 = type + 1 (Ty_InitUnits).
// Type of a move: learned moves from Mv_Type (the move index is in the ability id, see Mv_Id), kit skills from
// Ab_HT key 50 on the ability id (Ty_InitKits). The last move a unit cast: Ab_HT keys 51 type + 1, 52 time,
// 55 power, 56 class (1 physical, 2 special); the same per player in Ty_P* for the dummy units of a move.
// ---------------------------------------------------------------------------------------------
function Ty_OfType takes integer uid, integer k returns integer
    return LoadInteger(Ab_HT, uid, 53 + k) - 1
endfunction

// v3.4: a Mega has the types of its Mega form (Mega Charizard X: Fire/Dragon); Zen Mode Darmanitan is Fire/Psychic
function Ty_Of takes unit u, integer k returns integer
    local integer h = GetHandleId(u)
    local integer mi = LoadInteger(Mega_HT, h, 0) - 1
    local integer formId = PAX_Form_Id(u)
    if k == 1 and LoadInteger(Ab_HT, h, 85) == 1 then
        return T_PSYCHIC
    endif
    if mi >= 0 and IsUnitType(u, UNIT_TYPE_HERO) then
        if HaveSavedInteger(Ab_HT, Mega_Stone[mi], 53) then
            return LoadInteger(Ab_HT, Mega_Stone[mi], 53 + k) - 1
        elseif HaveSavedInteger(Ab_HT, Mega_Skin[mi], 53) then
            return LoadInteger(Ab_HT, Mega_Skin[mi], 53 + k) - 1
        endif
    endif
    if (formId >= 1 and formId <= 3) or formId >= 10 then
        return PAX_Form_Type(u, k)
    endif
    if GetUnitTypeId(u) == 'E02A' and PAX_Plate_Type(u) >= 0 then
        if k == 0 then
            return PAX_Plate_Type(u)
        endif
        return -1
    endif
    return LoadInteger(Ab_HT, GetUnitTypeId(u), 53 + k) - 1
endfunction

function Ty_Has takes unit u, integer ty returns boolean
    return ty >= 0 and (Ty_Of(u, 0) == ty or Ty_Of(u, 1) == ty)
endfunction

// multiplier of a move of type mt against a unit type (gyms use it before the unit exists)
// v3.4.2: type effectiveness, k rule. a / b = the target's types (-1 = none). Per type: x2 -> k + 1,
// x0.5 or x0 -> k - 1. Result 1 + Ty_KUp * k (k >= 0) or 1 + Ty_KDown * k (k < 0): x0.5 .. x2.
function Ty_KMult takes integer mt, integer a, integer b returns real
    local integer k = 0
    local real e = 1.0
    if mt < 0 then
        return 1.0
    endif
    if a >= 0 then
        set e = Ty_Eff[mt * 18 + a]
        if e > 1.0 then
            set k = k + 1
        elseif e < 1.0 then
            set k = k - 1
        endif
    endif
    if b >= 0 and b != a then
        set e = Ty_Eff[mt * 18 + b]
        if e > 1.0 then
            set k = k + 1
        elseif e < 1.0 then
            set k = k - 1
        endif
    endif
    if k >= 0 then
        return 1.0 + Ty_KUp * I2R(k)
    endif
    return 1.0 + Ty_KDown * I2R(k)
endfunction

function Ty_TypeMult takes integer mt, integer uid returns real
    return Ty_KMult(mt, LoadInteger(Ab_HT, uid, 53) - 1, LoadInteger(Ab_HT, uid, 54) - 1)
endfunction

function Ty_Mult takes integer mt, unit t returns real
    return Ty_KMult(mt, Ty_Of(t, 0), Ty_Of(t, 1))  // v3.4.2: the target's current types (Mega)
endfunction

// true if one of the types of unit type att hits unit type def super effectively
function Ty_Counters takes integer att, integer def returns boolean
    local integer a = Ty_OfType(att, 0)
    local integer b = Ty_OfType(att, 1)
    return (a >= 0 and Ty_TypeMult(a, def) > 1.01) or (b >= 0 and Ty_TypeMult(b, def) > 1.01)
endfunction

// the type of unit type att that hits def best (for the skills a gym Pokemon gets), -1 if it has no type
function Ty_BestVs takes integer att, integer def returns integer
    local integer a = Ty_OfType(att, 0)
    local integer b = Ty_OfType(att, 1)
    if b >= 0 and (a < 0 or Ty_TypeMult(b, def) > Ty_TypeMult(a, def)) then
        return b
    endif
    return a
endfunction

function PAX_Plate_Adapt takes unit src, unit tgt returns nothing
    local integer h = 0
    local integer i = 0
    local integer best = -1
    local real bestMult = -1.0
    local real curMult = 0.0
    if src == null or tgt == null or GetUnitTypeId(src) != 'E02A' then
        return
    endif
    set h = GetHandleId(src)
    if LoadInteger(PAX_Leg_HT, h, 128) != 19 or Mega_Time < LoadReal(PAX_Leg_HT, h, 133) then
        return
    endif
    call SaveReal(PAX_Leg_HT, h, 133, Mega_Time + 1.5)
    loop
        exitwhen i >= 18
        set curMult = Ty_Mult(i, tgt)
        if curMult > bestMult then
            set bestMult = curMult
            set best = i
        endif
        set i = i + 1
    endloop
    if best >= 0 and best != LoadInteger(PAX_Leg_HT, h, 129) then
        call PAX_Plate_SetType(src, best)
    endif
endfunction

// value of a base-36 digit character code, -1 if it is not one
function Ty_Undig takes integer c returns integer
    if c >= 48 and c <= 57 then
        return c - 48
    endif
    if c >= 65 and c <= 90 then
        return c - 55
    endif
    return -1
endfunction

// learned move index from its ability id ('A' + V/W/Y/Z + 2 base-36 digits, see Mv_Id), -1 if it is not one
function Ty_MoveOf takes integer id returns integer
    local integer a = id / 16777216
    local integer b = id / 65536 - a * 256
    local integer c = id / 256 - (id / 65536) * 256
    local integer d = id - (id / 256) * 256
    local integer hi = Ty_Undig(c)
    local integer lo = Ty_Undig(d)
    if a != 65 or (b != 86 and b != 87 and b != 89 and b != 90 and b != 75) or hi < 0 or lo < 0 then  // v3.4.10: 75 = K, the hidden spell
        return -1
    endif
    if hi * 36 + lo >= Mv_N then
        return -1
    endif
    return hi * 36 + lo
endfunction

// the kit skills (Wild_KitSkill, kit k = type k - 1) carry their type on the ability id
function Ty_InitKits takes nothing returns nothing
    local integer i = 0
    loop
        exitwhen i >= 90
        if Wild_KitSkill[i] != 0 then
            call SaveInteger(Ab_HT, Wild_KitSkill[i], 50, i / 5 + 1)
        endif
        set i = i + 1
    endloop
    call SaveInteger(Ab_HT, 'AP01', 50, 6)  // v3.4.1: type of the move on pokemondb
    call SaveInteger(Ab_HT, 'AP0B', 50, 2)  // v3.4.1: type of the move on pokemondb
    call SaveInteger(Ab_HT, 'AP0C', 50, 11)  // v3.4.1: type of the move on pokemondb
    call SaveInteger(Ab_HT, 'AP0H', 50, 5)  // v3.4.1: type of the move on pokemondb
    call SaveInteger(Ab_HT, 'AP0V', 50, 15)  // v3.4.1: type of the move on pokemondb
    call SaveInteger(Ab_HT, 'AP0W', 50, 11)  // v3.4.1: type of the move on pokemondb
    call SaveInteger(Ab_HT, 'AP18', 50, 15)  // v3.4.1: type of the move on pokemondb
endfunction

// EVENT_PLAYER_UNIT_SPELL_EFFECT: remember the type of the move a unit just cast
function Ty_OnCast takes nothing returns boolean
    local unit u = GetTriggerUnit()
    local integer id = GetSpellAbilityId()
    local integer m = Ty_MoveOf(id)
    local integer ty = -1
    local integer pw = 60
    local integer ph = 2
    local integer h = GetHandleId(u)
    local integer pid = GetPlayerId(GetOwningPlayer(u))
    if m >= 0 then
        set ty = Mv_Type[m]
        set pw = Mv_Pow[m]
        set ph = Mv_Phys[m]
    else
        set ty = LoadInteger(Ab_HT, id, 50) - 1
    endif
    if ty >= 0 then
        call SaveInteger(Ab_HT, h, 51, ty + 1)
        call SaveReal(Ab_HT, h, 52, Mega_Time)
        call SaveInteger(Ab_HT, h, 55, pw)
        call SaveInteger(Ab_HT, h, 56, ph)
        if pid < 12 then
            set Ty_PType[pid] = ty + 1
            set Ty_PTime[pid] = Mega_Time
            set Ty_PPow[pid] = pw
            set Ty_PPhys[pid] = ph
        endif
    endif
    set Fx_ArgU = u  // v3.4.11: move effects, Pressure, cooldowns
    set Fx_ArgI = m
    set Fx_ArgJ = id
    set Fx_ArgV = GetSpellTargetUnit()
    call ExecuteFunc("Fx_OnCastX")
    set u = null
    return false
endfunction

// type of the move behind a skill's damage: the source's own last cast, else its owner's (dummy units of a move);
// -1 when nothing was cast within Ty_Window. Also sets Ty_CurPow / Ty_CurPhys.
function Ty_Resolve takes unit src returns integer
    local integer h = GetHandleId(src)
    local integer pid = GetPlayerId(GetOwningPlayer(src))
    set Ty_CurPow = 60
    set Ty_CurPhys = 2
    if LoadInteger(Ab_HT, h, 51) > 0 and Mega_Time - LoadReal(Ab_HT, h, 52) <= Ty_Window then
        set Ty_CurPow = LoadInteger(Ab_HT, h, 55)
        set Ty_CurPhys = LoadInteger(Ab_HT, h, 56)
        return LoadInteger(Ab_HT, h, 51) - 1
    endif
    if pid < 12 and Ty_PType[pid] > 0 and Mega_Time - Ty_PTime[pid] <= Ty_Window then
        set Ty_CurPow = Ty_PPow[pid]
        set Ty_CurPhys = Ty_PPhys[pid]
        return Ty_PType[pid] - 1
    endif
    return -1
endfunction

// floating text over unit t, seen by players plA and plB (shares the Dmg_Tags cap with the damage numbers)
function Ab_Say takes unit t, string s, integer r, integer g, integer b, player plA, player plB returns nothing
    local texttag tt = null
    if Dmg_Tags >= Dmg_TagMax or t == null then
        return
    endif
    set Dmg_Tags = Dmg_Tags + 1
    set tt = CreateTextTag()
    call SetTextTagText(tt, s, 0.022)
    call SetTextTagPos(tt, GetUnitX(t) - 60.0, GetUnitY(t), 150.0)
    call SetTextTagColor(tt, r, g, b, 255)
    call SetTextTagVelocity(tt, 0.0, 0.03)
    call SetTextTagPermanent(tt, false)
    call SetTextTagLifespan(tt, 1.5)
    call SetTextTagFadepoint(tt, 0.9)
    call SetTextTagVisibility(tt, GetLocalPlayer() == plA or GetLocalPlayer() == plB)
    set tt = null
endfunction

// a one-shot special effect on a unit
function Ab_Pop takes unit u, string model, string attach returns nothing
    if u != null then
        call DestroyEffect(AddSpecialEffectTarget(model, u, attach))
    endif
endfunction

// v3.4: a non-hero unit that dies forgets its Ability data: WC3 gives its handle id to a later unit (a dummy of a
// move would otherwise inherit the dead creep's Ability). Registered last, after every other death trigger.
function Ty_OnDeath takes nothing returns boolean
    local unit u = GetTriggerUnit()
    if not IsUnitType(u, UNIT_TYPE_HERO) then
        call FlushChildHashtable(Ab_HT, GetHandleId(u))
    endif
    set u = null
    return false
endfunction

// ---------------------------------------------------------------------------------------------
// v3.4: wild elites, gym Pokemon and legends cast their 5 kit skills. The kit skills are hero skills of the game
// (Shadow Strike, Frost Nova, Shockwave ...) and the creep AI never casts those, so these units kept full mana.
// Ab_HT on the unit: 86 its target (the unit it last hit or that last hit it, Ab_OnDamaging), 87 kit + 1.
// Ab_HT on a skill: 58 its order string (Ty_InitData).
// ---------------------------------------------------------------------------------------------
function Ai_TryCast takes unit u, unit t, integer abil returns boolean
    local string orderstr = LoadStr(Ab_HT, abil, 58)
    if abil == 0 or orderstr == null or orderstr == "" or GetUnitAbilityLevel(u, abil) <= 0 or Fx_Silenced(u) then
        return false
    endif
    if BlzGetUnitAbilityCooldownRemaining(u, abil) > 0.0 then
        return false
    endif
    if ModuloInteger(LoadInteger(Fx_HT, abil, 1), 2) == 1 and t != null and GetWidgetLife(t) > 0.35 * I2R(BlzGetUnitMaxHP(t)) then
        return false  // v3.4.12: the AI keeps recharge moves to finish a target
    endif
    // unit target, else point target, else no target (Swords Dance, Future Sight ...)
    if IssueTargetOrder(u, orderstr, t) then
        return true
    endif
    if IssuePointOrder(u, orderstr, GetUnitX(t), GetUnitY(t)) then
        return true
    endif
    return IssueImmediateOrder(u, orderstr)
endfunction

// v3.4.2: the skill-cast chance of one unit (Ab_HT key 88, set for gym Pokemon), else the global chance
function Ai_Chance takes integer h returns real
    if HaveSavedReal(Ab_HT, h, 88) then
        return LoadReal(Ab_HT, h, 88)
    endif
    return Ai_CastChance
endfunction

function Ai_Unit takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer kit = LoadInteger(Ab_HT, h, 87)
    local unit t = LoadUnitHandle(Ab_HT, h, 86)
    local integer pick0 = 0
    local integer j = 0
    local group g = CreateGroup()
    local unit cand = null
    local unit weak = null
    local real min_hp = 100.0
    local real hp = 0.0
    // Smart AI Tier 1: Scan 600 range for low-HP heroes (< 30% HP) to focus down
    call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 600.0, null)
    loop
        set cand = FirstOfGroup(g)
        exitwhen cand == null
        call GroupRemoveUnit(g, cand)
        if IsUnitEnemy(cand, GetOwningPlayer(u)) and not IsUnitType(cand, UNIT_TYPE_DEAD) and IsUnitType(cand, UNIT_TYPE_HERO) then
            set hp = GetUnitLifePercent(cand)
            if hp < 30.0 and hp < min_hp then
                set min_hp = hp
                set weak = cand
            endif
        endif
    endloop
    call DestroyGroup(g)
    set g = null
    if weak != null then
        set t = weak
        call SaveUnitHandle(Ab_HT, h, 86, t)
        call SaveReal(Ab_HT, h, 60, Mega_Time)
        call IssueTargetOrder(u, "attack", t)
    endif
    if kit > 0 and t != null and GetWidgetLife(t) > 0.405 and Mega_Time - LoadReal(Ab_HT, h, 60) <= Ai_Memory then
        if not IsUnitType(u, UNIT_TYPE_STUNNED) and GetRandomReal(0.0, 1.0) < Ai_Chance(h) then  // v4.3 (3.4.2)
            set pick0 = GetRandomInt(0, 4)
            loop
                exitwhen j >= 5
                if Ai_TryCast(u, t, Wild_KitSkill[(kit - 1) * 5 + ModuloInteger(pick0 + j, 5)]) then
                    set j = 5
                endif
                set j = j + 1
            endloop
        endif
    endif
    set t = null
endfunction

function Ai_Tick takes nothing returns nothing
    local unit u = null
    call GroupEnumUnitsOfPlayer(Ai_G, Player(PLAYER_NEUTRAL_AGGRESSIVE), null)
    loop
        set u = FirstOfGroup(Ai_G)
        exitwhen u == null
        call GroupRemoveUnit(Ai_G, u)
        if GetWidgetLife(u) > 0.405 and LoadInteger(Ab_HT, GetHandleId(u), 87) > 0 then
            call Ai_Unit(u)
        endif
    endloop
endfunction

// a legend gets the 5 skills of its first type (it had only War Stomp / Bash, never cast)
function Ai_GiveKit takes unit u returns nothing
    local integer kit = Ty_Of(u, 0) + 1
    local integer j = 0
    if kit <= 0 then
        return
    endif
    loop
        exitwhen j >= 5
        if Wild_KitSkill[(kit - 1) * 5 + j] != 0 then
            call UnitAddAbility(u, Wild_KitSkill[(kit - 1) * 5 + j])
        endif
        set j = j + 1
    endloop
    call SaveInteger(Ab_HT, GetHandleId(u), 87, kit)
    set Fx_ArgU = u  // v3.4.13: a status move button in place of one kit skill
    set Fx_ArgK = kit - 1
    set Fx_ArgJ = -1
    call ExecuteFunc("Fx_KitStatusX")
endfunction
// ---------------------------------------------------------------------------------------------
// v3.4 extras (docs/v3.5-items-league-features-proposal.md): battle items, weather, Shiny, legend Mega.
// Ab_HT on a hero: 120..122 Str/Agi/Int bonus applied (Shiny 10%, Champion 15%), 123 Shiny, 124 Shiny decided,
// 125 legend Mega, 126 Focus Sash ready time, 127 last XP (Lucky Egg), 128 Champion Aura until, 129 aura effect,
// 140 + k holds item k (Itm_Id[k]; Itm_Refresh every second and on pickup). Mega_HT on an item type: 91 = k + 1.
// ---------------------------------------------------------------------------------------------
function Itm_Flag takes unit u, integer k returns boolean
    return LoadInteger(Ab_HT, GetHandleId(u), 140 + k) == 1
endfunction

function Itm_Refresh takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer k = 0
    local integer s = 0
    local item it = null
    loop
        exitwhen k >= Itm_N
        call SaveInteger(Ab_HT, h, 140 + k, 0)
        set k = k + 1
    endloop
    loop
        exitwhen s >= 6
        set it = UnitItemInSlot(u, s)
        if it != null then
            set k = LoadInteger(Mega_HT, GetItemTypeId(it), 91) - 1
            if k >= 0 then
                call SaveInteger(Ab_HT, h, 140 + k, 1)
            endif
        endif
        set s = s + 1
    endloop
    set it = null
endfunction

// removes one item of type id from u (berries)
function Itm_Use takes unit u, integer id returns nothing
    local integer s = 0
    loop
        exitwhen s >= 6
        if GetItemTypeId(UnitItemInSlot(u, s)) == id then
            call RemoveItem(UnitItemInSlot(u, s))
            call SaveInteger(Ab_HT, GetHandleId(u), 140 + LoadInteger(Mega_HT, id, 91) - 1, 0)
            return
        endif
        set s = s + 1
    endloop
endfunction

// ---- Shiny: 1/100 when a Pokemon is picked, bought, randomed or made by a Soul (1/20 for a Champion);
// evolutions and Mega keep it (Mega_SafeReplace copies keys 123 / 124)
function Shiny_Tint takes unit u returns nothing
    local integer id = GetUnitTypeId(u)
    call SetUnitVertexColor(u, 110 + ModuloInteger(id, 146), 110 + ModuloInteger(id / 7, 146), 110 + ModuloInteger(id / 13, 146), 255)
endfunction

function Shiny_Decide takes unit u returns nothing
    local integer h = GetHandleId(u)
    local player p = GetOwningPlayer(u)
    local integer chance = Shiny_Chance
    if HaveSavedInteger(Ab_HT, h, 124) then
        if LoadInteger(Ab_HT, h, 123) == 1 then
            call Shiny_Tint(u)
        endif
        set p = null
        return
    endif
    call SaveInteger(Ab_HT, h, 124, 1)
    if GetPlayerId(p) < 12 and League_Champ[GetPlayerId(p)] then
        set chance = Shiny_ChanceChamp
    endif
    if GetPlayerId(p) < 12 and GetRandomInt(1, chance) == 1 then
        call SaveInteger(Ab_HT, h, 123, 1)
        call Shiny_Tint(u)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl", u, "origin"))
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10.0, "|cffffff00* " + GetPlayerName(p) + " got a SHINY " + GetHeroProperName(u) + "! (+10% STR / AGI / INT) *|r")
    endif
    set p = null
endfunction

// ---- weather, every 5 minutes: 0 clear, 1 rain, 2 sun, 3 sandstorm, 4 hail
function Wth_Set takes integer w returns nothing
    local string s = "|cffaaddffThe weather clears up.|r"
    if Wth_Fx != null then
        call RemoveWeatherEffect(Wth_Fx)
        set Wth_Fx = null
    endif
    set Wth_Cur = w
    if w == 1 then
        set Wth_Fx = AddWeatherEffect(bj_mapInitialPlayableArea, 'RAhr')
        set s = "|cff66aaffIt started to rain!|r Water moves +30%, Fire moves -30%, Swift Swim is faster."
    elseif w == 2 then
        set Wth_Fx = AddWeatherEffect(bj_mapInitialPlayableArea, 'LRaa')
        set s = "|cffffcc33The sunlight turned harsh!|r Fire moves +30%, Water moves -30%, Chlorophyll is faster."
    elseif w == 3 then
        set Wth_Fx = AddWeatherEffect(bj_mapInitialPlayableArea, 'WOcw')
        set s = "|cffd2b48cA sandstorm kicked up!|r Pokemon that are not Rock / Ground / Steel lose HP; Sand Veil dodges more."
    elseif w == 4 then
        set Wth_Fx = AddWeatherEffect(bj_mapInitialPlayableArea, 'SNbs')
        set s = "|cffccffffIt started to hail!|r Pokemon that are not Ice lose HP; Snow Cloak dodges more."
    endif
    if Wth_Fx != null then
        call EnableWeatherEffect(Wth_Fx, true)
    endif
    if w == 1 then  // v3.4.16 colored fog
        call SetTerrainFogEx(0, 900.0, 5000.0, 0.5, 0.25, 0.35, 0.55)
    elseif w == 2 then
        call SetTerrainFogEx(0, 1200.0, 6000.0, 0.5, 1.0, 0.75, 0.35)
    elseif w == 3 then
        call SetTerrainFogEx(0, 500.0, 3500.0, 0.5, 0.75, 0.6, 0.35)
    elseif w == 4 then
        call SetTerrainFogEx(0, 700.0, 4000.0, 0.5, 0.85, 0.9, 1.0)
    else
        call ResetTerrainFog()
    endif
    call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10.0, s)
endfunction

function Wth_Thunder takes nothing returns nothing
    local unit u = null
    local integer k = GetRandomInt(0, 11)
    if Wth_Cur != 1 then
        return
    endif
    call GroupEnumUnitsOfPlayer(Fx_TmpG, Player(k), null)
    loop
        set u = FirstOfGroup(Fx_TmpG)
        exitwhen u == null
        call GroupRemoveUnit(Fx_TmpG, u)
        if IsUnitType(u, UNIT_TYPE_HERO) and GetWidgetLife(u) > 0.405 then
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl", GetUnitX(u) + GetRandomReal(-700.0, 700.0), GetUnitY(u) + GetRandomReal(-700.0, 700.0)))
        endif
    endloop
    set u = null
endfunction

function Wth_Tick takes nothing returns nothing
    local integer w = GetRandomInt(0, 4)
    if w == Wth_Cur then
        set w = ModuloInteger(w + 1, 5)
    endif
    call Wth_Set(w)
endfunction

// ---- damage dealt / taken from weather, held items, Champion Aura and legend Mega (Ab_OnDamaging)
function Ext_DamageMult takes unit src, unit t, boolean atk, boolean skill, integer mt, real eff returns real
    local integer hs = GetHandleId(src)
    local integer ht = GetHandleId(t)
    local real m = 1.0
    if Mega_Time >= LoadReal(Fx_HT, hs, 104) and Mega_Time >= LoadReal(Fx_HT, ht, 104) then
        if skill and mt == T_WATER then
            if Wth_Cur == 1 then
                set m = m * 1.3
            elseif Wth_Cur == 2 then
                set m = m * 0.7
            endif
        elseif skill and mt == T_FIRE then
            if Wth_Cur == 2 then
                set m = m * 1.3
            elseif Wth_Cur == 1 then
                set m = m * 0.7
            endif
        endif
    endif
    if IsUnitType(src, UNIT_TYPE_HERO) then
        if (atk or skill) and Itm_Flag(src, 0) then
            set m = m * 1.3
        endif
        if (atk or (skill and Fx_CurPhys(src) == 1)) and Itm_Flag(src, 1) then  // v3.4.11
            set m = m * 1.35
        endif
        if skill and Fx_CurPhys(src) == 2 and Itm_Flag(src, 2) then  // v3.4.11
            set m = m * 1.35
        endif
        if eff > 1.01 and Itm_Flag(src, 6) then  // v3.4.2: any super effective hit
            set m = m * 1.25
        endif
        if atk and Itm_Flag(src, 9) and GetRandomReal(0.0, 1.0) < 0.15 then
            set m = m * 1.5
            call Ab_Say(t, "Crit!", 255, 60, 60, GetOwningPlayer(src), GetOwningPlayer(t))
        endif
    endif
    if IsUnitType(t, UNIT_TYPE_HERO) then
        if skill and Fx_CurPhys(src) == 2 and Itm_Flag(t, 8) then  // v3.4.11
            set m = m * 0.75
        endif
        if Itm_Flag(t, 11) and LoadInteger(Ab_HT, GetUnitTypeId(t), 699) > 0 then
            set m = m * 0.8
        endif
    endif
    if Mega_Time < LoadReal(Ab_HT, hs, 128) then
        set m = m * 1.1
    endif
    if Mega_Time < LoadReal(Ab_HT, ht, 128) then
        set m = m * 0.9
    endif
    if LoadInteger(Ab_HT, hs, 125) == 1 then
        set m = m * 1.3
    endif
    return m
endfunction

// ---- Mewtwo and Rayquaza (the legends at fixed places) Mega Evolve once at 50% HP: heal 20%, +30% damage
function Leg_TryMega takes unit t, real d returns nothing
    local integer id = GetUnitTypeId(t)
    local integer mi = -1
    local real mx = I2R(BlzGetUnitMaxHP(t))
    if LoadInteger(Ab_HT, GetHandleId(t), 125) == 1 or GetWidgetLife(t) - d > 0.5 * mx then
        return
    endif
    if id == Leg_MewtwoId then
        set mi = Leg_MegaMewtwo + GetRandomInt(0, 1)
    elseif id == Leg_RayquazaId then
        set mi = Leg_MegaRayquaza
    endif
    if mi < 0 or mi >= Mega_N then
        return
    endif
    call SaveInteger(Ab_HT, GetHandleId(t), 125, 1)
    call BlzSetUnitSkin(t, Mega_Skin[mi])
    call SetUnitScale(t, BlzGetUnitRealField(t, UNIT_RF_SCALING_VALUE) * 1.25, BlzGetUnitRealField(t, UNIT_RF_SCALING_VALUE) * 1.25, BlzGetUnitRealField(t, UNIT_RF_SCALING_VALUE) * 1.25)
    call SetUnitVertexColor(t, Mega_R[mi], Mega_G[mi], Mega_B[mi], 255)
    if Mega_Fx[mi] != "" then
        call AddSpecialEffectTarget(Mega_Fx[mi], t, "origin")
    endif
    call BlzSetUnitName(t, Mega_Name[mi])
    call SetWidgetLife(t, GetWidgetLife(t) + 0.2 * mx)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", t, "origin"))
    call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffff66ccThe wild legend Mega Evolved into " + Mega_Name[mi] + "!|r")
endfunction
// ---------------------------------------------------------------------------------------------
// Gym teams of 6 (v3.3), levels follow the challenger
// ---------------------------------------------------------------------------------------------
// v3.4: Pokemon 1..5 are 5, 4, 3, 2, 1 levels below the challenger, Pokemon 6 equals it
// (v3.3 had 30, 25, 20, 15, 10 below: a level 30 challenger met level 1 and level 5 Pokemon)
// ======== [END FILE: 04_sys_hero_mega_wild_ty.j] ========
// ======== [BEGIN FILE: 05_sys_gym_league_evo.j] ========
function Gym_Level takes integer base, integer k returns integer
    local integer lv = base
    if k < 5 then
        set lv = base - (5 - k)
    endif
    if lv > 100 then
        set lv = 100
    endif
    if lv < 1 then
        set lv = 1
    endif
    return lv
endfunction

function Gym_Busy takes integer pid returns boolean
    local integer g = 0
    if League_Pid == pid then  // v3.4: the Elite Four counts as a gym battle
        return true
    endif
    loop
        exitwhen g >= 8
        if Gym_Pid[g] == pid then
            return true
        endif
        set g = g + 1
    endloop
    return false
endfunction

// v3.4: the form of evolution line `root` at level lv: follow the evolutions whose level is reached (Ab_HT of the
// unit type: 299 = number, 300 + 2k = evolved type, 301 + 2k = level), a random branch when there are several (Eevee)
function Gym_FormAt takes integer root, integer lv returns integer
    local integer cur = root
    local integer k = 0
    local integer n = 0
    local integer cnt = 0
    local integer pick = 0
    local integer nxt = 0
    local integer guard = 0
    loop
        exitwhen guard >= 4
        set cnt = LoadInteger(Ab_HT, cur, 699)
        set n = 0
        set k = 0
        loop
            exitwhen k >= cnt
            if lv >= LoadInteger(Ab_HT, cur, 701 + 2 * k) then
                set n = n + 1
            endif
            set k = k + 1
        endloop
        exitwhen n == 0
        set pick = GetRandomInt(1, n)
        set nxt = 0
        set k = 0
        loop
            exitwhen k >= cnt or nxt != 0
            if lv >= LoadInteger(Ab_HT, cur, 701 + 2 * k) then
                set pick = pick - 1
                if pick == 0 then
                    set nxt = LoadInteger(Ab_HT, cur, 700 + 2 * k)
                endif
            endif
            set k = k + 1
        endloop
        exitwhen nxt == 0
        set cur = nxt
        set guard = guard + 1
    endloop
    return cur
endfunction

// v3.4: the 6 Pokemon of a challenge, chosen when it starts: 6 different evolution lines (first forms of Gym_Pool),
// each in the form of its level (lv 35 Charmeleon, lv 36 Charizard). The 6th one must have a type that hits the
// challenger super effectively, and it gets the skills of that type.
function Gym_BuildTeam takes integer g, unit hero returns nothing
    local integer k = 0
    local integer j = 0
    local integer tries = 0
    local integer root = 0
    local integer form = 0
    local integer lv = 0
    local integer def = GetUnitTypeId(hero)
    local boolean ok = false
    loop
        exitwhen k >= 6
        set lv = Gym_Level(Gym_Base[g], k)
        set tries = 0
        loop
            if Gym_PoolN > 0 then
                set root = Gym_Pool[GetRandomInt(0, Gym_PoolN - 1)]
                set form = Gym_FormAt(root, lv)
            else
                set root = Wild_PickType(lv / 10 + 1)
                set form = root
            endif
            set ok = true
            set j = 0
            loop
                exitwhen j >= k
                if Gym_Root[g * 6 + j] == root then
                    set ok = false
                endif
                set j = j + 1
            endloop
            if ok and k == 5 and tries < 100 then
                set ok = Ty_Counters(form, def)
            endif
            set tries = tries + 1
            exitwhen ok or tries >= 150
        endloop
        set Gym_Root[g * 6 + k] = root
        set Gym_Team[g * 6 + k] = form
        if k == 5 then
            set Gym_TeamKit[g * 6 + k] = Ty_BestVs(form, def)
        else
            set Gym_TeamKit[g * 6 + k] = Ty_OfType(form, 0)
        endif
        set k = k + 1
    endloop
endfunction

// v3.4.2 gym difficulty, per gym (0..7 = gyms 1..8, 8 = the League): gyms 1-4 are easier, the later ones and the
// League are as before. Functions instead of arrays so no init code is needed.
function Gym_DiffHP takes integer g returns real
    if g == 0 then
        return 0.35
    elseif g == 1 then
        return 0.45
    elseif g == 2 then
        return 0.7
    elseif g == 3 then
        return 0.85
    endif
    return 1.0
endfunction
function Gym_DiffDmg takes integer g returns real
    if g == 0 then
        return 0.45
    elseif g == 1 then
        return 0.55
    elseif g == 2 then
        return 0.75
    elseif g == 3 then
        return 0.85
    endif
    return 1.0
endfunction
function Gym_DiffAI takes integer g returns real
    if g == 0 or g == 1 then
        return 0.25
    elseif g == 2 or g == 3 then
        return 0.45
    endif
    return 0.6
endfunction
function Gym_Fast takes integer g returns boolean
    return g >= 4
endfunction

function Gym_Spawn takes integer g, integer k returns nothing
    local integer lv = Gym_Level(Gym_Base[g], k)
    local real m = 1.0 + 0.1 * I2R(g)
    local integer id = Gym_Team[g * 6 + k]
    local integer kt = Gym_TeamKit[g * 6 + k]
    local integer ty = Ty_OfType(id, 0)
    local unit u = null
    local integer h = 0
    local integer i = 0
    local integer ti = 0
    local string nm = ""
    set u = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), id, Gym_X[g] + 110.0 * I2R(k - 2), Gym_Y[g], 270.0)
    if u == null and Gym_Root[g * 6 + k] != 0 then  // v3.4.3: never leave the gym without a Pokemon
        set id = Gym_Root[g * 6 + k]
        set Gym_Team[g * 6 + k] = id
        set u = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), id, Gym_X[g] + 110.0 * I2R(k - 2), Gym_Y[g], 270.0)
    endif
    set h = GetHandleId(u)
    call SaveInteger(Mega_HT, h, 33, 1)
    if IsUnitType(u, UNIT_TYPE_HERO) then
        call SetHeroLevel(u, lv, false)
        call SuspendHeroXP(u, true)
        set nm = GetHeroProperName(u)
    else
        call BlzSetUnitIntegerField(u, UNIT_IF_LEVEL, lv)
        set nm = GetUnitName(u)
    endif
    call BlzSetUnitMaxHP(u, R2I(I2R(150 + 160 * lv) * m * Gym_HPMult * Gym_DiffHP(g)))  // v4.3 (3.4.2)
    call SetUnitLifePercentBJ(u, 100.0)
    call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA))
    call BlzSetUnitBaseDamage(u, R2I(I2R(6 * lv) * m * 0.8 * Gym_DiffDmg(g)), 0)
    call BlzSetUnitDiceNumber(u, 1, 0)
    call BlzSetUnitDiceSides(u, 4, 0)
    call BlzSetUnitArmor(u, I2R(lv) / 4.0 * m * Gym_DiffDmg(g))
    if Gym_Fast(g) then  // v4.3 (3.4.2): gyms 1-4 do not get the faster attack
        call BlzSetUnitAttackCooldown(u, BlzGetUnitAttackCooldown(u, 0) / Gym_ASBoost, 0)
    endif
    call SaveInteger(Ab_HT, h, 0, LoadInteger(Ab_HT, id, 0))  // the Ability of its species
    call SaveReal(Ab_HT, h, 88, Gym_DiffAI(g))  // v4.3 (3.4.2): skill-cast chance of Ai_Tick
    if kt >= 0 then  // the 5 kit skills of its type (the 6th Pokemon: the type that counters the challenger)
        loop
            exitwhen i >= 5
            if Wild_KitSkill[kt * 5 + i] != 0 then
                call UnitAddAbility(u, Wild_KitSkill[kt * 5 + i])
            endif
            set i = i + 1
        endloop
        call SaveInteger(Ab_HT, h, 87, kt + 1)  // Ai_Tick casts these skills (the creep AI never does)
        set Fx_ArgU = u  // v3.4.13: a status move button in place of one kit skill
        set Fx_ArgK = kt
        set Fx_ArgJ = g
        call ExecuteFunc("Fx_KitStatusX")
    endif
    if ty >= 0 then  // it holds the item of its first type (gym Pokemon drop nothing but the badge)
        set i = 0
        loop
            exitwhen i >= Type_N
            if Type_Word[i] == Ty_Name[ty] then
                set ti = Type_Item[i]
            endif
            set i = i + 1
        endloop
    endif
    set Fx_ArgU = u  // v3.4.11: the type item's abilities, no real item (nothing to drop)
    set Fx_ArgI = ty
    set Fx_ArgJ = g
    call ExecuteFunc("Fx_GymItemX")
    set Gym_Cur[g] = u
    if g == 8 then
        call DisplayTimedTextToPlayer(Player(Gym_Pid[g]), 0, 0, 6.0, "|cffff8800" + League_Name[League_Stage] + ": " + nm + " (Pokemon " + I2S(k + 1) + " of 6, Lv " + I2S(lv) + ")|r")
    else
        call DisplayTimedTextToPlayer(Player(Gym_Pid[g]), 0, 0, 6.0, "|cffff8800Gym " + I2S(g + 1) + ": " + nm + " (Pokemon " + I2S(k + 1) + " of 6, Lv " + I2S(lv) + ")|r")
    endif
    if k == 5 and kt >= 0 and g < 8 then
        call DisplayTimedTextToPlayer(Player(Gym_Pid[g]), 0, 0, 6.0, "|cffff4040The last Pokemon uses " + Ty_Name[kt] + " moves: strong against your Pokemon!|r")
    endif
    set u = null
endfunction

// v3.4: no gym cool-down for anybody any more (Gym_PCool keeps the 5s of the player who just cleared it)
function Gym_Reset takes integer g returns nothing
    if Gym_Cur[g] != null then
        call RemoveUnit(Gym_Cur[g])
    endif
    set Gym_Cur[g] = null
    set Gym_Hero[g] = null
    set Gym_Pid[g] = -1
    set Gym_Stage[g] = 0
endfunction

// v3.4.5: home gates in the Darkrai / Celebi rooms (Haunt Legendary shop), like the v1.8 boss-room gates:
// a player's hero that steps on it goes to the town (rect Hi). The gate doodads are in war3map.doo.
function HomeGate_OnEnter takes nothing returns boolean
    local unit u = GetTriggerUnit()
    if IsUnitType(u, UNIT_TYPE_HERO) and GetPlayerId(GetOwningPlayer(u)) < 12 then
        call SetUnitPosition(u, GetRectCenterX(Hi), GetRectCenterY(Hi))
        call PanCameraToTimedForPlayer(GetOwningPlayer(u), GetUnitX(u), GetUnitY(u), 0.25)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl", u, "chest"))
    endif
    set u = null
    return false
endfunction

function HomeGate_Init takes nothing returns nothing
    local trigger t = CreateTrigger()
    call TriggerRegisterEnterRectSimple(t, Rect(-10112.0, -1920.0, -9984.0, -1792.0))  // Darkrai room
    call TriggerRegisterEnterRectSimple(t, Rect(10048.0, -2304.0, 10176.0, -2176.0))  // Celebi room
    call TriggerAddCondition(t, Condition(function HomeGate_OnEnter))
    set t = null
endfunction

// v3.4.5: Revive / Max Revive (Reincarnation, 1 s) leave the challenger at 0 HP for a moment: the battle is lost
// only after Gym_ReviveGrace seconds dead. g = 0..7 gyms, 8 = Elite Four.
function Gym_Down takes integer g, unit u returns boolean
    if GetWidgetLife(u) > 0.405 then
        set Gym_DownSince[g] = 0.0
        return false
    endif
    if Gym_DownSince[g] <= 0.0 then
        set Gym_DownSince[g] = Mega_Time + 0.001
        return false
    endif
    return Mega_Time - Gym_DownSince[g] >= Gym_ReviveGrace
endfunction

function Gym_Tick takes nothing returns nothing
    local integer g = 0
    local integer k = 0
    local integer pid = 0
    local unit u = null
    local real dx = 0.0
    local real dy = 0.0
    local boolean started = false
    loop
        exitwhen g >= 8
        set k = 0
        loop  // dead gym Pokemon are heroes (they do not decay): remove them
            exitwhen k >= 6
            if Gym_Dead[g * 6 + k] != null and GetWidgetLife(Gym_Dead[g * 6 + k]) <= 0.405 then
                call RemoveUnit(Gym_Dead[g * 6 + k])
                set Gym_Dead[g * 6 + k] = null
            endif
            set k = k + 1
        endloop
        if Gym_Pid[g] >= 0 then
            if Gym_Hero[g] == null or GetUnitTypeId(Gym_Hero[g]) == 0 or Gym_Down(g, Gym_Hero[g]) then  // v3.4.5: Revive
                call DisplayTimedTextToPlayer(Player(Gym_Pid[g]), 0, 0, 6.0, "|cffff4040Gym " + I2S(g + 1) + ": you lost. The gym starts over.|r")
                call Gym_Reset(g)
            elseif Gym_Stage[g] < 6 and (Gym_Cur[g] == null or GetUnitTypeId(Gym_Cur[g]) == 0) then
                set Gym_Cur[g] = null  // v3.4.3: the gym Pokemon was removed / replaced: bring it back (v4.3: own thread)
                set Gym_ArgG = g
                set Gym_ArgK = Gym_Stage[g]
                call ExecuteFunc("Gym_SpawnIt")
            elseif GetWidgetLife(Gym_Cur[g]) <= 0.405 then
                // v4.3 (3.4.2): it died but the death trigger did not move the gym on
                set Gym_ArgG = g
                call ExecuteFunc("Gym_AdvanceIt")
            else
                set dx = GetUnitX(Gym_Hero[g]) - Gym_X[g]
                set dy = GetUnitY(Gym_Hero[g]) - Gym_Y[g]
                if SquareRoot(dx * dx + dy * dy) > Gym_Leave then
                    call DisplayTimedTextToPlayer(Player(Gym_Pid[g]), 0, 0, 6.0, "|cffff4040Gym " + I2S(g + 1) + ": you left. The gym starts over.|r")
                    call Gym_Reset(g)
                else
                    set dx = GetUnitX(Gym_Cur[g]) - Gym_X[g]
                    set dy = GetUnitY(Gym_Cur[g]) - Gym_Y[g]
                    if SquareRoot(dx * dx + dy * dy) > Gym_Leave then  // v4.3 (3.4.2): it wandered off: back to the gym
                        call SetUnitPosition(Gym_Cur[g], Gym_X[g], Gym_Y[g])
                    endif
                endif
            endif
            if Gym_Pid[g] >= 0 then  // v4.3 (3.4.1): tell the other players near the gym that it is busy
                call GroupEnumUnitsInRange(Wild_Tmp, Gym_X[g], Gym_Y[g], Gym_Start, null)
                loop
                    set u = FirstOfGroup(Wild_Tmp)
                    exitwhen u == null
                    call GroupRemoveUnit(Wild_Tmp, u)
                    set pid = GetPlayerId(GetOwningPlayer(u))
                    if pid < 12 and pid != Gym_Pid[g] and IsUnitType(u, UNIT_TYPE_HERO) and Mega_Time >= Gym_Warn[pid] then
                        set Gym_Warn[pid] = Mega_Time + 5.0
                        call DisplayTimedTextToPlayer(Player(pid), 0, 0, 5.0, "|cffffcc00Gym " + I2S(g + 1) + " is busy: " + GetPlayerName(Player(Gym_Pid[g])) + " is challenging it (Pokemon " + I2S(Gym_Stage[g] + 1) + " of 6). Wait for your turn or try another gym.|r")
                    endif
                endloop
            endif
        else
            set started = false
            call GroupEnumUnitsInRange(Wild_Tmp, Gym_X[g], Gym_Y[g], Gym_Start, null)
            loop
                set u = FirstOfGroup(Wild_Tmp)
                exitwhen u == null
                call GroupRemoveUnit(Wild_Tmp, u)
                set pid = GetPlayerId(GetOwningPlayer(u))
                if not started and pid < 12 and IsUnitType(u, UNIT_TYPE_HERO) and GetWidgetLife(u) > 0.405 and GetUnitTypeId(u) != 'earc' and not Gym_Busy(pid) then
                    if not Gym_Allowed(pid, g) then
                        if Mega_Time >= Gym_Warn[pid] then
                            set Gym_Warn[pid] = Mega_Time + 10.0
                            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, "|cffff4040Gym " + I2S(g + 1) + " is locked: clear Gym " + I2S(g) + " first.|r")
                        endif
                    elseif GetHeroLevel(u) < Gym_MinLevel(g) then  // v4.3.3
                        if Mega_Time >= Gym_Warn[pid] then
                            set Gym_Warn[pid] = Mega_Time + 10.0
                            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, "|cffff4040Gym " + I2S(g + 1) + " needs level " + I2S(Gym_MinLevel(g)) + " (yours: " + I2S(GetHeroLevel(u)) + ").|r")
                        endif
                    elseif Mega_Time < Gym_PCool[pid * 8 + g] then
                        if Mega_Time >= Gym_Warn[pid] then
                            set Gym_Warn[pid] = Mega_Time + 2.0
                            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 3.0, "|cffffcc00Gym " + I2S(g + 1) + ": ready again in " + I2S(R2I(Gym_PCool[pid * 8 + g] - Mega_Time + 0.99)) + "s.|r")
                        endif
                    else
                        set started = true
                        set Gym_Pid[g] = pid
                        set Gym_Hero[g] = u
                        set Gym_Base[g] = GetHeroLevel(u)
                        set Gym_Stage[g] = 0
                        set Gym_DownSince[g] = 0.0
                        // v3.4: the challenger starts with full HP and mana
                        call SetWidgetLife(u, I2R(BlzGetUnitMaxHP(u)))
                        call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA))
                        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", u, "origin"))
                        set Gym_ArgG = g  // v4.3 (3.4.2): team + first Pokemon in their own thread (op limit)
                        call ExecuteFunc("Gym_StartIt")
                    endif
                endif
            endloop
        endif
        set g = g + 1
    endloop
    set u = null
endfunction

function Gym_ClearItems takes unit d returns nothing
    local integer s = 0
    local item it = null
    loop
        exitwhen s >= 6
        set it = UnitItemInSlot(d, s)
        if it != null then
            call RemoveItem(it)
        endif
        set s = s + 1
    endloop
    set it = null
endfunction

// v4.3 (3.4.2): what Gym_OnDeath did, as a function: Gym_Tick can also move a gym on (Gym_AdvanceIt)
function Gym_Advance takes integer g, unit d returns nothing
    local integer pid = 0
    call Gym_ClearItems(d)  // v3.3.2: gym Pokemon drop nothing but the badge
    set Gym_Dead[g * 6 + Gym_Stage[g]] = d
    set Gym_Cur[g] = null
    set Gym_Stage[g] = Gym_Stage[g] + 1
    if Gym_Stage[g] >= 6 then
        set pid = Gym_Pid[g]
        call CreateItem(Gym_Item[g], GetUnitX(d), GetUnitY(d))
        set Badge_Has[pid * 8 + g] = true
        call DisplayTimedTextToPlayer(Player(pid), 0, 0, 8.0, "|cff4ade80[GYM CLEARED]|r |cffe8ecf2Gym " + I2S(g + 1) + " item dropped. Badges|r |cffffd166" + I2S(Badge_Count(pid)) + "/8|r|cffe8ecf2, level cap|r |cffffd166" + I2S(Badge_Cap(pid)) + "|r.")
        set Gym_PCool[pid * 8 + g] = Mega_Time + Gym_ClearCool
        call Gym_Reset(g)
    else
        set Gym_ArgG = g  // v4.3 (3.4.2): the next Pokemon in its own thread (op limit)
        set Gym_ArgK = Gym_Stage[g]
        call ExecuteFunc("Gym_SpawnIt")
    endif
endfunction

// v3.4.2 "-gym": state of the gym you are in (or of all busy gyms)
function Gym_OnChat takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local integer pid = GetPlayerId(p)
    local integer g = 0
    local integer k = 0
    local string s = ""
    local boolean any = false
    loop
        exitwhen g >= 9
        if Gym_Pid[g] >= 0 then
            set any = true
            set s = "|cffffcc00Gym " + I2S(g + 1) + "|r: " + GetPlayerName(Player(Gym_Pid[g])) + ", Pokemon " + I2S(Gym_Stage[g] + 1) + " of 6"
            if Gym_Cur[g] == null or GetUnitTypeId(Gym_Cur[g]) == 0 then
                set s = s + ", current: none (it will be spawned again)"
            else
                set s = s + ", current: " + GetUnitName(Gym_Cur[g]) + " " + I2S(R2I(GetWidgetLife(Gym_Cur[g]))) + " HP at " + I2S(R2I(SquareRoot((GetUnitX(Gym_Cur[g]) - Gym_X[g]) * (GetUnitX(Gym_Cur[g]) - Gym_X[g]) + (GetUnitY(Gym_Cur[g]) - Gym_Y[g]) * (GetUnitY(Gym_Cur[g]) - Gym_Y[g])))) + " from the centre"
            endif
            call DisplayTimedTextToPlayer(p, 0, 0, 15.0, s)
            if Gym_Pid[g] == pid then
                set s = "  team:"
                set k = 0
                loop
                    exitwhen k >= 6
                    set s = s + " " + I2S(k + 1) + "=" + GetObjectName(Gym_Team[g * 6 + k])
                    set k = k + 1
                endloop
                call DisplayTimedTextToPlayer(p, 0, 0, 15.0, s)
            endif
        endif
        set g = g + 1
    endloop
    if not any then
        call DisplayTimedTextToPlayer(p, 0, 0, 8.0, "|cffffcc00No gym battle right now.|r")
    endif
    set p = null
endfunction
// v3.4.2: ExecuteFunc entry points (arguments in Gym_ArgG / Gym_ArgK)
function Gym_StartIt takes nothing returns nothing
    local integer g = Gym_ArgG
    call Gym_BuildTeam(g, Gym_Hero[g])
    call Gym_Spawn(g, 0)
endfunction

function Gym_SpawnIt takes nothing returns nothing
    call Gym_Spawn(Gym_ArgG, Gym_ArgK)
endfunction

function Gym_AdvanceIt takes nothing returns nothing
    if Gym_Pid[Gym_ArgG] >= 0 and Gym_Cur[Gym_ArgG] != null then
        call Gym_Advance(Gym_ArgG, Gym_Cur[Gym_ArgG])
    endif
endfunction

function Gym_OnDeath takes nothing returns boolean
    local unit d = GetDyingUnit()
    local integer g = 0
    local integer pid = 0
    loop
        exitwhen g >= 8
        if Gym_Pid[g] >= 0 and Gym_Cur[g] != null and d == Gym_Cur[g] then
            call Gym_Advance(g, d)
        endif
        set g = g + 1
    endloop
    set d = null
    return false
endfunction

// ---------------------------------------------------------------------------------------------
// v3.4 Elite Four + Champion ("-league", 8 badges): 5 battles in a row in the arena of gym 8 (gym slot 8 of the
// Gym_* arrays), 6 Pokemon of one type each (Will Psychic, Koga Poison, Bruno Fighting, Karen Dark), then Champion
// Lance (Dragon) whose Pokemon Mega Evolve at 50% HP. Win: title [Champion] (+15% STR / AGI / INT, Champion Aura),
// 10000 gold, a Mega Ring, Shiny Charm (Shiny 1/20). Loss: 60s before the next try.
// ---------------------------------------------------------------------------------------------
function League_Hero takes integer pid returns unit
    local unit u = null
    local unit r = null
    call GroupEnumUnitsOfPlayer(Wild_Tmp, Player(pid), null)
    loop
        set u = FirstOfGroup(Wild_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Wild_Tmp, u)
        if r == null and IsUnitType(u, UNIT_TYPE_HERO) and GetWidgetLife(u) > 0.405 and GetUnitTypeId(u) != 'earc' then
            set r = u
        endif
    endloop
    return r
endfunction

// the team of stage League_Stage: Pokemon of its type from the gym pool (one per line), or the Champion's six
function League_BuildTeam takes nothing returns nothing
    local integer ty = League_Type[League_Stage]
    local integer i = 0
    local integer n = 0
    local integer k = 0
    local integer pick = 0
    local integer form = 0
    loop
        exitwhen i >= Gym_PoolN
        set form = Gym_FormAt(Gym_Pool[i], Gym_Level(Gym_Base[8], 3))
        if Ty_OfType(form, 0) == ty or Ty_OfType(form, 1) == ty then
            set League_Cand[n] = Gym_Pool[i]
            set n = n + 1
        endif
        set i = i + 1
    endloop
    loop
        exitwhen k >= 6
        if League_Stage == 4 then
            set Gym_Root[48 + k] = League_ChampTeam[k]
            set Gym_Team[48 + k] = League_ChampTeam[k]
        else
            if n > 0 then
                set pick = GetRandomInt(0, n - 1)
                set Gym_Root[48 + k] = League_Cand[pick]
                set League_Cand[pick] = League_Cand[n - 1]
                set n = n - 1
            else
                set Gym_Root[48 + k] = Gym_Pool[GetRandomInt(0, Gym_PoolN - 1)]
            endif
            set Gym_Team[48 + k] = Gym_FormAt(Gym_Root[48 + k], Gym_Level(Gym_Base[8], k))
        endif
        set Gym_TeamKit[48 + k] = ty
        set k = k + 1
    endloop
endfunction

function League_NextStage takes nothing returns nothing
    local unit u = League_Unit
    call SetWidgetLife(u, I2R(BlzGetUnitMaxHP(u)))
    call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA))
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", u, "origin"))
    set Gym_Base[8] = GetHeroLevel(u) + League_Stage + 1
    set Gym_Stage[8] = 0
    call League_BuildTeam()
    if League_Stage == 4 then
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffffcc00" + GetPlayerName(Player(League_Pid)) + " challenges Champion Lance!|r")
    else
        call DisplayTimedTextToPlayer(Player(League_Pid), 0, 0, 8.0, "|cffffcc00Elite Four " + I2S(League_Stage + 1) + "/4: " + League_Name[League_Stage] + " (" + Ty_Name[League_Type[League_Stage]] + ")|r")
    endif
    call Gym_Spawn(8, 0)
    set u = null
endfunction

function League_End takes nothing returns nothing
    if Gym_Cur[8] != null then
        call RemoveUnit(Gym_Cur[8])
    endif
    set Gym_Cur[8] = null
    set Gym_Pid[8] = -1
    set League_Pid = -1
    set League_Unit = null
    call ExecuteFunc("Fx_LeagueNextX")  // v3.4.11
endfunction

function League_Lose takes string why returns nothing
    call DisplayTimedTextToPlayer(Player(League_Pid), 0, 0, 8.0, "|cffff4040Pokemon League: " + why + " Try again in 30 seconds.|r")
    set League_Cool[League_Pid] = Mega_Time + 30.0
    call League_End()
endfunction

function League_Win takes nothing returns nothing
    local integer pid = League_Pid
    local player p = Player(pid)
    if not League_Champ[pid] then
        set League_Champ[pid] = true
        call PAX_Champ_Sync(League_Unit)
        call SetPlayerName(p, "[Champion] " + GetPlayerName(p))
    endif
    call AdjustPlayerStateBJ(10000, p, PLAYER_STATE_RESOURCE_GOLD)
    call UnitAddItemById(League_Unit, Itm_Id[18])
    call PAX_MajorEvent("|cffffd166", "[LEAGUE CHAMPION]", "|cff7dd3fc" + GetPlayerName(p) + "|r defeated Champion Lance and is the new Pokemon Champion!", 15.0)
    call DisplayTimedTextToPlayer(p, 0, 0, 15.0, "|cff66ff66Title [Champion]: +15% STR / AGI / INT, Champion Aura (allies within 800: +10% damage, -10% damage taken), 10000 gold, a Mega Ring, Shiny Charm (Shiny 1/20).|r")
    call SetUnitPosition(League_Unit, League_RX, League_RY)
    call PanCameraToTimedForPlayer(p, League_RX, League_RY, 0.3)
    call League_End()
    set p = null
endfunction

function League_Start takes integer pid returns nothing
    local unit u = League_Hero(pid)
    local player p = Player(pid)
    if u == null then
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00You need a Pokemon.|r")
    elseif Badge_Count(pid) < 8 then
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffff4040The Pokemon League needs all 8 badges (you have " + I2S(Badge_Count(pid)) + ").|r")
    elseif League_Pid >= 0 then  // v3.4.11: queue
        set Fx_ArgI = pid
        call ExecuteFunc("Fx_LeagueQueueX")
    elseif Gym_Busy(pid) then
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00Finish your gym battle first.|r")
    elseif Mega_Time < League_Cool[pid] then
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00Pokemon League: ready again in " + I2S(R2I(League_Cool[pid] - Mega_Time + 0.99)) + "s.|r")
    else
        set League_Pid = pid
        set League_Unit = u
        set League_Stage = 0
        set League_RX = GetUnitX(u)
        set League_RY = GetUnitY(u)
        set Gym_Pid[8] = pid
        set Gym_X[8] = Fx_LAX  // v3.4.11: the arena in Darkrai's room
        set Gym_Y[8] = Fx_LAY
        call SetUnitPosition(u, Gym_X[8], Gym_Y[8] - 250.0)
        call PanCameraToTimedForPlayer(p, Gym_X[8], Gym_Y[8], 0.3)
        call League_NextStage()
    endif
    set u = null
    set p = null
    set Gym_DownSince[8] = 0.0  // v3.4.5
endfunction

function League_OnChat takes nothing returns nothing
    call League_Start(GetPlayerId(GetTriggerPlayer()))
endfunction

function League_Tick takes nothing returns nothing
    local integer k = 0
    local real dx = 0.0
    local real dy = 0.0
    loop
        exitwhen k >= 6
        if Gym_Dead[48 + k] != null and GetWidgetLife(Gym_Dead[48 + k]) <= 0.405 then
            call RemoveUnit(Gym_Dead[48 + k])
            set Gym_Dead[48 + k] = null
        endif
        set k = k + 1
    endloop
    if League_Pid >= 0 then
        if League_Unit == null or GetUnitTypeId(League_Unit) == 0 or Gym_Down(8, League_Unit) then  // v3.4.5: Revive
            call League_Lose("you lost.")
        else
            set dx = GetUnitX(League_Unit) - Gym_X[8]
            set dy = GetUnitY(League_Unit) - Gym_Y[8]
            if SquareRoot(dx * dx + dy * dy) > Gym_Leave then
                call League_Lose("you left the arena.")
            endif
        endif
    endif
endfunction

function League_OnDeath takes nothing returns boolean
    local unit d = GetDyingUnit()
    if League_Pid >= 0 and Gym_Cur[8] != null and d == Gym_Cur[8] then
        call Gym_ClearItems(d)
        set Gym_Dead[48 + Gym_Stage[8]] = d
        set Gym_Cur[8] = null
        set Gym_Stage[8] = Gym_Stage[8] + 1
        if Gym_Stage[8] < 6 then
            call Gym_Spawn(8, Gym_Stage[8])
        elseif League_Stage < 4 then
            call DisplayTimedTextToPlayer(Player(League_Pid), 0, 0, 6.0, "|cff66ff66" + League_Name[League_Stage] + " is defeated!|r")
            set League_Stage = League_Stage + 1
            call League_NextStage()
        else
            call League_Win()
        endif
    endif
    set d = null
    return false
endfunction

// the Champion's Pokemon Mega Evolve once at 50% HP (Ab_OnDamaging)
function League_TryMega takes unit t, real d returns nothing
    local integer i = 0
    if League_Pid < 0 or League_Stage != 4 or t != Gym_Cur[8] or LoadInteger(Mega_HT, GetHandleId(t), 0) > 0 then
        return
    endif
    if GetWidgetLife(t) - d > 0.5 * I2R(BlzGetUnitMaxHP(t)) then
        return
    endif
    loop
        exitwhen i >= Mega_N
        if Mega_Base[i] == GetUnitTypeId(t) then
            call Mega_Start(t, i)
            return
        endif
        set i = i + 1
    endloop
endfunction

function Gym_IsChain takes integer id returns boolean
    local integer i = 0
    loop
        exitwhen i >= 24
        if Gym_Chain[i] == id then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

// the original leader chains are replaced by the teams above
function Gym_Init takes nothing returns nothing
    local unit u = null
    local integer g = 0
    local trigger gdt = CreateTrigger()
    set Gym_X[0] = -1405.5
    set Gym_Y[0] = 5887.1
    set Gym_Item[0] = 'I014'
    set Gym_Pid[0] = -1
    set Gym_X[1] = -2683.8
    set Gym_Y[1] = 5896.7
    set Gym_Item[1] = 'I015'
    set Gym_Pid[1] = -1
    set Gym_X[2] = -3969.1
    set Gym_Y[2] = 5890.0
    set Gym_Item[2] = 'I016'
    set Gym_Pid[2] = -1
    set Gym_X[3] = -5377.2
    set Gym_Y[3] = 5888.7
    set Gym_Item[3] = 'I017'
    set Gym_Pid[3] = -1
    set Gym_X[4] = 1154.9
    set Gym_Y[4] = 5877.8
    set Gym_Item[4] = 'I019'
    set Gym_Pid[4] = -1
    set Gym_X[5] = 2436.6
    set Gym_Y[5] = 5898.4
    set Gym_Item[5] = 'I018'
    set Gym_Pid[5] = -1
    set Gym_X[6] = 3716.3
    set Gym_Y[6] = 5866.3
    set Gym_Item[6] = 'I01A'
    set Gym_Pid[6] = -1
    set Gym_X[7] = 5379.5
    set Gym_Y[7] = 5879.2
    set Gym_Item[7] = 'I01B'
    set Gym_Pid[7] = -1
    set Gym_Chain[0] = 'n00S'
    set Gym_Chain[1] = 'n00U'
    set Gym_Chain[2] = 'n00T'
    set Gym_Chain[3] = 'n00R'
    set Gym_Chain[4] = 'n00W'
    set Gym_Chain[5] = 'n00V'
    set Gym_Chain[6] = 'n00X'
    set Gym_Chain[7] = 'n00Y'
    set Gym_Chain[8] = 'n00Z'
    set Gym_Chain[9] = 'n010'
    set Gym_Chain[10] = 'n012'
    set Gym_Chain[11] = 'n011'
    set Gym_Chain[12] = 'n014'
    set Gym_Chain[13] = 'n013'
    set Gym_Chain[14] = 'n015'
    set Gym_Chain[15] = 'n018'
    set Gym_Chain[16] = 'n016'
    set Gym_Chain[17] = 'n017'
    set Gym_Chain[18] = 'n019'
    set Gym_Chain[19] = 'n01A'
    set Gym_Chain[20] = 'n01B'
    set Gym_Chain[21] = 'n01C'
    set Gym_Chain[22] = 'n01D'
    set Gym_Chain[23] = 'n01E'
    loop
        exitwhen g >= 8
        call GroupEnumUnitsInRange(Wild_Tmp, Gym_X[g], Gym_Y[g], 700.0, null)
        loop
            set u = FirstOfGroup(Wild_Tmp)
            exitwhen u == null
            call GroupRemoveUnit(Wild_Tmp, u)
            if Gym_IsChain(GetUnitTypeId(u)) then
                call RemoveUnit(u)
            endif
        endloop
        set g = g + 1
    endloop
    call TriggerRegisterAnyUnitEventBJ(gdt, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(gdt, Condition(function Gym_OnDeath))
    call TimerStart(CreateTimer(), 1.0, true, function Gym_Tick)
    set u = null
    set gdt = null
endfunction

// ---------------------------------------------------------------------------------------------
// Random legends
// ---------------------------------------------------------------------------------------------
function Leg_IsLegend takes integer id returns boolean
    local integer i = 0
    loop
        exitwhen i >= Leg_N
        if Leg_Type[i] == id then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

// highest hero level of a player (damage may come from a skill dummy, so look at the owner)
function Leg_PlayerLevel takes player p returns integer
    local unit u = null
    local integer best = 0
    call GroupEnumUnitsOfPlayer(Leg_Tmp, p, null)
    loop
        set u = FirstOfGroup(Leg_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Leg_Tmp, u)
        if IsUnitType(u, UNIT_TYPE_HERO) and GetHeroLevel(u) > best then
            set best = GetHeroLevel(u)
        endif
    endloop
    return best
endfunction

function Leg_Spawn takes nothing returns nothing
    local unit lg = null
    local integer tries = 0
    local integer i = 0
    local integer c = 0
    local real x = 0.0
    local real y = 0.0
    if Leg_N == 0 then
        return
    endif
    // v3.3.4: a random legend among those that have not appeared yet
    loop
        exitwhen i >= Leg_N
        if Leg_Up[i] == 0 then
            set c = c + 1
        endif
        set i = i + 1
    endloop
    if c == 0 then
        return
    endif
    set tries = GetRandomInt(1, c)
    set i = -1
    loop
        set i = i + 1
        if Leg_Up[i] == 0 then
            set tries = tries - 1
        endif
        exitwhen tries == 0
    endloop
    set c = 0
    if Wild_CampN > 0 then
        set c = GetRandomInt(0, Wild_CampN - 1)
        set x = Wild_CampX[c]
        set y = Wild_CampY[c]
    endif
    set lg = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), Leg_Type[i], x, y, 270.0)
    call SaveInteger(Ab_HT, GetHandleId(lg), 0, LoadInteger(Ab_HT, Leg_Type[i], 0))  // v3.3: legends have an Ability
    call Ai_GiveKit(lg)  // v3.4: and the 5 skills of their type, cast by Ai_Tick
    call BlzSetUnitMaxHP(lg, BlzGetUnitMaxHP(lg) * 20)  // ver2: boss x20 HP, x5 attack, x3 armor
    call SetWidgetLife(lg, I2R(BlzGetUnitMaxHP(lg)))
    call BlzSetUnitBaseDamage(lg, BlzGetUnitBaseDamage(lg, 0) * 5, 0)
    call BlzSetUnitDiceSides(lg, BlzGetUnitDiceSides(lg, 0) * 5, 0)
    call BlzSetUnitArmor(lg, BlzGetUnitArmor(lg) * 3.0)
    call PAX_Boss_Register(lg, x, y)
    set lg = null
    set Leg_Alive = Leg_Alive + 1
    set Leg_Up[i] = 1
    call PingMinimap(x, y, 5.0)
    call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10.0, "|cffff66ccA wild " + Leg_Name[i] + " (Lv 100, HP x20, attack x5, armor x3) appeared! Only level 100 Pokemon can hurt it.|r")
endfunction

function Leg_OnDamage takes nothing returns boolean
    local unit t = BlzGetEventDamageTarget()
    local player p = null
    local integer pid = 0
    if Leg_IsLegend(GetUnitTypeId(t)) then
        set p = GetOwningPlayer(GetEventDamageSource())
        set pid = GetPlayerId(p)
        if pid < 12 and Leg_PlayerLevel(p) < Leg_MinLevel then
            call BlzSetEventDamage(0.0)
            if Mega_Time - Leg_Warned[pid] > 3.0 then
                set Leg_Warned[pid] = Mega_Time
                call DisplayTimedTextToPlayer(p, 0, 0, 3.0, "|cffff0000Only level 100 Pokemon can hurt " + GetUnitName(t) + "!|r")
            endif
        endif
    endif
    set t = null
    set p = null
    return false
endfunction

function Leg_OnDeath takes unit u returns nothing
    local integer i = 0
    loop
        exitwhen i >= Leg_N
        if Leg_Type[i] == GetUnitTypeId(u) then
            set Leg_Alive = Leg_Alive - 1
            // v3.3.4: Leg_Up stays 1, the legend never comes back
            if GetRandomInt(1, 100) <= Leg_SoulChance then
                call CreateItem(Leg_Soul[i], GetUnitX(u), GetUnitY(u))
                call PAX_Announce("|cffffd166[SOUL DROP]|r |cffffd166" + Leg_Name[i] + "|r |cffe8ecf2dropped its Soul!|r", 10.0)
            else
                call CreateItem('I00B', GetUnitX(u), GetUnitY(u))
                call CreateItem('I001', GetUnitX(u), GetUnitY(u))
                call CreateItem('I000', GetUnitX(u), GetUnitY(u))
            endif
            return
        endif
        set i = i + 1
    endloop
endfunction

function Wild_Tick takes nothing returns nothing
    local integer c = 0
    set Wild_Time = Wild_Time + 2.0
    if Wild_Time >= Wild_NextCheck then
        set Wild_NextCheck = Wild_Time + Wild_LevelCheck
        call Wild_UpdateTier()
        if Wild_Tier > Wild_UpTier then
            set Wild_UpTier = Wild_Tier
            call Wild_Upgrade()
        endif
    endif
    if Wild_Time >= Leg_Next then
        set Leg_Next = Leg_Next + Leg_Interval
        if Leg_Alive < Leg_Max then
            call Leg_Spawn()
        endif
        if Leg_Alive < Leg_Max then
            call Leg_Spawn()
        endif
    endif
    call Wild_Scan()
    loop
        exitwhen c >= Wild_CampN
        if Wild_CampDue[c] > 0.0 and Wild_Time >= Wild_CampDue[c] then
            call Wild_SpawnCamp(c)
        else
            if Wild_CampAlive[c] > 0 and Wild_CampDue[c] == 0.0 then
                if Wild_Time - LoadReal(Mega_HT, c + 500, 1) >= 30.0 and LoadInteger(Mega_HT, c + 500, 2) < 2 then
                    call SaveReal(Mega_HT, c + 500, 1, Wild_Time)
                    call SaveInteger(Mega_HT, c + 500, 2, LoadInteger(Mega_HT, c + 500, 2) + 1)
                    call Wild_ReinforceCamp(c)
                endif
            endif
        endif
        set c = c + 1
    endloop
endfunction

function Wild_OnDeath takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer c = LoadInteger(Mega_HT, h, 25) - 1
    local integer soul = 0
    if c >= 0 then
        set Wild_CampAlive[c] = Wild_CampAlive[c] - 1
        if Wild_CampAlive[c] <= 0 then
            set Wild_CampDue[c] = Wild_Time + Wild_Respawn
        endif
    endif
    if Wild_IsWildType(GetUnitTypeId(u)) then
        // only the Soul of its own species, and only species that have a playable version
        set soul = LoadInteger(Mega_HT, GetUnitTypeId(u), 8)
        if soul != 0 and LoadInteger(Mega_HT, h, 29) == 1 and GetRandomReal(0.0, 100.0) < Wild_SoulChance then
            call CreateItem(soul, GetUnitX(u), GetUnitY(u))
            call PAX_Announce("|cffffd166[SOUL DROP]|r |cffe8ecf2A wild|r |cffffd166" + GetUnitName(u) + "|r |cffe8ecf2dropped its Soul!|r", 8.0)
        endif
        if LoadInteger(Mega_HT, h, 44) > 0 and GetRandomReal(0.0, 100.0) < 5.0 then  // v3.4 Mega elite
            call CreateItem(Mega_Stone[LoadInteger(Mega_HT, h, 44) - 1], GetUnitX(u), GetUnitY(u))
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffff66ccA Mega elite dropped its Mega Stone!|r")
        endif
        // v3.3.3: wild creeps no longer drop Mega Stones (only from the Mega Shops)
        call FlushChildHashtable(Mega_HT, h)
    endif
endfunction

// pre-placed wild creeps join the nearest camp
function Wild_RegisterCamps takes nothing returns nothing
    local unit u = null
    local integer i = 0
    local integer best = 0
    local real bd = 0.0
    local real d = 0.0
    loop
        exitwhen i >= Wild_TypeN
        call SaveBoolean(Mega_HT, Wild_Type[i], 7, true)
        set i = i + 1
    endloop
    call GroupEnumUnitsOfPlayer(Wild_Tmp, Player(PLAYER_NEUTRAL_AGGRESSIVE), null)
    loop
        set u = FirstOfGroup(Wild_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Wild_Tmp, u)
        if Wild_IsWildType(GetUnitTypeId(u)) then
            set best = -1
            set bd = Wild_CampRadius * Wild_CampRadius
            set i = 0
            loop
                exitwhen i >= Wild_CampN
                set d = (GetUnitX(u) - Wild_CampX[i]) * (GetUnitX(u) - Wild_CampX[i]) + (GetUnitY(u) - Wild_CampY[i]) * (GetUnitY(u) - Wild_CampY[i])
                if d < bd then
                    set bd = d
                    set best = i
                endif
                set i = i + 1
            endloop
            if best >= 0 then
                call SaveInteger(Mega_HT, GetHandleId(u), 25, best + 1)
                set Wild_CampAlive[best] = Wild_CampAlive[best] + 1
                call SaveReal(Mega_HT, best + 500, 1, 0.0)
                call SaveInteger(Mega_HT, best + 500, 2, 0)
                call SaveInteger(Mega_HT, best + 500, 3, GetUnitTypeId(u))
                if LoadInteger(Mega_HT, best + 500, 4) == 0 then
                    call SaveInteger(Mega_HT, best + 500, 4, 1)
                    call Wild_MakeElite(u)
                endif
            endif
        endif
    endloop
endfunction

// ---------------------------------------------------------------------------------------------
// Repick
// ---------------------------------------------------------------------------------------------
function Repick_Do takes player p returns nothing
    local integer pid = GetPlayerId(p)
    local unit h = null
    local unit u = null
    local item it = null
    local integer i = 0
    if Mega_Time >= Repick_Window then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00Repick is only allowed in the first 2 minutes.|r")
        return
    endif
    if Repick_Count[pid] >= Repick_Max then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00You have no repicks left.|r")
        return
    endif
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if h == null and IsUnitType(u, UNIT_TYPE_HERO) then
            set h = u
        endif
    endloop
    if h == null or IsUnitType(h, UNIT_TYPE_DEAD) or LoadInteger(Mega_HT, GetHandleId(h), 0) > 0 then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00You need a living Pokemon (not in Mega form) to repick.|r")
        set h = null
        return
    endif
    set Repick_Count[pid] = Repick_Count[pid] + 1
    set Repick_XP[pid] = GetHeroXP(h)
    set Repick_Pending[pid] = true
    loop
        exitwhen i >= 6
        set it = UnitItemInSlot(h, i)
        if it != null then
            call UnitRemoveItem(h, it)
            call SetItemVisible(it, false)
        endif
        call SaveItemHandle(Mega_HT, 900 + pid, i, it)
        set i = i + 1
    endloop
    set Repick_Old[pid] = GetUnitTypeId(h)  // v4.3.1
    call RemoveUnit(h)
    set u = CreateUnit(p, 'earc', -128.0, 4544.0, 270.0)
    call SelectUnitForPlayerSingle(u, p)
    call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffffcc00" + GetPlayerName(p) + "|r repicked (" + I2S(Repick_Count[pid]) + "/2)")
    set h = null
    set u = null
    set it = null
endfunction

// give the XP and items of the repicked Pokemon to the player's new one
function Repick_Restore takes unit u returns nothing
    local integer pid = GetPlayerId(GetOwningPlayer(u))
    local integer i = 0
    local item it = null
    if not Repick_Pending[pid] or not IsUnitType(u, UNIT_TYPE_HERO) then
        return
    endif
    set Repick_Pending[pid] = false
    call SetHeroXP(u, Repick_XP[pid], true)
    loop
        exitwhen i >= 6
        set it = LoadItemHandle(Mega_HT, 900 + pid, i)
        if it != null then
            call SetItemVisible(it, true)
            call UnitAddItem(u, it)
        endif
        set i = i + 1
    endloop
    call FlushChildHashtable(Mega_HT, 900 + pid)
    set it = null
endfunction

function Repick_OnChat takes nothing returns nothing
    call Repick_Do(GetTriggerPlayer())
endfunction

// a Pokemon bought at a tavern keeps the experience of the owner's best Pokemon (no drop back to level 1)
function Keep_XP takes unit bought returns nothing
    local player p = GetOwningPlayer(bought)
    local unit u = null
    local integer best = 0
    if not IsUnitType(bought, UNIT_TYPE_HERO) then
        set p = null
        return
    endif
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if u != bought and IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitType(u, UNIT_TYPE_DEAD) then
            if GetHeroXP(u) > best then
                set best = GetHeroXP(u)
            endif
        endif
    endloop
    if best > GetHeroXP(bought) then
        call SetHeroXP(bought, best, false)
    endif
    set p = null
    set u = null
endfunction

function Repick_OnSell takes nothing returns nothing
    call Repick_Restore(GetSoldUnit())
    call Keep_XP(GetSoldUnit())
endfunction

// ---------------------------------------------------------------------------------------------
// Random starter Pokemon
// ---------------------------------------------------------------------------------------------
function Rand_FindWisp takes player p returns unit
    local unit u = null
    local unit w = null
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if GetUnitTypeId(u) == 'earc' then
            set w = u
        endif
    endloop
    return w
endfunction

function Rand_IsTaken takes integer t returns boolean
    local integer i = 0
    local boolean taken = false
    local unit u = null
    loop
        exitwhen i >= bj_MAX_PLAYERS or taken
        call GroupEnumUnitsOfPlayer(Rand_Tmp, Player(i), null)
        loop
            set u = FirstOfGroup(Rand_Tmp)
            exitwhen u == null
            call GroupRemoveUnit(Rand_Tmp, u)
            if GetUnitTypeId(u) == t then
                set taken = true
            endif
        endloop
        set i = i + 1
    endloop
    return taken
endfunction

function Rand_Give takes player p returns nothing
    local unit w = Rand_FindWisp(p)
    local unit h = null
    local integer t = 0
    local integer tries = 0
    if w == null or Rand_N == 0 then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00You already have a Pokemon.|r")
        return
    endif
    loop
        set t = Rand_Type[GetRandomInt(0, Rand_N - 1)]
        set tries = tries + 1
        exitwhen tries >= 20 or (not Rand_IsTaken(t) and t != Repick_Old[GetPlayerId(p)])  // v4.3.1
    endloop
    set h = CreateUnit(p, t, GetUnitX(w), GetUnitY(w), 270.0)
    set Repick_Old[GetPlayerId(p)] = 0  // v4.3.1
    call Repick_Restore(h)
    call RemoveUnit(w)
    call SelectUnitForPlayerSingle(h, p)
    call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffffcc00" + GetPlayerName(p) + "|r Has Choosen (random) |cffffcc00" + GetHeroProperName(h) + "|r")
    set w = null
    set h = null
endfunction

// the host is the lowest slot that is playing; host commands (-random, chicken) apply to everyone
// v4.3.1: -repick = the old repick (checks, remove the Pokemon, picker wisp) followed by a random Pokemon
function Repick_RandomOnChat takes nothing returns nothing
    local player p = GetTriggerPlayer()
    local integer pid = GetPlayerId(p)
    call Repick_Do(p)
    if Repick_Pending[pid] and Rand_FindWisp(p) != null then
        call Rand_Give(p)
    endif
    set p = null
endfunction

function Host_Id takes nothing returns integer
    local integer i = 0
    loop
        exitwhen i >= 12 or GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING
        set i = i + 1
    endloop
    return i
endfunction


function Rand_Auto takes nothing returns nothing
    local integer i = 0
    loop
        exitwhen i >= 12
        if Rand_FindWisp(Player(i)) != null then
            call Rand_Give(Player(i))
        endif
        set i = i + 1
    endloop
endfunction

function Rand_OnChat takes nothing returns nothing
    if GetPlayerId(GetTriggerPlayer()) != Host_Id() then
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 5.0, "|cffffcc00Only the host can type -random.|r")
        return
    endif
    call Rand_Auto()
endfunction

function Rand_Hint takes nothing returns nothing
    call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 15.0, "|cffffcc00The host types -random and every player gets a random Pokemon. Players who have not chosen after 45 seconds get one automatically. Type -repick in the first 2 minutes to get another random Pokemon (2 times, level and items are kept).|r")
endfunction

// ---------------------------------------------------------------------------------------------
// Evolution of the new Pokemon (same style as the map's own: effect, 1.5s, guarded replace)
// ---------------------------------------------------------------------------------------------
function Evo_OnLevel takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer id = GetUnitTypeId(u)
    local integer i = 0
    if PAX_Form_Id(u) > 0 or LoadInteger(PAX_Leg_HT, GetHandleId(u), 175) == 1 then
        set u = null
        return
    endif
    loop
        exitwhen i >= Evo_N
        if Evo_From[i] == id and GetHeroLevel(u) >= Evo_Level[i] then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl", u, "chest"))
            call TriggerSleepAction(1.50)
            if GetUnitTypeId(u) == id and PAX_Form_Id(u) == 0 and LoadInteger(PAX_Leg_HT, GetHandleId(u), 175) != 1 then
                call Mega_SafeReplace(u, Evo_To[i], bj_UNIT_STATE_METHOD_RELATIVE)
            endif
            set u = null
            return
        endif
        set i = i + 1
    endloop
    set u = null
endfunction

function Evo_OnPickup takes nothing returns nothing
    local unit u = GetTriggerUnit()
    local integer h = GetHandleId(u)
    local integer i = 0
    if PAX_Form_Id(u) > 0 or LoadInteger(PAX_Leg_HT, h, 175) == 1 or Mega_Time < LoadReal(PAX_Leg_HT, h, 150) then
        set u = null
        return
    endif
    loop
        exitwhen i >= Evo_ItemN
        if GetUnitTypeId(u) == Evo_ItemFrom[i] and GetItemTypeId(GetManipulatedItem()) == Evo_Item[i] then
            call SaveReal(PAX_Leg_HT, h, 150, Mega_Time + 2.0)
            call RemoveItem(GetManipulatedItem())
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl", u, "chest"))
            call TriggerSleepAction(1.50)
            if GetUnitTypeId(u) == Evo_ItemFrom[i] and PAX_Form_Id(u) == 0 then
                set Mega_EvoItem = true
                call Mega_SafeReplace(u, Evo_ItemTo[i], bj_UNIT_STATE_METHOD_RELATIVE)
                set Mega_EvoItem = false
            endif
            set u = null
            return
        endif
        set i = i + 1
    endloop
    set u = null
endfunction

// ---------------------------------------------------------------------------------------------
// Own-species Souls: holding one in slot 1 and entering the centre circle turns the Pokemon into it
// ---------------------------------------------------------------------------------------------
function Soul_OnEnter takes nothing returns nothing
    local unit u = GetEnteringUnit()
    local item it = UnitItemInSlot(u, 0)
    local integer i = 0
    loop
        exitwhen i >= Soul_N or it == null
        if GetItemTypeId(it) == Soul_Item[i] then
            call RemoveItem(it)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualTarget.mdl", u, "chest"))
            call TriggerSleepAction(1.50)
            set Mega_EvoItem = true
            call Mega_SafeReplace(u, Soul_Hero[i], bj_UNIT_STATE_METHOD_RELATIVE)
            set Mega_EvoItem = false
            if bj_lastReplacedUnit != null then  // v3.4: a Soul rolls Shiny anew
                call RemoveSavedInteger(Ab_HT, GetHandleId(bj_lastReplacedUnit), 124)
                call SaveInteger(Ab_HT, GetHandleId(bj_lastReplacedUnit), 123, 0)
            endif
            if bj_lastReplacedUnit != null and GetUnitTypeId(bj_lastReplacedUnit) == Soul_Hero[i] then
                // a Soul gives the base form: it evolves only after the next level up (key 35 = level at the Soul)
                call SaveInteger(Mega_HT, GetHandleId(bj_lastReplacedUnit), 35, GetHeroLevel(bj_lastReplacedUnit))
            endif
            set u = null
            set it = null
            return
        endif
        set i = i + 1
    endloop
    set u = null
    set it = null
endfunction

// ---------------------------------------------------------------------------------------------
// "t la ga": once per player, +10 levels for their Pokemon and +3000 gold
// ---------------------------------------------------------------------------------------------
function Chicken_Do takes player p returns nothing
    local integer pid = GetPlayerId(p)
    local unit h = null
    local unit u = null
    local integer lv = 0
    if Chicken_Used[pid] then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00You already used it.|r")
        return
    endif
    call GroupEnumUnitsOfPlayer(Rand_Tmp, p, null)
    loop
        set u = FirstOfGroup(Rand_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Rand_Tmp, u)
        if h == null and IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitType(u, UNIT_TYPE_DEAD) then
            set h = u
        endif
    endloop
    if h == null then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00Pick a living Pokemon first.|r")
        return
    endif
    set Chicken_Used[pid] = true
    set lv = GetHeroLevel(h) + Chicken_Levels
    if lv > 100 then
        set lv = 100
    endif
    call SetHeroLevel(h, lv, true)
    call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) + Chicken_Gold)
    call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 8.0, "|cffffcc00" + GetPlayerName(p) + "|r is a chicken: +" + I2S(Chicken_Levels) + " levels, +" + I2S(Chicken_Gold) + " gold.")
    set h = null
endfunction

// only the host can type it; it applies to every player (each player still only once)
function Chicken_OnChat takes nothing returns nothing
    local integer i = 0
    if GetPlayerId(GetTriggerPlayer()) != Host_Id() then
        call DisplayTimedTextToPlayer(GetTriggerPlayer(), 0, 0, 5.0, "|cffffcc00Only the host can type chicken.|r")
        return
    endif
    loop
        exitwhen i >= 12
        call Chicken_Do(Player(i))
        set i = i + 1
    endloop
endfunction

function Mega_CheckRemoved takes nothing returns nothing
    if GetUnitTypeId(GetEnumUnit()) == 0 then
        call Mega_End(GetEnumUnit())
    endif
endfunction

function Mega_Tick takes nothing returns nothing
    local integer pi = 0
    local integer h = 0
    local unit u = null
    set Mega_Time = Mega_Time + 0.25
    loop
        exitwhen pi >= bj_MAX_PLAYERS
        call GroupEnumUnitsOfPlayer(Mega_Tmp, Player(pi), null)
        loop
            set u = FirstOfGroup(Mega_Tmp)
            exitwhen u == null
            call GroupRemoveUnit(Mega_Tmp, u)
            if IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitType(u, UNIT_TYPE_DEAD) then
                set h = GetHandleId(u)
                if LoadInteger(Mega_HT, h, 0) > 0 then
                    if Mega_Time >= LoadReal(Mega_HT, h, 1) then
                        call Mega_End(u)
                    elseif LoadUnitHandle(Mega_HT, h, 4) != null then
                        call Mega_KidFollow(u, LoadUnitHandle(Mega_HT, h, 4))
                    endif
                else
                    // v3.2: the Mega button is the Mega Stone's item ability, no command-card button
                endif
            endif
        endloop
        set pi = pi + 1
    endloop
    // heroes removed from the game while in Mega form (e.g. ReplaceUnitBJ)
    call ForGroup(Mega_Group, function Mega_CheckRemoved)
endfunction

// v3.2.19: Mega Evolve is the active ability of the Mega Stone item (abilList = Mega_Evolve[i], usable item).
// Index of the Mega whose evolve ability / stone item is this id, or -1.
function Mega_IndexOfAbility takes integer a returns integer
    local integer i = 0
    loop
        exitwhen i >= Mega_N
        if Mega_Evolve[i] == a then
            return i
        endif
        set i = i + 1
    endloop
    return -1
endfunction

function Mega_IndexOfStone takes integer it returns integer
    local integer i = 0
    loop
        exitwhen i >= Mega_N
        if Mega_Stone[i] == it then
            return i
        endif
        set i = i + 1
    endloop
    return -1
endfunction

// "" when u may Mega Evolve with Mega idx now, else the reason shown to its owner
function Mega_CanStart takes unit u, integer idx returns string
    local integer h = GetHandleId(u)
    local real left = LoadReal(Mega_HT, h, 100 + idx) - Mega_Time
    if GetUnitTypeId(u) != Mega_Base[idx] then
        return "|cffff66ccThis Mega Stone only works for the Pokemon of " + Mega_Name[idx] + "|r"
    endif
    if Badge_Count(GetPlayerId(GetOwningPlayer(u))) < 4 then
        return "|cffff66ccMega Evolution requires at least 4 Gym Badges.|r"
    endif
    if LoadInteger(Mega_HT, h, 0) > 0 then
        return "|cffff66ccMega refused: already in Mega form|r"
    endif
    if PAX_Form_Id(u) > 0 then
        return "|cffff66ccReturn to the base form before Mega Evolving.|r"
    endif
    if left > 0.0 then
        return "|cffff66ccMega Stone is recharging: " + I2S(R2I(left + 0.99)) + "s|r"
    endif
    return ""
endfunction

// start the Mega once per use (the spell event and the use-item event both arrive for one click; key 6 = last time)
function Mega_TryStart takes unit u, integer idx returns nothing
    local integer h = GetHandleId(u)
    local string why = ""
    if HaveSavedReal(Mega_HT, h, 6) and LoadReal(Mega_HT, h, 6) == Mega_Time then
        return
    endif
    call SaveReal(Mega_HT, h, 6, Mega_Time)
    set why = Mega_CanStart(u, idx)
    if why != "" then
        call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, why)
        return
    endif
    call Mega_Start(u, idx)
endfunction

// begins casting: refuse a wrong Pokemon / Mega form / cooldown before the item cooldown starts
function Mega_OnBeginCast takes nothing returns boolean
    local integer abid = GetSpellAbilityId()
    local integer idx = Mega_IndexOfAbility(abid)
    local unit u = GetTriggerUnit()
    local string why = ""
    local integer formSlot = PAX_Form_ItemIndex(abid)
    if formSlot > 0 then
        set why = PAX_Form_CheckReady(u, formSlot)
        if why != "" then
            if not HaveSavedReal(PAX_Leg_HT, GetHandleId(u), 143) or LoadReal(PAX_Leg_HT, GetHandleId(u), 143) != Mega_Time then
                call SaveReal(PAX_Leg_HT, GetHandleId(u), 143, Mega_Time)
                call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, "|cffffcc00" + why + "|r")
            endif
            call IssueImmediateOrder(u, "stop")
        endif
        set u = null
        return false
    endif
    if abid == 'AM10' and GetUnitTypeId(u) != 'E02A' then
        call IssueImmediateOrder(u, "stop")
        call SaveReal(PAX_Leg_HT, GetHandleId(u), 127, Mega_Time)
        call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, "|cffffcc00Legend Plate: Only Arceus can channel the Plates.|r")
        set u = null
        return false
    endif
    if idx >= 0 then
        set why = Mega_CanStart(u, idx)
        if why != "" then
            call IssueImmediateOrder(u, "stop")
            call SaveReal(Mega_HT, GetHandleId(u), 6, Mega_Time)
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 6.0, why)
        endif
    endif
    set u = null
    return false
endfunction

function Mega_OnCast takes nothing returns boolean
    local integer abid = GetSpellAbilityId()
    local integer idx = Mega_IndexOfAbility(abid)
    if PAX_Form_ItemIndex(abid) > 0 then
        call PAX_Form_UseItem(GetTriggerUnit(), abid)
        return false
    endif
    if abid == 'AM10' then
        call PAX_Plate_Open(GetTriggerUnit())
        return false
    endif
    if idx >= 0 then
        call Mega_TryStart(GetTriggerUnit(), idx)
    endif
    return false
endfunction

function Mega_OnUseItem takes nothing returns boolean
    local integer itid = GetItemTypeId(GetManipulatedItem())
    local integer idx = Mega_IndexOfStone(itid)
    if PAX_Form_ItemIndex(itid) > 0 then
        call PAX_Form_UseItem(GetManipulatingUnit(), itid)
        return false
    endif
    if itid == 'IM10' then
        call PAX_Plate_Open(GetTriggerUnit())
        return false
    endif
    if idx >= 0 then
        call Mega_TryStart(GetTriggerUnit(), idx)
    endif
    return false
endfunction

function Mega_OnDeath takes nothing returns boolean
    call PAX_Leg_OnKillProgress(GetKillingUnit(), GetTriggerUnit(), Wild_IsWildType(GetUnitTypeId(GetTriggerUnit())), LoadInteger(Mega_HT, GetHandleId(GetTriggerUnit()), 29) == 1 or LoadInteger(Mega_HT, GetHandleId(GetTriggerUnit()), 44) > 0, Leg_IsLegend(GetUnitTypeId(GetTriggerUnit())) or PAX_IsFixedBoss(GetUnitTypeId(GetTriggerUnit())))
    call PAX_Leg_OnHeroDeath(GetTriggerUnit(), GetKillingUnit())
    call PAX_Fun_OnDeath(GetTriggerUnit(), GetKillingUnit(), Leg_IsLegend(GetUnitTypeId(GetTriggerUnit())) or PAX_IsFixedBoss(GetUnitTypeId(GetTriggerUnit())))
    call PAX_Late_OnDeath(GetTriggerUnit(), GetKillingUnit())
    call PAX_Chaos_OnDeath(GetTriggerUnit(), GetKillingUnit())
    if LoadInteger(Mega_HT, GetHandleId(GetTriggerUnit()), 0) > 0 then
        call Mega_End(GetTriggerUnit())
    endif
    if GetOwningPlayer(GetTriggerUnit()) == Player(PLAYER_NEUTRAL_AGGRESSIVE) then
        call PAX_Loot_OnDeath(GetTriggerUnit(), GetKillingUnit(), Wild_IsWildType(GetUnitTypeId(GetTriggerUnit())), LoadInteger(Mega_HT, GetHandleId(GetTriggerUnit()), 29) == 1 or LoadInteger(Mega_HT, GetHandleId(GetTriggerUnit()), 44) > 0, Leg_IsLegend(GetUnitTypeId(GetTriggerUnit())) or PAX_IsFixedBoss(GetUnitTypeId(GetTriggerUnit())))
        call Wild_OnDeath(GetTriggerUnit())
        call Leg_OnDeath(GetTriggerUnit())
    endif
    return false
endfunction

// Mega Kangaskhan: the Kid hits too (Parental Bond), at most once per 0.5s
function Mega_OnAttacked takes nothing returns boolean
    local unit u = GetAttacker()
    local integer h = GetHandleId(u)
    local unit kid = null
    local real dmg = 0.0
    if LoadInteger(Mega_HT, h, 0) == Mega_KangIdx + 1 then
        set kid = LoadUnitHandle(Mega_HT, h, 4)
        if kid != null and Mega_Time - LoadReal(Mega_HT, h, 5) >= 0.5 then
            call SaveReal(Mega_HT, h, 5, Mega_Time)
            call SetUnitAnimation(kid, "attack")
            call QueueUnitAnimation(kid, "stand")
            set dmg = 0.25 * (I2R(BlzGetUnitBaseDamage(u, 0)) + I2R(GetHeroStr(u, true)))
            call UnitDamageTarget(u, GetTriggerUnit(), dmg, true, false, ConvertAttackType(BlzGetUnitWeaponIntegerField(u, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0)), DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        endif
    endif
    set u = null
    set kid = null
    return false
endfunction

function Mega_Quests takes nothing returns nothing
    local string s = ""
    local integer i = 0
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "Mega Evolution", "Purchase Mega Stones at |cffff66ccMega Shop I|r / |cffff66ccMega Shop II|r / |cffff66ccMega Shop III|r (inside base, bottom row).\nClick on |cffff66ccMega Stone|r in your inventory to Mega Evolve; only corresponding Pokemon can use it.\nMega Evolution lasts 60s: transforms model, boosts STR/AGI/INT based on PokemonDB stats, +10 Armor, +80 Move Speed, +40% Attack Speed. Cooldown 150s.\nDying while Mega Evolved reverts you to normal form.\nMega Kangaskhan: baby joins in combat, dealing +25% bonus damage.\n\nModel Credits: PKLegends team and authors on Hive Workshop.", "ReplaceableTextures\\CommandButtons\\BTNMegaCharizardX.blp")
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "Gym & Level", "Cap 1: Max Level 30, can challenge Gym 1-2.\nDefeat Gym 1-2 -> Cap 2: Max Level 50, Gym 1-4 unlocked.\nDefeat Gym 3-4 -> Cap 3: Max Level 70, Gym 1-6 unlocked.\nDefeat Gym 5-6 -> Cap 4: Max Level 90, Gym 1-8 unlocked.\nDefeat all 8 Gyms: Max Level 100.\n\nInventory: Up to 4 Badges and 2 Stat Items (Type items, Leftovers, Shell Bell, Mega Stone...). Souls are not limited.\nType -badges to check everyone's progress.", "ReplaceableTextures\\CommandButtons\\BTNMedalionOfCourage.blp")
    loop
        exitwhen i >= Mega_N
        set s = s + Mega_StoneName[i] + " (" + I2S(Mega_Price[i]) + ") - " + Mega_Name[i] + "|n"
        set i = i + 1
    endloop
    if Mv_N > 0 then
        call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "Learned Moves", "Each Pokemon has 4 active move slots (hotkeys Q, W, E, R) and 1 Ability button.\nAll 4 moves are learned at Level 1. Stronger moves automatically replace weaker ones upon leveling up.\nMove damage scales with your primary attribute.", "ReplaceableTextures\\CommandButtons\\BTNStormBolt.blp")
    endif
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "Mega Stones", s, "ReplaceableTextures\\CommandButtons\\BTNMegaGengar.blp")
    if Leg_N > 0 then
        call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "Random Legends", "Every 3 minutes, 2 wild Lv 100 Legends spawn on the map.\nOnly Lv 100 Pokemon can damage them.\nDefeating them gives a 50% chance to drop their Legend Soul (carry in slot 1 and enter center circle to transform).\nNormal wild creeps do not drop Souls. Camp Elites have a 10% chance to drop their Soul.", "ReplaceableTextures\\CommandButtons\\BTNSoulGem.blp")
    endif
endfunction

// ---------------------------------------------------------------------------------------------
// Pokemon Abilities (v2.8). Per-unit keys in Ab_HT, parent key = handle id:
//   0 applied Ability number (0 = none), 1 last hit taken time, 2 rising stacks, 3 rising expiry,
//   4 sturdy cooldown end, 5/6 weaken until/fraction (Intimidate), 7/8 boost until/fraction (Flash Fire),
//   9 born time (Slow Start), 10 synced flag, 11 base move speed while slowed.
// Ability number of a unit type: SaveInteger(Ab_HT, type, 0, number). Megas: Ab_MegaAb[mega index].
// Effect e of Ability a is e = a*2 + k. Damage is handled in Ab_OnDamaging (one trigger, Ab_Busy guards the
// damage an Ability itself deals).
// ---------------------------------------------------------------------------------------------
// v3.4: the Ability that works now: none while an enemy Air Lock is near (key 77), the copied one for Trace (key 76)
// ======== [END FILE: 05_sys_gym_league_evo.j] ========
// ======== [BEGIN FILE: 06_sys_abilities_moves.j] ========
function Ab_Num takes unit u returns integer
    local integer h = GetHandleId(u)
    local integer a = LoadInteger(Ab_HT, h, 0)
    if a == 0 then
        return 0
    endif
    if Mega_Time < LoadReal(Ab_HT, h, 77) then
        return 0
    endif
    if a == AB_TRACE and LoadInteger(Ab_HT, h, 76) > 0 then
        return LoadInteger(Ab_HT, h, 76)
    endif
    return a
endfunction

// alive check by life: the UnitAlive native is not in every WC3 version and an undeclared function stops the map
function Ab_Alive takes unit u returns boolean
    return GetWidgetLife(u) > 0.405
endfunction

function Ab_Dig takes integer d returns integer
    if d < 10 then
        return 48 + d
    endif
    return 55 + d
endfunction

// passive info button of Ability a: 'AB00' + base-36 digits of a-1 (same as ability_data.info_id)
function Ab_InfoId takes integer a returns integer
    local integer i = a - 1
    local integer hi = i / 36
    local integer lo = i - hi * 36
    return 'AB00' - 12336 + Ab_Dig(hi) * 256 + Ab_Dig(lo)
endfunction

// Ability that a unit should have now: a Mega form's Ability, else its type's Ability
function Ab_Want takes unit u returns integer
    local integer mi = LoadInteger(Mega_HT, GetHandleId(u), 0) - 1
    local integer formId = PAX_Form_Id(u)
    if mi >= 0 then
        return Ab_MegaAb[mi]
    endif
    if formId >= 1 and formId <= 6 then
        return 81 + formId
    elseif formId >= 7 and formId <= 9 then
        return AB_DEOXYSFORM
    elseif formId >= 10 and formId <= 16 then
        return AB_PROTOSYNTHESIS
    elseif formId >= 17 and formId <= 19 then
        return AB_QUARKDRIVE
    endif
    return LoadInteger(Ab_HT, GetUnitTypeId(u), 0)
endfunction

// Experimental second trait for Pikachu and Raichu.
function PAX_LightBallUnit takes unit u returns boolean
    if u == null then
        return false
    endif
    return GetUnitTypeId(u) == 'E005' or GetUnitTypeId(u) == 'E006'
endfunction

function PAX_LightBallSync takes unit u returns nothing
    if u == null then
        return
    endif
    if PAX_LightBallUnit(u) then
        if GetUnitAbilityLevel(u, 'PAX0') == 0 then
            call UnitAddAbility(u, 'PAX0')
        endif
    elseif GetUnitAbilityLevel(u, 'PAX0') > 0 then
        call UnitRemoveAbility(u, 'PAX0')
    endif
endfunction

function PAX_LightBallDamageMult takes unit u, boolean isHit returns real
    if isHit and PAX_LightBallUnit(u) then
        return 1.25
    endif
    return 1.0
endfunction

// a unit we see for the first time may carry Abilities of the unit it replaced (evolution): remove them all
function Ab_Strip takes unit u returns nothing
    local integer a = 1
    loop
        exitwhen a > Ab_N
        call UnitRemoveAbility(u, Ab_InfoId(a))
        set a = a + 1
    endloop
    call UnitRemoveAbility(u, 'AXA4')
    call UnitRemoveAbility(u, 'AXA6')
    call UnitRemoveAbility(u, 'AXS4')
    call UnitRemoveAbility(u, 'AXS7')
endfunction

// give the hero the info button and the bonus abilities of its Ability; swap them when the Ability changes
// model shown on a hero that has an aura Ability (v3.4)
function Ab_AuraModel takes integer a returns string
    if a == AB_FLAMEBODY then
        return "Abilities\\Spells\\NightElf\\Immolation\\ImmolationTarget.mdl"
    elseif a == AB_PRESSURE then
        return "Abilities\\Spells\\Undead\\UnholyAura\\UnholyAura.mdl"
    elseif a == AB_BADDREAMS then
        return "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAura.mdl"
    elseif a == AB_DROUGHT then
        return "Abilities\\Spells\\Human\\Brilliance\\Brilliance.mdl"
    elseif a == AB_SANDSTREAM then
        return "Abilities\\Spells\\Orc\\CommandAura\\CommandAura.mdl"
    elseif a == AB_SHADOWTAG then
        return "Abilities\\Spells\\Human\\DevotionAura\\DevotionAura.mdl"
    elseif a == AB_MAGNETPULL then
        return "Abilities\\Spells\\Orc\\EnduranceAura\\EnduranceAura.mdl"
    elseif a == AB_AIRLOCK then
        return "Abilities\\Spells\\NightElf\\TrueshotAura\\TrueshotAura.mdl"
    elseif a == AB_PRIMORDIALSEA then
        return ""
    elseif a == AB_DESOLATELAND then
        return "Abilities\\Spells\\NightElf\\Immolation\\ImmolationTarget.mdl"
    elseif a == AB_EONAEGIS then
        return "Abilities\\Spells\\Human\\DevotionAura\\DevotionAura.mdl"
    elseif a == AB_COMPETITIVE or a == AB_TEMPORALMASTERY or a == AB_PROTOSYNTHESIS then
        return "Abilities\\Spells\\Human\\Brilliance\\Brilliance.mdl"
    elseif a == AB_DEFIANT or a == AB_SPATIALMASTERY or a == AB_QUARKDRIVE then
        return "Abilities\\Spells\\Orc\\EnduranceAura\\EnduranceAura.mdl"
    elseif a == AB_BERSERK or a == AB_DISTORTIONWORLD or a == AB_DEOXYSFORM then
        return "Abilities\\Spells\\Human\\DevotionAura\\DevotionAura.mdl"
    endif
    return ""
endfunction

// give the hero the info button of its Ability (and the aura model); swap them when the Ability changes.
// v3.4: no item bonus abilities any more (Ab_Strip still removes the old ones)
function Ab_Sync takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer want = Ab_Want(u)
    local integer have = LoadInteger(Ab_HT, h, 0)
    local string fx = ""
    if not HaveSavedInteger(Ab_HT, h, 10) then
        call SaveInteger(Ab_HT, h, 10, 1)
        call SaveReal(Ab_HT, h, 9, Mega_Time)
        call Ab_Strip(u)
        set have = 0
        call Shiny_Decide(u)  // v3.4
    endif
    if want != have then
        if have > 0 then
            call UnitRemoveAbility(u, Ab_InfoId(have))
        endif
        if HaveSavedHandle(Ab_HT, h, 80) then
            call DestroyEffect(LoadEffectHandle(Ab_HT, h, 80))
            call RemoveSavedHandle(Ab_HT, h, 80)
        endif
        if LoadReal(Ab_HT, h, 83) != 0.0 then
            call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u))
            call SaveReal(Ab_HT, h, 83, 0.0)
        endif
        call SaveInteger(Ab_HT, h, 76, 0)
        call SaveInteger(Ab_HT, h, 62, 0)
        if LoadInteger(Ab_HT, h, 85) == 1 then  // leaves Zen Mode with the Ability
            call SaveInteger(Ab_HT, h, 85, 0)
            call BlzSetUnitSkin(u, GetUnitTypeId(u))
            call SetUnitScale(u, Ab_ZenBase, Ab_ZenBase, Ab_ZenBase)
            call BlzSetUnitArmor(u, BlzGetUnitArmor(u) - Ab_ZenArmor)
        endif
        if want > 0 then
            call UnitAddAbility(u, Ab_InfoId(want))
            set fx = Ab_AuraModel(want)
            if fx != "" then
                call SaveEffectHandle(Ab_HT, h, 80, AddSpecialEffectTarget(fx, u, "origin"))
            endif
        endif
        call SaveInteger(Ab_HT, h, 0, want)
    endif
    call PAX_LightBallSync(u)
    call PAX_Leg_Sync(u)
endfunction

function PAX_MegaSyncX takes nothing returns nothing
    if PAX_MegaSyncU != null then
        call Ab_Sync(PAX_MegaSyncU)
        call Hero_HPSync(PAX_MegaSyncU)
    endif
    set PAX_MegaSyncU = null
endfunction

// ---- timed effects (v3.4). Kinds: 1 damage over time (amt HP per second, dealt by Ab_FxSrc), 2 slow (move, amt =
// fraction), 3 stun, 4 attack slow (amt = fraction; heroes through Hero_HPSync, others by their cooldown),
// 5 armor down (amt), 6 disarm ('Abun'), 7 invulnerable, 8 invisible ('Apiv'). A refresh keeps the stronger amount.
// The slot of (unit, kind) is kept in Ab_HT key 90 + kind of the unit (slot + 1), so a lookup is one hashtable read.
function Ab_FxFind takes unit u, integer kind returns integer
    local integer i = LoadInteger(Ab_HT, GetHandleId(u), 90 + kind) - 1
    if i >= 0 and Ab_FxU[i] == u and Ab_FxKind[i] == kind then
        return i
    endif
    return -1
endfunction

// a free slot: scan on from the last one given (Ab_FxNext)
function Ab_FxFree takes nothing returns integer
    local integer n = 0
    loop
        exitwhen n >= Ab_FxMax
        set Ab_FxNext = Ab_FxNext + 1
        if Ab_FxNext >= Ab_FxMax then
            set Ab_FxNext = 0
        endif
        if Ab_FxU[Ab_FxNext] == null then
            return Ab_FxNext
        endif
        set n = n + 1
    endloop
    return -1
endfunction

// damage from an Ability (no Ability / type multipliers: Ab_Busy)
function Ab_Deal takes unit src, unit t, real d returns nothing
    if d <= 0.0 or t == null or not Ab_Alive(t) then
        return
    endif
    set Ab_Busy = true
    call UnitDamageTarget(src, t, d, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
    set Ab_Busy = false
endfunction

function Ab_Heal takes unit u, real amt returns nothing
    local real mx = I2R(BlzGetUnitMaxHP(u))
    local real hp = 0.0
    if amt <= 0.0 or not Ab_Alive(u) then
        return
    endif
    set hp = GetWidgetLife(u) + amt * PAX_HealMult(u)
    if hp > mx then
        set hp = mx
    endif
    call SetWidgetLife(u, hp)
endfunction

function PAX_LightBallOnHit takes unit src, unit target, boolean isHit, real dealt returns nothing
    local effect strike = null
    if isHit and dealt > 0.0 and PAX_LightBallUnit(src) then
        call Ab_Heal(src, 0.03 * I2R(BlzGetUnitMaxHP(src)))
        set strike = AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl", target, "origin")
        call DestroyEffect(strike)
        set strike = null
    endif
endfunction

function Ab_FxAdd takes unit u, integer kind, real dur, real amt returns nothing
    local integer h = GetHandleId(u)
    local integer i = Ab_FxFind(u, kind)
    local boolean fresh = false
    local real old = 0.0
    if u == null or not Ab_Alive(u) then
        return
    endif
    if Ab_Num(u) == AB_MULTITYPE and kind >= 1 and kind <= 6 and Ab_FxCur != u then
        set dur = dur * 0.5
    endif
    if i < 0 then
        set i = Ab_FxFree()
        if i < 0 then
            return
        endif
        set fresh = true
        set Ab_FxU[i] = u
        set Ab_FxKind[i] = kind
        set Ab_FxEnd[i] = Mega_Time + dur
        call SaveInteger(Ab_HT, h, 90 + kind, i + 1)
    else
        set old = Ab_FxAmt[i]
        if amt < old then
            set amt = old
        endif
        if Mega_Time + dur > Ab_FxEnd[i] then
            set Ab_FxEnd[i] = Mega_Time + dur
        endif
    endif
    set Ab_FxAmt[i] = amt
    set Ab_FxSrc[i] = Ab_FxCur
    if kind == 2 then
        if LoadReal(Ab_HT, h, 11) <= 0.0 then
            call SaveReal(Ab_HT, h, 11, GetUnitMoveSpeed(u))
        endif
        call SetUnitMoveSpeed(u, LoadReal(Ab_HT, h, 11) * (1.0 - amt))
    elseif kind == 3 then
        call PauseUnit(u, true)
    elseif kind == 4 then
        if not IsUnitType(u, UNIT_TYPE_HERO) then
            if fresh then
                call SaveReal(Ab_HT, h, 12, BlzGetUnitAttackCooldown(u, 0))
            endif
            if LoadReal(Ab_HT, h, 12) > 0.0 and amt < 0.9 then
                call BlzSetUnitAttackCooldown(u, LoadReal(Ab_HT, h, 12) / (1.0 - amt), 0)
            endif
        endif
    elseif kind == 5 then
        call BlzSetUnitArmor(u, BlzGetUnitArmor(u) + old - amt)
    elseif kind == 6 then
        if fresh then
            call UnitAddAbility(u, 'Abun')
        endif
    elseif kind == 7 then
        call SetUnitInvulnerable(u, true)
    elseif kind == 8 then
        if fresh then
            call UnitAddAbility(u, 'Apiv')
        endif
    endif
endfunction

// end slot i: undo what the effect changed
function Ab_FxStop takes integer i returns nothing
    local unit u = Ab_FxU[i]
    local integer kind = Ab_FxKind[i]
    local integer h = GetHandleId(u)
    local real amt = Ab_FxAmt[i]
    set Ab_FxU[i] = null
    set Ab_FxSrc[i] = null
    if LoadInteger(Ab_HT, h, 90 + kind) == i + 1 then
        call SaveInteger(Ab_HT, h, 90 + kind, 0)
    endif
    if kind == 2 and Ab_FxFind(u, 2) < 0 then
        if IsUnitType(u, UNIT_TYPE_HERO) then  // v3.4.14: no stale speed for heroes
            call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u) + LoadReal(Ab_HT, h, 83))
        elseif LoadReal(Ab_HT, h, 11) > 0.0 then
            call SetUnitMoveSpeed(u, LoadReal(Ab_HT, h, 11))
        endif
        call SaveReal(Ab_HT, h, 11, 0.0)
    elseif kind == 3 and Ab_FxFind(u, 3) < 0 then
        call PauseUnit(u, false)
    elseif kind == 4 then
        if not IsUnitType(u, UNIT_TYPE_HERO) and LoadReal(Ab_HT, h, 12) > 0.0 then
            call BlzSetUnitAttackCooldown(u, LoadReal(Ab_HT, h, 12), 0)
        endif
    elseif kind == 5 then
        call BlzSetUnitArmor(u, BlzGetUnitArmor(u) + amt)
    elseif kind == 6 then
        call UnitRemoveAbility(u, 'Abun')
    elseif kind == 7 then
        call SetUnitInvulnerable(u, false)
    elseif kind == 8 then
        call UnitRemoveAbility(u, 'Apiv')
    endif
    set u = null
endfunction

// runs every 0.5s
function Ab_FxRun takes nothing returns nothing
    local integer i = 0
    local unit u = null
    local unit s = null
    local real d = 0.0
    loop
        exitwhen i >= Ab_FxMax
        set u = Ab_FxU[i]
        if u != null then
            if not Ab_Alive(u) or Mega_Time >= Ab_FxEnd[i] then
                call Ab_FxStop(i)
            elseif Ab_FxKind[i] == 1 then
                set d = Ab_FxAmt[i] * 0.5
                set s = Ab_FxSrc[i]
                if s != null and GetUnitTypeId(s) != 0 then
                    call Ab_Deal(s, u, d)
                elseif GetWidgetLife(u) - d > 1.0 then
                    call SetWidgetLife(u, GetWidgetLife(u) - d)
                endif
            endif
        endif
        set i = i + 1
    endloop
    set i = 0
    loop  // chain lightning bolts
        exitwhen i >= Ab_LtMax
        if Ab_Lt[i] != null and Mega_Time >= Ab_LtEnd[i] then
            call DestroyLightning(Ab_Lt[i])
            set Ab_Lt[i] = null
        endif
        set i = i + 1
    endloop
    set u = null
    set s = null
endfunction

// true if the unit has a harmful timed effect of ours (burn, poison, slow, stun, attack slow, armor down, disarm)
function Ab_HasBad takes unit u returns boolean
    local integer k = 1
    loop
        exitwhen k > 6
        if Ab_FxFind(u, k) >= 0 then
            return true
        endif
        set k = k + 1
    endloop
    return false
endfunction

// remove the harmful effects (ours and the game's negative buffs)
function Ab_Cleanse takes unit u returns nothing
    local integer k = 1
    local integer i = 0
    loop
        exitwhen k > 6
        set i = Ab_FxFind(u, k)
        if i >= 0 then
            call Ab_FxStop(i)
        endif
        set k = k + 1
    endloop
    call UnitRemoveBuffs(u, false, true)
    call Ab_Pop(u, "Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", "origin")
endfunction

function Ab_HasWord takes string s, string w returns boolean
    local integer n = StringLength(s) - StringLength(w)
    local integer i = 0
    loop
        exitwhen i > n
        if SubString(s, i, i + StringLength(w)) == w then
            return true
        endif
        set i = i + 1
    endloop
    return false
endfunction

// main attribute (v3.2.16: strength or intelligence, whichever is higher = PokemonDB max(Atk, SpA); agility = speed)
function Ab_MainStat takes unit u returns real
    local real s = I2R(GetHeroStr(u, true))
    local real i = I2R(GetHeroInt(u, true))
    if i > s then
        set s = i
    endif
    return s
endfunction

// best main attribute among the heroes of a player (for dummy units that deal a skill's damage)
function Ab_PlayerStat takes player p returns real
    local real best = 0.0
    local real s = 0.0
    local unit u = null
    call GroupEnumUnitsOfPlayer(Ab_Tmp, p, null)
    loop
        set u = FirstOfGroup(Ab_Tmp)
        exitwhen u == null
        call GroupRemoveUnit(Ab_Tmp, u)
        if IsUnitType(u, UNIT_TYPE_HERO) then
            set s = Ab_MainStat(u)
            if s > best then
                set best = s
            endif
        endif
    endloop
    set u = null
    return best
endfunction

// damage multiplier of a skill (v3.2.16): main stat / Ab_ScaleBase (x1 at 50, like the stat it grows 2% per level),
// at least 0.1, at most Ab_ScaleMax
function Ab_SkillMult takes real stat returns real
    local real m = stat / Ab_ScaleBase
    if m < 0.1 then
        set m = 0.1
    endif
    if m > Ab_ScaleMax then
        set m = Ab_ScaleMax
    endif
    return m
endfunction

// damage of an Ability's own hit (chain lightning): the hero's main stat, a creep's attack damage
function Ab_ProcDmg takes unit u returns real
    if IsUnitType(u, UNIT_TYPE_HERO) then
        return Ab_MainStat(u)
    endif
    return I2R(BlzGetUnitBaseDamage(u, 0)) + 10.0
endfunction

function Ab_Bolt takes unit a, unit b returns nothing
    local integer i = 0
    loop
        exitwhen i >= Ab_LtMax
        if Ab_Lt[i] == null then
            set Ab_Lt[i] = AddLightningEx("CLPB", true, GetUnitX(a), GetUnitY(a), 60.0, GetUnitX(b), GetUnitY(b), 60.0)
            set Ab_LtEnd[i] = Mega_Time + 0.4
            return
        endif
        set i = i + 1
    endloop
endfunction

// Static: lightning that jumps to 4 enemies (500 range), d damage each and a 0.5s stun
function Ab_Chain takes unit src, unit first, real d returns nothing
    local unit cur = first
    local unit prev = src
    local unit v = null
    local unit best = null
    local real bd = 0.0
    local real dx = 0.0
    local real dy = 0.0
    local integer n = 0
    local player p = GetOwningPlayer(src)
    call GroupClear(Ab_HitG)
    loop
        exitwhen cur == null or n >= 4
        call GroupAddUnit(Ab_HitG, cur)
        call Ab_Bolt(prev, cur)
        call Ab_Pop(cur, "Abilities\\Weapons\\Bolt\\BoltImpact.mdl", "origin")
        call Ab_Deal(src, cur, d)
        set Ab_FxCur = src
        call Ab_FxAdd(cur, 3, 0.5, 0.0)
        set n = n + 1
        set prev = cur
        set best = null
        set bd = 250000.0
        call GroupEnumUnitsInRange(Ab_Group, GetUnitX(cur), GetUnitY(cur), 500.0, null)
        loop
            set v = FirstOfGroup(Ab_Group)
            exitwhen v == null
            call GroupRemoveUnit(Ab_Group, v)
            if Ab_Alive(v) and IsUnitEnemy(v, p) and not IsUnitInGroup(v, Ab_HitG) and not IsUnitType(v, UNIT_TYPE_STRUCTURE) then
                set dx = GetUnitX(v) - GetUnitX(cur)
                set dy = GetUnitY(v) - GetUnitY(cur)
                if dx * dx + dy * dy < bd then
                    set bd = dx * dx + dy * dy
                    set best = v
                endif
            endif
        endloop
        set cur = best
    endloop
    set Ab_FxCur = null
    call GroupClear(Ab_HitG)
    set cur = null
    set prev = null
    set v = null
    set best = null
    set p = null
endfunction

// Poison Point: 6% of max HP over 4s and 20% slow
function Ab_Poison takes unit src, unit t returns nothing
    set Ab_FxCur = src
    call Ab_FxAdd(t, 1, 4.0, 0.015 * I2R(BlzGetUnitMaxHP(t)))
    call Ab_FxAdd(t, 2, 4.0, 0.2)
    set Ab_FxCur = null
    call Ab_Pop(t, "Abilities\\Weapons\\ChimaeraAcidMissile\\ChimaeraAcidMissile.mdl", "chest")
endfunction

// boosts and weakens that sit on the attacker: Flash Fire (keys 7, 8), Intimidate (5, 6), Lightning Rod (72, moves),
// Drought of an ally (78, Fire moves)
function Ab_StateMult takes unit u, boolean skill, integer mt returns real
    local integer h = GetHandleId(u)
    local real m = 1.0
    if Mega_Time < LoadReal(Ab_HT, h, 7) then
        set m = m * (1.0 + LoadReal(Ab_HT, h, 8))
    endif
    if Mega_Time < LoadReal(Ab_HT, h, 5) then
        set m = m * (1.0 - LoadReal(Ab_HT, h, 6))
    endif
    if skill and Mega_Time < LoadReal(Ab_HT, h, 72) then
        set m = m * 1.3
    endif
    if skill and mt == T_FIRE and Mega_Time < LoadReal(Ab_HT, h, 78) then
        set m = m * 1.3
    endif
    return m
endfunction

// damage dealt by the attacker src from its Ability a (ta = the target's Ability, for Shell / Battle Armor)
function Ab_OutMult takes unit src, unit t, integer a, integer ta, boolean atk, boolean skill, integer mt returns real
    local integer h = GetHandleId(src)
    local integer mi = LoadInteger(Mega_HT, h, 0) - 1
    local real r = GetWidgetLife(src) / I2R(BlzGetUnitMaxHP(src))
    local real m = 1.0
    local real critc = 0.0
    local real cm = 2.0
    local integer n = 0
    if a >= AB_OVERGROW and a <= AB_SWARM then
        if r < 0.4 then
            set m = 1.5
        endif
    elseif a == AB_IRONFIST then
        if atk then
            set m = 1.35
            set n = LoadInteger(Ab_HT, h, 70) + 1
            if n >= 4 then
                set m = 2.7
                set n = 0
                call Ab_Pop(t, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", "origin")
            endif
            call SaveInteger(Ab_HT, h, 70, n)
        endif
    elseif a == AB_ADAPTABILITY then
        if skill and Ty_Has(src, mt) then
            set m = 1.4
        endif
    elseif a == AB_TECHNICIAN then
        if skill and Ty_CurPow <= 60 then
            set m = 1.5
        endif
    elseif a == AB_RECKLESS then  // v3.4.11
        if atk then
            set m = 1.15
        elseif skill and (LoadInteger(Fx_HT, Fx_CurMove(src), 2) > 0) then
            set m = 1.3
        endif
    elseif a == AB_GUTS then
        if (atk or (skill and Ty_CurPhys == 1)) and Fx_HasStatus(src) then  // v3.4.11
            set m = 1.5
        endif
    elseif a == AB_ANGERPOINT then
        if Mega_Time < LoadReal(Ab_HT, h, 66) then
            set m = 1.6
        endif
    elseif a == AB_STEADFAST then
        if Mega_Time < LoadReal(Ab_HT, h, 3) then
            set m = 1.0 + 0.06 * I2R(LoadInteger(Ab_HT, h, 2))
        endif
    elseif a == AB_MULTITYPE then
        set m = 1.25
        if skill and mt >= 0 and (mt == Ty_Of(src, 0) or mt == Ty_Of(src, 1)) then
            set m = m * 1.20
        endif
    elseif a == AB_SLOWSTART then
        if Mega_Time - LoadReal(Ab_HT, h, 9) < 8.0 then  // v3.4.11
            set m = 0.7
        else
            set m = 1.5
        endif
    elseif a == AB_TOUGHCLAWS then
        if atk then  // v3.4.11 Tough Claws
            set m = 1.3
        elseif skill and Ty_CurPhys == 1 then
            set m = 1.3
        endif
    elseif a == AB_MEGALAUNCHER then  // v3.4.11
        if skill and Fx_MoveHas(src, 524288) then
            set m = 1.5
        elseif skill and Ty_CurPhys == 2 then
            set m = 1.15
        endif
    elseif a == AB_AERILATE then
        if skill and mt == T_FLYING then
            set m = 1.3
        endif
    elseif a == AB_PIXILATE then
        if skill and mt == T_FAIRY then
            set m = 1.3
        endif
    elseif a == AB_MOLDBREAKER then
        set m = 1.2
    elseif a == AB_MEGAADAPT then
        if skill and Ty_Has(src, mt) then
            set m = 1.6
        endif
    elseif a == AB_MEGATECH then
        if skill and Ty_CurPow <= 60 then
            set m = 1.6
        endif
    elseif a == AB_SANDFORCE then
        if skill and (mt == T_ROCK or mt == T_GROUND or mt == T_STEEL) then
            set m = 1.2
        endif
    elseif a == AB_PARENTALBOND then
        if skill then
            set m = 1.25
        endif
    elseif a == AB_NOGUARD then
        set m = 1.25
        set critc = 0.15
    elseif a == AB_KEENEYE then
        set critc = 0.15
    elseif a == AB_COMPOUNDEYES then
        set critc = 0.2
        set cm = 1.75
        if skill then
            set m = 1.1
        endif
    elseif a == AB_SUPERLUCK then
        set critc = 0.25
        set cm = 1.5
    elseif a == AB_STRONGJAW then
        if atk then
            set m = 1.3
        elseif skill and Fx_MoveHas(src, 262144) then  // v3.4.11 biting moves
            set m = 1.4
        endif
    elseif a == AB_SOLARPOWER then
        if skill then
            set m = 1.4
        endif
    elseif a == AB_SKILLLINK then
        if skill and Fx_MoveHas(src, 8) then  // v3.4.11 multi-hit: 5 hits
            set m = 1.5
        elseif skill then
            set m = 1.2
        endif
    elseif a == AB_ZENMODE then
        if LoadInteger(Ab_HT, h, 85) == 1 then
            if atk then
                set m = 0.5
            elseif skill then
                set m = 1.5
            endif
        endif
    endif
    if a == AB_DESOLATELAND and skill and (mt == T_GROUND or mt == T_FIRE) then
        set m = m * 1.15
    elseif a == AB_EONAEGIS and skill and (mt == T_DRAGON or mt == T_PSYCHIC) then
        set m = m * 1.25
    endif
    if a == AB_COMPETITIVE and skill then
        set m = m * 1.15
    elseif a == AB_DEFIANT and (atk or (skill and Ty_CurPhys == 1)) then
        set m = m * 1.20
    elseif a == AB_BERSERK and r < 0.60 then
        set m = m * 1.30
    elseif a == AB_DISTORTIONWORLD then
        set m = m * 1.25
    elseif (a == AB_TEMPORALMASTERY or a == AB_SPATIALMASTERY) and skill then
        set m = m * 1.20
        if a == AB_SPATIALMASTERY and GetRandomInt(1, 100) <= 30 then
            set m = m * 1.50
            call Ab_Say(t, "Spell Crit!", 210, 130, 255, GetOwningPlayer(src), GetOwningPlayer(t))
        endif
    elseif a == AB_DEOXYSFORM and PAX_Form_Id(src) == 7 then
        set m = m * 1.30
    endif
    if (atk or skill) and PAX_Paradox_Active(src, a) then
        set m = m * 1.20
    endif
    if mi == 13 and atk then
        set m = m * 1.25
    elseif mi == 14 and skill then
        set m = m * 1.25
    endif
    if atk and critc > 0.0 and ta != AB_SHELLARMOR and ta != AB_BATTLEARMOR and GetRandomReal(0.0, 1.0) < critc then
        set m = m * cm
        call Ab_Say(t, "Crit!", 255, 60, 60, GetOwningPlayer(src), GetOwningPlayer(t))
        call Ab_Pop(t, "Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", "origin")
    endif
    return m
endfunction

// Intimidate (on the first hit after 10s out of combat, once every 20s): enemies within 600 deal 25% less damage
// and have 5 less armor for 6s
function Ab_Intimidate takes unit u returns nothing
    local unit v = null
    local player p = GetOwningPlayer(u)
    local integer h = GetHandleId(u)
    if Mega_Time < LoadReal(Ab_HT, h, 73) then
        set p = null
        return
    endif
    call SaveReal(Ab_HT, h, 73, Mega_Time + 20.0)
    call Ab_Pop(u, "Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl", "origin")
    set Ab_FxCur = u
    call GroupEnumUnitsInRange(Ab_Group, GetUnitX(u), GetUnitY(u), 500.0, null)  // v3.4.11
    loop
        set v = FirstOfGroup(Ab_Group)
        exitwhen v == null
        call GroupRemoveUnit(Ab_Group, v)
        if Ab_Alive(v) and IsUnitEnemy(v, p) and not IsUnitType(v, UNIT_TYPE_STRUCTURE) then
            set Fx_ArgU = v
            set Fx_ArgV = u
            call ExecuteFunc("Fx_IntimidateX")
        endif
    endloop
    set Ab_FxCur = null
    set v = null
    set p = null
endfunction

function PAX_MegaIntimidateX takes nothing returns nothing
    if PAX_MegaSyncU != null then
        call Ab_Intimidate(PAX_MegaSyncU)
    endif
endfunction

// damage taken by the holder t of Ability a (multiplier of the incoming damage d). srcab = the attacker's Ability.
function Ab_InMult takes unit src, unit t, integer a, integer srcab, boolean atk, boolean skill, integer mt, real d returns real
    local integer h = GetHandleId(t)
    local real mx = I2R(BlzGetUnitMaxHP(t))
    local real hp = GetWidgetLife(t)
    local real m = 1.0
    local real dodge = 0.0
    local real nd = 0.0
    local integer stacks = 0
    local player plA = GetOwningPlayer(src)
    local player plB = GetOwningPlayer(t)
    // dodge, attacks only (attacks of Keen Eye and No Guard cannot be dodged)
    if atk and srcab != AB_KEENEYE and srcab != AB_NOGUARD then
        if a == AB_LEVITATE or a == AB_INNERFOCUS or a == AB_AIRLOCK then
            set dodge = 0.15
        elseif a == AB_SWIFTSWIM then
            set dodge = 0.1
        elseif a == AB_LEAFGUARD or a == AB_INSOMNIA or (a == AB_DEOXYSFORM and PAX_Form_Id(t) == 9) then
            set dodge = 0.2
        elseif a == AB_SANDVEIL or a == AB_SNOWCLOAK then  // v3.4.11: 10%, 30% in their weather
            set dodge = 0.1
        elseif a == AB_TRACE or a == AB_DELTASTREAM or a == AB_MEGAINNERFOCUS or a == AB_EONAEGIS then
            set dodge = 0.25
        endif
        if ((a == AB_SANDVEIL and Wth_Cur == 3) or (a == AB_SNOWCLOAK and Wth_Cur == 4)) and Mega_Time >= LoadReal(Fx_HT, h, 104) then  // v3.4 weather
            set dodge = dodge + 0.2
        endif
        if dodge > 0.0 and GetRandomReal(0.0, 1.0) < dodge then
            call Ab_Say(t, "Miss", 210, 210, 210, plA, plB)
            set Ab_FxCur = t
            if a == AB_SANDVEIL then
                call Ab_FxAdd(src, 2, 2.0, 0.2)
            elseif a == AB_SNOWCLOAK then
                call Ab_FxAdd(src, 2, 2.0, 0.4)
                call Ab_Pop(src, "Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", "origin")
            elseif a == AB_LEAFGUARD then
                call Ab_Heal(t, 0.03 * mx)
            endif
            set Ab_FxCur = null
            set plA = null
            set plB = null
            return 0.0
        endif
    endif
    if a == AB_MULTISCALE then
        if hp >= 0.8 * mx then
            set m = 0.6
        endif
    elseif a == AB_MULTITYPE then
        set m = 0.85
    elseif a == AB_LEVITATE or a == AB_DISTORTIONWORLD then
        if skill and mt == T_GROUND then
            set m = 0.0
            call Ab_Say(t, "Immune", 210, 210, 210, plA, plB)
        endif
    elseif a == AB_EONAEGIS then
        if skill and mt == T_GROUND then
            set m = 0.0
            call Ab_Say(t, "Immune", 210, 210, 210, plA, plB)
        endif
    elseif a == AB_BERSERK and hp < 0.60 * mx then
        set m = 0.85
    elseif a == AB_TEMPORALMASTERY then
        set m = 0.85
    elseif a == AB_DEOXYSFORM then
        if PAX_Form_Id(t) == 7 then
            set m = 1.20
        elseif PAX_Form_Id(t) == 8 then
            set m = 0.75
            if d > 0.0 and (atk or skill) and IsUnitEnemy(src, plB) then
                call Ab_Deal(t, src, d * m * 0.10)
            endif
        endif
    elseif a == AB_SHELLARMOR then
        if atk then
            set m = 0.8
        endif
    elseif a == AB_BATTLEARMOR then
        if atk and d > 0.0 then
            set nd = d - 2.0 * I2R(GetUnitLevel(t))
            if nd < 0.0 then
                set nd = 0.0
            endif
            set m = nd / d
        endif
    elseif a == AB_CLEARBODY then
        if skill then
            set m = 0.85
        endif
    elseif a == AB_ROCKHEAD then
        set m = 0.9
    elseif a == AB_SOUNDPROOF then
        if skill then
            set m = 0.7
        endif
    elseif a == AB_INNERFOCUS then
        if skill then
            set m = 0.8
        endif
    elseif a == AB_MEGAINNERFOCUS then
        if skill then
            set m = 0.7
        endif
    elseif a == AB_SANDSTREAM then
        if skill then
            set m = 0.8
        endif
    elseif a == AB_THICKFAT then
        if skill and (mt == T_FIRE or mt == T_ICE) then
            set m = 0.5
        endif
    elseif a == AB_MAGICBOUNCE then
        if skill then
            if GetRandomReal(0.0, 1.0) < 0.2 then
                set m = 0.0
                call Ab_Say(t, "Bounce", 160, 120, 255, plA, plB)
                call Ab_Pop(t, "Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl", "origin")
            else
                call Ab_Deal(t, src, 0.35 * d)
            endif
        endif
    elseif a == AB_SYNCHRONIZE then
        if skill then
            call Ab_Deal(t, src, 0.25 * d)
            set Ab_FxCur = t
            call Ab_FxAdd(src, 2, 3.0, 0.3)
            set Ab_FxCur = null
        endif
    elseif a == AB_STEADFAST then
        set stacks = LoadInteger(Ab_HT, h, 2)
        if Mega_Time < LoadReal(Ab_HT, h, 3) then
            set stacks = stacks + 1
            if stacks > 6 then
                set stacks = 6
            endif
        else
            set stacks = 1
        endif
        call SaveInteger(Ab_HT, h, 2, stacks)
        call SaveReal(Ab_HT, h, 3, Mega_Time + 5.0)
    endif
    if a == AB_QUARKDRIVE and PAX_Paradox_Active(t, a) then
        set m = m * 0.90
    endif
    if LoadInteger(Mega_HT, h, 0) - 1 == 13 then
        set m = m * 0.85
    elseif LoadInteger(Mega_HT, h, 0) > 0 and LoadInteger(Mega_HT, h, 0) - 1 != 14 and LoadInteger(Mega_HT, h, 0) - 1 != 15 and LoadInteger(Mega_HT, h, 0) - 1 < 33 then
        set m = m * 0.90
    endif
    // Sturdy / Sand Force: a lethal hit leaves 15% HP and 1.5s of invulnerability, once every 60s
    if (a == AB_STURDY or a == AB_SANDFORCE) and d > 0.0 and d * m >= hp and Mega_Time >= LoadReal(Ab_HT, h, 4) then
        set nd = hp - 0.15 * mx
        if nd < 0.0 then
            set nd = 0.0
        endif
        set m = nd / d
        call SaveReal(Ab_HT, h, 4, Mega_Time + 60.0)
        set Ab_FxCur = null
        call Ab_FxAdd(t, 7, 1.5, 0.0)
        call Ab_Pop(t, "Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl", "origin")
        call Ab_Say(t, "Sturdy!", 255, 220, 120, plA, plB)
    endif
    set plA = null
    set plB = null
    return m
endfunction

// Water Absorb / Volt Absorb / Lightning Rod / Flash Fire: a move of that type does no damage (heal or boost)
function Ab_Absorbs takes unit t, integer a, integer mt, real d returns boolean
    local integer h = GetHandleId(t)
    if mt < 0 then
        return false
    endif
    if (a == AB_WATERABSORB and mt == T_WATER) or ((a == AB_VOLTABSORB or a == AB_LIGHTNINGROD) and mt == T_ELECTRIC) then
        call Ab_Heal(t, 0.25 * d)
        call Ab_Pop(t, "Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", "origin")
        if a == AB_VOLTABSORB then
            call SaveReal(Ab_HT, h, 71, Mega_Time + 5.0)
        elseif a == AB_LIGHTNINGROD then
            call SaveReal(Ab_HT, h, 72, Mega_Time + 6.0)
        endif
        return true
    endif
    if a == AB_FLASHFIRE and mt == T_FIRE then
        call SaveReal(Ab_HT, h, 7, Mega_Time + 8.0)
        call SaveReal(Ab_HT, h, 8, 0.4)
        call Ab_Pop(t, "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", "origin")
        return true
    endif
    return false
endfunction

// effects of the attacker's Ability a after its hit landed (d = damage dealt)
function Ab_OnHit takes unit src, unit t, integer a, boolean atk, boolean skill, real d returns nothing
    local integer h = GetHandleId(t)
    local real mx = I2R(BlzGetUnitMaxHP(t))
    local boolean pinch = GetWidgetLife(src) < 0.4 * I2R(BlzGetUnitMaxHP(src))
    local integer n = 0
    if a == AB_QUARKDRIVE and skill and Ty_Resolve(src) == T_ELECTRIC then
        call SaveReal(PAX_Leg_HT, GetHandleId(src), 149, RMaxBJ(LoadReal(PAX_Leg_HT, GetHandleId(src), 149), Mega_Time + 6.0))
    elseif a == AB_PROTOSYNTHESIS and skill and (Ty_Resolve(src) == T_FIRE or Ty_Resolve(src) == T_DRAGON) then
        call SaveReal(PAX_Leg_HT, GetHandleId(src), 149, RMaxBJ(LoadReal(PAX_Leg_HT, GetHandleId(src), 149), Mega_Time + 6.0))
    elseif a == AB_BERSERK then
        if GetWidgetLife(src) < 0.60 * I2R(BlzGetUnitMaxHP(src)) then
            call Ab_Heal(src, 0.15 * d)
        endif
    elseif a == AB_DISTORTIONWORLD then
        call Ab_Heal(src, 0.10 * d)
    elseif a == AB_SPATIALMASTERY and skill then
        call PAX_Leg_StageDebuff(src, t, 2, -1, 4.0)
        call PAX_Leg_StageDebuff(src, t, 4, -1, 4.0)
    elseif a == AB_BLAZE then
        if atk and pinch then
            set Ab_FxCur = src
            call Ab_FxAdd(t, 1, 3.0, 0.02 * mx)
            set Ab_FxCur = null
            call Ab_Pop(t, "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", "chest")
        endif
    elseif a == AB_SWARM then
        if pinch then
            call Ab_Heal(src, 0.2 * d)
        endif
    elseif a == AB_STATIC then
        if atk and GetRandomReal(0.0, 1.0) < 0.2 then
            call Ab_Chain(src, t, Ab_ProcDmg(src))
        endif
    elseif a == AB_POISONPOINT then
        if atk then  // v3.4.11: 30% poison status
            set Fx_ArgU = t
            set Fx_ArgV = src
            set Fx_ArgI = 2
            set Fx_ArgJ = 30
            call ExecuteFunc("Fx_StatusX")
        endif
    elseif a == AB_ROCKHEAD then  // v3.4.11: no recoil instead of the stun
        if false then
            set Ab_FxCur = src
            call Ab_FxAdd(t, 3, 1.0, 0.0)
            set Ab_FxCur = null
            call Ab_Pop(t, "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", "origin")
        endif
    elseif a == AB_HYPERCUTTER then
        if atk then
            if Mega_Time < LoadReal(Ab_HT, h, 75) then
                set n = LoadInteger(Ab_HT, h, 74)
            endif
            set n = n + 1
            if n > 5 then
                set n = 5
            endif
            call SaveInteger(Ab_HT, h, 74, n)
            call SaveReal(Ab_HT, h, 75, Mega_Time + 6.0)
            set Ab_FxCur = src
            call Ab_FxAdd(t, 5, 6.0, 3.0 * I2R(n))
            set Ab_FxCur = null
        endif
    elseif a == AB_RECKLESS then
        // v3.4.11: Reckless no longer hurts the user
    elseif a == AB_STRONGJAW then
        if atk and GetRandomReal(0.0, 1.0) < 0.2 then
            call Ab_Deal(src, t, 0.5 * d)
            set Ab_FxCur = src
            call Ab_FxAdd(t, 1, 3.0, 0.01 * mx)
            set Ab_FxCur = null
            call Ab_Pop(t, "Objects\\Spawnmodels\\Human\\HumanBlood\\HumanBloodFootman.mdl", "chest")
        endif
    elseif a == AB_SKILLLINK then
        if atk and GetRandomReal(0.0, 1.0) < 0.3 then
            call Ab_Deal(src, t, 0.5 * d)
            call Ab_Deal(src, t, 0.5 * d)
            call Ab_Say(t, "x3!", 255, 200, 60, GetOwningPlayer(src), GetOwningPlayer(t))
        endif
    elseif a == AB_MULTITYPE and (atk or skill) then
        call PAX_Leg_MultitypeProc(src, t)
    endif
endfunction

// effects of the target's Ability a when an attack of src hit it
function Ab_InContact takes unit src, unit t, integer a returns nothing
    local real mx = I2R(BlzGetUnitMaxHP(src))
    if a == AB_STATIC or a == AB_FLAMEBODY or a == AB_POISONPOINT then  // v3.4.11: 30% status on the attacker
        if IsUnitType(src, UNIT_TYPE_MELEE_ATTACKER) then
            set Fx_ArgU = src
            set Fx_ArgV = t
            set Fx_ArgI = 4
            if a == AB_FLAMEBODY then
                set Fx_ArgI = 1
            elseif a == AB_POISONPOINT then
                set Fx_ArgI = 2
            endif
            set Fx_ArgJ = 30
            call ExecuteFunc("Fx_StatusX")
        endif
    elseif a == AB_CUTECHARM then
        if GetRandomReal(0.0, 1.0) < 0.2 then
            set Ab_FxCur = t
            call Ab_FxAdd(src, 6, 1.5, 0.0)
            call Ab_FxAdd(src, 2, 1.5, 0.5)
            set Ab_FxCur = null
            call Ab_Pop(src, "Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", "overhead")
        endif
    endif
endfunction

// move speed bonus of the hero's Ability (applied only while it is not slowed; key 83 = bonus now applied)
function Ab_MoveBonus takes unit u, integer a returns nothing
    local integer h = GetHandleId(u)
    local real b = 0.0
    if a == AB_CHLOROPHYLL then
        set b = 40.0
    elseif a == AB_SWIFTSWIM then
        set b = 60.0
    elseif a == AB_SPEEDBOOST then
        set b = 0.0  // v3.4.11: Speed stage
    elseif a == AB_DELTASTREAM then
        set b = 25.0
    elseif a == AB_SPATIALMASTERY then
        set b = 0.20 * GetUnitDefaultMoveSpeed(u)
    elseif a == AB_DEOXYSFORM and PAX_Form_Id(u) == 9 then
        set b = 0.25 * GetUnitDefaultMoveSpeed(u)
    endif
    if ((a == AB_SWIFTSWIM and Wth_Cur == 1) or (a == AB_CHLOROPHYLL and Wth_Cur == 2)) and Mega_Time >= LoadReal(Fx_HT, h, 104) then  // v3.4 weather
        set b = b + 0.3 * GetUnitDefaultMoveSpeed(u)
    endif
    if Mega_Time < LoadReal(PAX_Leg_HT, h, 170) then
        set b = b + 0.35 * GetUnitDefaultMoveSpeed(u)
    endif
    if GetPlayerId(GetOwningPlayer(u)) < 12 and Mega_Time < PAX_Up_ElixirEnd[GetPlayerId(GetOwningPlayer(u))] then
        set b = b + 0.15 * GetUnitDefaultMoveSpeed(u)
    endif
    if PAX_Chaos_Mode == 1 then
        set b = b + 250.0
    endif
    if IsUnitType(u, UNIT_TYPE_HERO) then  // v3.4 Choice Scarf / Band / Specs
        if Itm_Flag(u, 3) then
            set b = b + 0.3 * GetUnitDefaultMoveSpeed(u)
        endif
        if Itm_Flag(u, 1) or Itm_Flag(u, 2) then
            set b = b - 0.1 * GetUnitDefaultMoveSpeed(u)
        endif
    endif
    if Mega_Time < LoadReal(Ab_HT, h, 69) then  // Run Away dash
        set b = b + 0.6 * GetUnitDefaultMoveSpeed(u)
    endif
    if Mega_Time < LoadReal(Fx_HT, h, 102) or Mega_Time < LoadReal(Fx_HT, h, 103) then
        set b = b + 0.15 * GetUnitDefaultMoveSpeed(u)
    endif
    if PAX_Paradox_Active(u, a) then
        set b = b + 0.15 * GetUnitDefaultMoveSpeed(u)
    endif
    set b = b + Fx_MSBonus(u)  // v3.4.11: Speed stage
    if b != LoadReal(Ab_HT, h, 83) and Ab_FxFind(u, 2) < 0 then
        call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u) + b)
        call SaveReal(Ab_HT, h, 83, b)
    endif
endfunction

// HP thresholds crossed by a hit of `dealt` on the holder t: Anger Point, Run Away, the pinch Abilities
function Ab_AfterHit takes unit t, integer a, real dealt returns nothing
    local integer h = GetHandleId(t)
    local real mx = I2R(BlzGetUnitMaxHP(t))
    local real hp = GetWidgetLife(t)
    local real after = hp - dealt
    local player p = GetOwningPlayer(t)
    if after <= 0.405 then
        set p = null
        return
    endif
    if a == AB_ANGERPOINT then
        if hp >= 0.5 * mx and after < 0.5 * mx and Mega_Time >= LoadReal(Ab_HT, h, 67) then
            call SaveReal(Ab_HT, h, 66, Mega_Time + 6.0)
            call SaveReal(Ab_HT, h, 67, Mega_Time + 30.0)
            call Ab_Pop(t, "Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", "chest")
            call Ab_Say(t, "Anger Point!", 255, 80, 40, p, p)
        endif
    elseif a == AB_RUNAWAY then
        if hp >= 0.3 * mx and after < 0.3 * mx and Mega_Time >= LoadReal(Ab_HT, h, 68) then
            call SaveReal(Ab_HT, h, 68, Mega_Time + 30.0)
            call SaveReal(Ab_HT, h, 69, Mega_Time + 2.0)
            set Ab_FxCur = null
            call Ab_FxAdd(t, 8, 2.0, 0.0)
            call Ab_MoveBonus(t, a)
            call Ab_Say(t, "Run Away!", 200, 255, 200, p, p)
        endif
    elseif a >= AB_OVERGROW and a <= AB_SWARM then
        if hp >= 0.4 * mx and after < 0.4 * mx then
            call Ab_Pop(t, "Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", "chest")
            call Ab_Say(t, Ab_Name[a] + "!", 255, 160, 40, p, p)
        endif
    endif
    set p = null
endfunction

// Trace: the holder copies the Ability of what it hits (none: back to Trace's own dodge)
function Ab_TraceCopy takes unit src, unit t returns nothing
    local integer b = LoadInteger(Ab_HT, GetHandleId(t), 0)
    local integer h = GetHandleId(src)
    if b == AB_TRACE or b == AB_PARENTALBOND or b == AB_MULTITYPE or b == AB_SLOWSTART then
        set b = 0
    endif
    if b != LoadInteger(Ab_HT, h, 76) then
        call SaveInteger(Ab_HT, h, 76, b)
        if b > 0 then
            call Ab_Say(src, "Trace: " + Ab_Name[b], 160, 200, 255, GetOwningPlayer(src), GetOwningPlayer(src))
        endif
    endif
endfunction

// attack speed multiplier of the hero's Ability and of the attack slows on it (stored in key 84 for Hero_HPSync)
function Ab_ASMult takes unit u, integer a returns real
    local integer h = GetHandleId(u)
    local real m = 1.0
    local integer i = 0
    if a == AB_TORRENT then
        if GetWidgetLife(u) < 0.4 * I2R(BlzGetUnitMaxHP(u)) then
            set m = 1.4
        endif
    elseif a == AB_VOLTABSORB then
        if Mega_Time < LoadReal(Ab_HT, h, 71) then
            set m = 1.3
        endif
    elseif a == AB_CHLOROPHYLL then
        set m = 1.2
    elseif a == AB_GUTS then
        if GetWidgetLife(u) < 0.5 * I2R(BlzGetUnitMaxHP(u)) or Ab_HasBad(u) then
            set m = 1.2
        endif
    elseif a == AB_ANGERPOINT then
        if Mega_Time < LoadReal(Ab_HT, h, 66) then
            set m = 1.4
        endif
    elseif a == AB_STEADFAST then
        if Mega_Time < LoadReal(Ab_HT, h, 3) then
            set m = 1.0 + 0.06 * I2R(LoadInteger(Ab_HT, h, 2))
        endif
    elseif a == AB_SPEEDBOOST then
        set m = 1.0  // v3.4.11: Speed stage
    elseif a == AB_MEGATECH then
        set m = 1.2
    elseif a == AB_SLOWSTART then
        if Mega_Time - LoadReal(Ab_HT, h, 9) >= 8.0 then
            set m = 1.2
        endif
    endif
    set i = Ab_FxFind(u, 4)
    if i >= 0 then
        set m = m * (1.0 - Ab_FxAmt[i])
    endif
    if IsUnitType(u, UNIT_TYPE_HERO) and Itm_Flag(u, 3) then  // v3.4 Choice Scarf
        set m = m * 1.2
    endif
    return m
endfunction

// auras (every second): r = range
function Ab_Aura takes unit u, integer a, real r returns nothing
    local unit v = null
    local player p = GetOwningPlayer(u)
    local integer hv = 0
    local real mx = 0.0
    local real mana = 0.0
    local boolean mega = LoadInteger(Mega_HT, GetHandleId(u), 0) > 0
    if a == AB_PRIMORDIALSEA then
        call SaveReal(Fx_HT, GetHandleId(u), 100, Mega_Time + 1.6)
    elseif a == AB_DESOLATELAND then
        call SaveReal(Fx_HT, GetHandleId(u), 101, Mega_Time + 1.6)
    elseif a == AB_EONAEGIS then
        call SaveReal(Fx_HT, GetHandleId(u), 102, Mega_Time + 1.6)
    elseif a == AB_DELTASTREAM then
        call SaveReal(Fx_HT, GetHandleId(u), 103, Mega_Time + 1.6)
        call SaveReal(Fx_HT, GetHandleId(u), 104, Mega_Time + 1.6)
    endif
    set Ab_FxCur = u
    call GroupEnumUnitsInRange(Ab_Group, GetUnitX(u), GetUnitY(u), r, null)
    loop
        set v = FirstOfGroup(Ab_Group)
        exitwhen v == null
        call GroupRemoveUnit(Ab_Group, v)
        if v != u and Ab_Alive(v) and not IsUnitType(v, UNIT_TYPE_STRUCTURE) then
            set hv = GetHandleId(v)
            set mx = I2R(BlzGetUnitMaxHP(v))
            if a == AB_PRIMORDIALSEA and not IsUnitEnemy(v, p) then
                call SaveReal(Fx_HT, hv, 100, Mega_Time + 1.6)
            elseif a == AB_DESOLATELAND and not IsUnitEnemy(v, p) then
                call SaveReal(Fx_HT, hv, 101, Mega_Time + 1.6)
            elseif a == AB_EONAEGIS and not IsUnitEnemy(v, p) then
                call SaveReal(Fx_HT, hv, 102, Mega_Time + 1.6)
            elseif a == AB_DELTASTREAM then
                call SaveReal(Fx_HT, hv, 104, Mega_Time + 1.6)
                if not IsUnitEnemy(v, p) then
                    call SaveReal(Fx_HT, hv, 103, Mega_Time + 1.6)
                endif
            endif
            if IsUnitEnemy(v, p) then
                if a == AB_FLAMEBODY then
                    call Ab_Deal(u, v, 0.01 * mx)
                elseif a == AB_PRESSURE then
                    call Ab_FxAdd(v, 4, 1.5, 0.2)
                    set mana = GetUnitState(v, UNIT_STATE_MANA) - 0.02 * GetUnitState(v, UNIT_STATE_MAX_MANA)
                    if mana < 0.0 then
                        set mana = 0.0
                    endif
                    call SetUnitState(v, UNIT_STATE_MANA, mana)
                elseif a == AB_MAGNETPULL then
                    if Ty_Has(v, T_STEEL) then
                        call Ab_FxAdd(v, 2, 1.5, 0.4)
                    else
                        call Ab_FxAdd(v, 2, 1.5, 0.2)
                    endif
                    call Ab_FxAdd(v, 5, 1.5, 5.0)
                elseif a == AB_BADDREAMS then
                    if LoadInteger(Ab_HT, hv, 0) != AB_INSOMNIA then
                        call Ab_Deal(u, v, 0.02 * mx)
                    endif
                elseif a == AB_DROUGHT then
                    call Ab_Deal(u, v, 0.01 * mx)
                elseif a == AB_SANDSTREAM then
                    if not (Ty_Has(v, T_ROCK) or Ty_Has(v, T_GROUND) or Ty_Has(v, T_STEEL)) then
                        if mega then
                            call Ab_Deal(u, v, 0.015 * mx)
                        else
                            call Ab_Deal(u, v, 0.01 * mx)
                        endif
                    endif
                elseif a == AB_SHADOWTAG then
                    call Ab_FxAdd(v, 2, 1.5, 0.35)
                    call Ab_FxAdd(v, 4, 1.5, 0.15)
                elseif a == AB_AIRLOCK then
                    call SaveReal(Ab_HT, hv, 77, Mega_Time + 1.5)
                endif
            elseif a == AB_DROUGHT then
                call SaveReal(Ab_HT, hv, 78, Mega_Time + 1.5)
            endif
        endif
    endloop
    if a == AB_DROUGHT then
        call SaveReal(Ab_HT, GetHandleId(u), 78, Mega_Time + 1.5)
    endif
    set Ab_FxCur = null
    set v = null
    set p = null
endfunction

// every second, for each hero of the players: regeneration, cleansing, stacks, auras, move and attack speed
function Ab_Pulse takes unit u, integer a returns nothing
    local integer h = GetHandleId(u)
    local real mx = I2R(BlzGetUnitMaxHP(u))
    local real idle = Mega_Time - LoadReal(Ab_HT, h, 60)
    local integer n = 0
    if a == AB_TEMPORALMASTERY or a == AB_DEOXYSFORM then
        call PAX_Form_AbilityPulse(u, a)
    elseif a == AB_OVERGROW then
        if GetWidgetLife(u) < 0.4 * mx then
            call Ab_Heal(u, 0.02 * mx)
        endif
    elseif a == AB_WATERABSORB then
        if idle >= 3.0 then
            call Ab_Heal(u, 0.01 * mx)
        endif
    elseif a == AB_EARLYBIRD then
        if idle >= 3.0 then
            call Ab_Heal(u, 0.02 * mx)
        endif
    elseif a == AB_NATURALCURE then
        if idle >= 3.0 then
            call Ab_Heal(u, 0.03 * mx)
            if Ab_HasBad(u) then
                call Ab_Cleanse(u)
            endif
        endif
    elseif a == AB_SHEDSKIN then
        if Mega_Time >= LoadReal(Ab_HT, h, 79) then
            call SaveReal(Ab_HT, h, 79, Mega_Time + 5.0)
            if GetRandomReal(0.0, 1.0) < 0.3 then
                call Ab_Cleanse(u)
                call Ab_Heal(u, 0.05 * mx)
            endif
        endif
    elseif a == AB_CLEARBODY then
        if Mega_Time >= LoadReal(Ab_HT, h, 79) then
            call SaveReal(Ab_HT, h, 79, Mega_Time + 6.0)
            if Ab_HasBad(u) then
                call Ab_Cleanse(u)
            endif
        endif
    elseif a == AB_SPEEDBOOST then
        if idle < 3.0 then
            set n = LoadInteger(Ab_HT, h, 62)
            if LoadReal(Ab_HT, h, 63) <= 0.0 then
                call SaveReal(Ab_HT, h, 63, Mega_Time + 10.0)
            elseif Mega_Time >= LoadReal(Ab_HT, h, 63) and n < 5 then
                call SaveInteger(Ab_HT, h, 62, n + 1)
                call SaveReal(Ab_HT, h, 63, Mega_Time + 10.0)
                call Ab_Pop(u, "Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", "chest")
            endif
        endif
    elseif a == AB_FLAMEBODY then
        call Ab_Aura(u, a, 350.0)
    elseif a == AB_PRESSURE or a == AB_AIRLOCK or a == AB_SANDSTREAM then
        call Ab_Aura(u, a, 600.0)
    elseif a == AB_MAGNETPULL or a == AB_BADDREAMS then
        call Ab_Aura(u, a, 500.0)
    elseif a == AB_DROUGHT then
        call Ab_Aura(u, a, 700.0)
    elseif a == AB_SHADOWTAG then
        call Ab_Aura(u, a, 450.0)
    elseif a == AB_PRIMORDIALSEA then
        call Ab_Aura(u, a, 800.0)
    elseif a == AB_DESOLATELAND then
        call Ab_Aura(u, a, 800.0)
    elseif a == AB_EONAEGIS then
        call Ab_Aura(u, a, 550.0)
    elseif a == AB_DELTASTREAM then
        call Ab_Aura(u, a, 800.0)
    elseif a == AB_SOLARPOWER then
        if idle < 3.0 and GetWidgetLife(u) - 0.01 * mx > 0.3 * mx then
            call SetWidgetLife(u, GetWidgetLife(u) - 0.01 * mx)
        endif
    elseif a == AB_ZENMODE then
        if GetWidgetLife(u) < 0.5 * mx then
            if LoadInteger(Ab_HT, h, 85) != 1 and Ab_ZenSkin != 0 then
                call SaveInteger(Ab_HT, h, 85, 1)
                call BlzSetUnitSkin(u, Ab_ZenSkin)
                call SetUnitScale(u, Ab_ZenScale, Ab_ZenScale, Ab_ZenScale)
                call BlzSetUnitArmor(u, BlzGetUnitArmor(u) + Ab_ZenArmor)
                call Ab_Pop(u, "Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", "origin")
                call Ab_Say(u, "Zen Mode!", 200, 120, 255, GetOwningPlayer(u), GetOwningPlayer(u))
            endif
        elseif LoadInteger(Ab_HT, h, 85) == 1 then
            call SaveInteger(Ab_HT, h, 85, 0)
            call BlzSetUnitSkin(u, GetUnitTypeId(u))
            call SetUnitScale(u, Ab_ZenBase, Ab_ZenBase, Ab_ZenBase)
            call BlzSetUnitArmor(u, BlzGetUnitArmor(u) - Ab_ZenArmor)
        endif
    endif
    call Ab_MoveBonus(u, a)
    call SaveReal(Ab_HT, h, 84, Ab_ASMult(u, a))
endfunction

// ---------------------------------------------------------------------------------------------
// Learned moves (docs/superpowers/specs/2026-11-01-learned-moves-design.md). Per unit type in Ab_HT: key 99 = number of
// candidate moves, 100 + 2k = move index, 101 + 2k = hero level at which candidate k becomes available.
// Per hero in Ab_HT (parent = handle id): 40..43 = move index + 1 in slot 0..3, 200 + move = 1 once it was considered.
// ---------------------------------------------------------------------------------------------
// object id of the ability of move m in command-card slot s: A + V/W/Y/Z + two base-36 digits
function Mv_Id takes integer slot, integer m returns integer
    local integer l = 90
    if slot == 0 then
        set l = 86
    elseif slot == 1 then
        set l = 87
    elseif slot == 2 then
        set l = 89
    endif
    return 'A000' - 3158064 + l * 65536 + Ab_Dig(m / 36) * 256 + Ab_Dig(m - (m / 36) * 36)
endfunction

// v3.4.10: the hidden ability that is the spell of move m ('A' + 'K' + 2 base-36 digits)
function Mv_Real takes integer m returns integer
    return 'A000' - 3158064 + 75 * 65536 + Ab_Dig(m / 36) * 256 + Ab_Dig(m - (m / 36) * 36)
endfunction

function Mv_Slot takes unit u, integer s returns integer
    return LoadInteger(Ab_HT, GetHandleId(u), 40 + s) - 1
endfunction

function Mv_Known takes unit u, integer m returns boolean
    local integer s = 0
    loop
        exitwhen s >= Mv_Slots
        if Mv_Slot(u, s) == m then
            return true
        endif
        set s = s + 1
    endloop
    return false
endfunction

function Mv_FreeSlot takes unit u returns integer
    local integer s = 0
    loop
        exitwhen s >= Mv_Slots
        if Mv_Slot(u, s) < 0 then
            return s
        endif
        set s = s + 1
    endloop
    return -1
endfunction

// score of the weakest move the hero knows
function Mv_WeakScore takes unit u returns integer
    local integer s = 0
    local integer best = 1000000
    local integer m = 0
    loop
        exitwhen s >= Mv_Slots
        set m = Mv_Slot(u, s)
        if m >= 0 then
            if Mv_Score[m] < best then
                set best = Mv_Score[m]
            endif
        endif
        set s = s + 1
    endloop
    return best
endfunction

// slot of the weakest known move (all slots are full when this is used)
function Mv_WeakSlot takes unit u returns integer
    local integer s = 0
    local integer w = 0
    local integer best = 1000000
    local integer m = 0
    loop
        exitwhen s >= Mv_Slots
        set m = Mv_Slot(u, s)
        if m >= 0 then
            if Mv_Score[m] < best then
                set best = Mv_Score[m]
                set w = s
            endif
        endif
        set s = s + 1
    endloop
    return w
endfunction

// put move m in slot s (the move that was there is forgotten)
function Mv_Put takes unit u, integer s, integer m returns nothing
    local integer h = GetHandleId(u)
    local integer old = LoadInteger(Ab_HT, h, 40 + s) - 1
    if old >= 0 then
        call UnitRemoveAbility(u, Mv_Id(s, old))
        call UnitRemoveAbility(u, Mv_Real(old))  // v3.4.10
    endif
    call SaveInteger(Ab_HT, h, 40 + s, m + 1)
    call UnitAddAbility(u, Mv_Id(s, m))
endfunction

function Mv_Notify takes unit u, integer m returns nothing
    call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 8.0, "|cff66ff66" + GetHeroProperName(u) + " learned " + Mv_Label[m] + "!|r")
endfunction



// every second for each living hero: keep the abilities of its slots, learn / offer the candidates that became available
function Mv_Sync takes unit u returns nothing
    local integer h = GetHandleId(u)
    local integer id = GetUnitTypeId(u)
    local integer lv = GetHeroLevel(u)
    local integer n = LoadInteger(Ab_HT, id, 99)
    local integer k = 0
    local integer s = 0
    local integer m = 0
    loop
        exitwhen s >= Mv_Slots
        set m = Mv_Slot(u, s)
        if m >= 0 then
            if GetUnitAbilityLevel(u, Mv_Id(s, m)) == 0 then
                call UnitAddAbility(u, Mv_Id(s, m))
            endif
        endif
        set s = s + 1
    endloop
    loop
        exitwhen k >= n
        if lv >= LoadInteger(Ab_HT, id, 101 + 2 * k) then
            set m = LoadInteger(Ab_HT, id, 100 + 2 * k)
            if LoadInteger(Ab_HT, h, 200 + m) == 0 and m < Fx_StatBase then  // v3.4.12: status moves only at the NPC
                if Mv_Known(u, m) then
                    call SaveInteger(Ab_HT, h, 200 + m, 1)
                else
                    set s = Mv_FreeSlot(u)
                    if s >= 0 then
                        call Mv_Put(u, s, m)
                        call Mv_Notify(u, m)
                        call SaveInteger(Ab_HT, h, 200 + m, 1)
                    elseif Mv_Score[m] > Mv_WeakScore(u) then
                        call Mv_Put(u, Mv_WeakSlot(u), m)
                        call Mv_Notify(u, m)
                        call SaveInteger(Ab_HT, h, 200 + m, 1)
                    else
                        call SaveInteger(Ab_HT, h, 200 + m, 1)
                    endif
                endif
            endif
        endif
        set k = k + 1
    endloop
endfunction

// tooltip of a move at the hero's current damage multiplier (main attribute and level)
function Mv_Tip takes integer m, real mult returns string
    local string src = Mv_Text[m]
    local string out = ""
    local string c = ""
    local integer i = 0
    local integer n = StringLength(src)
    loop
        exitwhen i >= n
        set c = SubString(src, i, i + 1)
        if c == "@" and i + 1 < n then
            if SubString(src, i + 1, i + 2) == "1" then
                set out = out + "|cff66ff66" + I2S(R2I(I2R(Mv_D1[m]) * mult)) + "|r"
            else
                set out = out + "|cff66ff66" + I2S(R2I(I2R(Mv_D2[m]) * mult)) + "|r"
            endif
            set i = i + 2
        else
            set out = out + c
            set i = i + 1
        endif
    endloop
    if Mv_Pow[m] <= 0 then  // v3.4.12: status moves deal no damage
        return out
    endif
    return out + "|n|cff66ff66Damage now x" + I2S(R2I(mult * 100.0)) + "% (grows with main stat and level)|r"
endfunction

function Mv_Tips takes unit u returns nothing
    local player p = GetOwningPlayer(u)
    local real mult = Ab_SkillMult(Ab_MainStat(u))
    local integer lv = GetHeroLevel(u)
    local integer s = 0
    local integer m = 0
    if lv > 50 then
        set mult = mult * (1.0 + Ab_LevelK * I2R(lv - 50))
    endif
    loop
        exitwhen s >= Mv_Slots
        set m = Mv_Slot(u, s)
        if m >= 0 and Mv_Text[m] != null and Mv_Text[m] != "" then
            if GetLocalPlayer() == p then
                call BlzSetAbilityExtendedTooltip(Mv_Id(s, m), Mv_Tip(m, mult), 0)
            endif
        endif
        set s = s + 1
    endloop
    set p = null
endfunction

// ---------------------------------------------------------------------------------------------
// v3.4.10: the slot buttons are Channel abilities; the spell of a move is its hidden ability Mv_Real(m).
// A hero keeps at most one hidden ability per base spell, so two moves on the same base no longer share an order.
// Timer data in Ab_HT (parent = timer handle): 0 hero, 1 slot, 2 target unit, 3 x, 4 y, 5 kind (0 none, 1 unit,
// 2 point), 6 = 1 when the button itself was cast (give its mana and cooldown back first).
// ---------------------------------------------------------------------------------------------
function Mv_SlotOfOrder takes integer o returns integer
    local integer s = 0
    loop
        exitwhen s >= Mv_Slots
        if Mv_SlotOrd[s] == o then
            return s
        endif
        set s = s + 1
    endloop
    return -1
endfunction

// move index of a hidden spell ability ('A' + 'K' + 2 base-36 digits), -1 if it is not one
function Mv_OfReal takes integer id returns integer
    local integer a = id / 16777216
    local integer b = id / 65536 - a * 256
    local integer c = id / 256 - (id / 65536) * 256
    local integer d = id - (id / 256) * 256
    local integer hi = Ty_Undig(c)
    local integer lo = Ty_Undig(d)
    if a != 65 or b != 75 or hi < 0 or lo < 0 or hi * 36 + lo >= Mv_N then
        return -1
    endif
    return hi * 36 + lo
endfunction

// slot of the button ability id of hero u, -1 if id is not one of its buttons
function Mv_SlotOfButton takes unit u, integer id returns integer
    local integer s = 0
    local integer m = 0
    loop
        exitwhen s >= Mv_Slots
        set m = Mv_Slot(u, s)
        if m >= 0 then
            if Mv_Id(s, m) == id then
                return s
            endif
        endif
        set s = s + 1
    endloop
    return -1
endfunction

// make the hidden spell of slot s the only one of its base on the hero, then order it
function Mv_Fire takes unit u, integer s, unit tgt, real x, real y, integer kind returns boolean
    local integer m = Mv_Slot(u, s)
    local integer mvSlot2 = 0
    local integer mvMove2 = 0
    local integer mvReal2 = 0
    if m < 0 or GetWidgetLife(u) <= 0.405 then
        return false
    endif
    if Mv_Ord[m] == 0 then
        return false
    endif
    set mvReal2 = Mv_Real(m)
    loop
        exitwhen mvSlot2 >= Mv_Slots
        set mvMove2 = Mv_Slot(u, mvSlot2)
        if mvSlot2 != s and mvMove2 >= 0 and mvMove2 != m then
            if Mv_Ord[mvMove2] == Mv_Ord[m] and GetUnitAbilityLevel(u, Mv_Real(mvMove2)) > 0 then
                call UnitRemoveAbility(u, Mv_Real(mvMove2))
            endif
        endif
        set mvSlot2 = mvSlot2 + 1
    endloop
    if GetUnitAbilityLevel(u, mvReal2) == 0 then
        call UnitAddAbility(u, mvReal2)
    endif
    if Mv_TT[m] == 0 then
        return IssueImmediateOrderById(u, Mv_Ord[m])
    endif
    if kind == 1 and tgt != null then
        return IssueTargetOrderById(u, Mv_Ord[m], tgt)
    endif
    if Mv_TT[m] == 1 then
        return false
    endif
    return IssuePointOrderById(u, Mv_Ord[m], x, y)
endfunction

function Mv_Dispatch takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer k = GetHandleId(t)
    local unit u = LoadUnitHandle(Ab_HT, k, 0)
    local integer s = LoadInteger(Ab_HT, k, 1)
    local unit tgt = LoadUnitHandle(Ab_HT, k, 2)
    local integer m = 0
    local integer id = 0
    if u != null and GetUnitTypeId(u) != 0 then
        set m = Mv_Slot(u, s)
        if m >= 0 then
            if LoadInteger(Ab_HT, k, 6) == 1 then
                // the button was cast instead of the spell: undo its cost and cooldown
                set id = Mv_Id(s, m)
                call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MANA) + I2R(BlzGetAbilityManaCost(id, 0)))
                call BlzEndUnitAbilityCooldown(u, id)
            endif
            call Fx_ChargeEnd(u)
            call Mv_Fire(u, s, tgt, LoadReal(Ab_HT, k, 3), LoadReal(Ab_HT, k, 4), LoadInteger(Ab_HT, k, 5))
            call PAX_Leg_OnMoveCast(u)
        endif
    endif
    call FlushChildHashtable(Ab_HT, k)
    call DestroyTimer(t)
    set t = null
    set u = null
    set tgt = null
endfunction

function Mv_Queue takes unit u, integer s, unit tgt, real x, real y, integer kind, integer undo returns nothing
    local timer t = CreateTimer()
    local integer k = GetHandleId(t)
    call SaveUnitHandle(Ab_HT, k, 0, u)
    call SaveInteger(Ab_HT, k, 1, s)
    if tgt != null then
        call SaveUnitHandle(Ab_HT, k, 2, tgt)
    endif
    call SaveReal(Ab_HT, k, 3, x)
    call SaveReal(Ab_HT, k, 4, y)
    call SaveInteger(Ab_HT, k, 5, kind)
    call SaveInteger(Ab_HT, k, 6, undo)
    call TimerStart(t, Fx_QueueDelay(u, Mv_Slot(u, s)), false, function Mv_Dispatch)  // v3.4.11 charge
    set t = null
endfunction

// a slot button was ordered (hotkey, click or trigger): cast the spell of that slot instead
function Mv_OnOrder takes nothing returns boolean
    local integer s = Mv_SlotOfOrder(GetIssuedOrderId())
    local unit u = null
    local unit tgt = null
    local integer m = 0
    if s < 0 then
        return false
    endif
    set u = GetTriggerUnit()
    set m = Mv_Slot(u, s)
    if m >= 0 then
        if Mv_Ord[m] != 0 and GetUnitAbilityLevel(u, Mv_Id(s, m)) > 0 then
            set tgt = GetOrderTargetUnit()
            if tgt != null then
                call Mv_Queue(u, s, tgt, GetUnitX(tgt), GetUnitY(tgt), 1, 0)
            elseif GetTriggerEventId() == EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER then
                call Mv_Queue(u, s, null, GetOrderPointX(), GetOrderPointY(), 2, 0)
            else
                call Mv_Queue(u, s, null, GetUnitX(u), GetUnitY(u), 0, 0)
            endif
        endif
    endif
    set u = null
    set tgt = null
    return false
endfunction

// ---- Double Team: copies of the user (summoned units wearing its skin)
function Mv_CloneSpawn takes unit u, real ang returns nothing
    local player p = GetOwningPlayer(u)
    local real x = GetUnitX(u) + 160.0 * Cos(ang)
    local real y = GetUnitY(u) + 160.0 * Sin(ang)
    local unit c = CreateUnit(p, Mv_CloneId, x, y, GetUnitFacing(u))
    local integer hp = BlzGetUnitMaxHP(u) / 2
    local integer dmg = BlzGetUnitBaseDamage(u, 0) / 2
    local integer sides = BlzGetUnitDiceSides(u, 0) / 2
    local real cloneScale = BlzGetUnitRealField(u, UNIT_RF_SCALING_VALUE)
    local effect e = AddSpecialEffect("PkFx\\Clone.mdx", GetUnitX(c), GetUnitY(c))
    call BlzSetSpecialEffectScale(e, 2.0)
    call DestroyEffect(e)
    if hp < 1 then
        set hp = 1
    endif
    if sides < 1 then
        set sides = 1
    endif
    call BlzSetUnitSkin(c, BlzGetUnitSkin(u))
    if cloneScale > 0.0 then
        call SetUnitScale(c, cloneScale, cloneScale, cloneScale)
    endif
    call BlzSetUnitName(c, GetHeroProperName(u))
    call BlzSetUnitMaxHP(c, hp)
    call SetWidgetLife(c, I2R(hp))
    call BlzSetUnitBaseDamage(c, dmg, 0)
    call BlzSetUnitDiceNumber(c, BlzGetUnitDiceNumber(u, 0), 0)
    call BlzSetUnitDiceSides(c, sides, 0)
    call BlzSetUnitArmor(c, BlzGetUnitArmor(u) * 0.5)
    call BlzSetUnitAttackCooldown(c, BlzGetUnitAttackCooldown(u, 0), 0)
    call SetUnitMoveSpeed(c, GetUnitMoveSpeed(u))
    call SetUnitVertexColor(c, 170, 170, 255, 215)
    call UnitAddType(c, UNIT_TYPE_SUMMONED)
    call UnitApplyTimedLife(c, 'BTLF', Mv_CloneTime)
    set p = null
    set c = null
    set e = null
endfunction

function Mv_DoubleTeamCast takes unit u returns nothing
    local integer i = 0
    local real a = GetUnitFacing(u) * bj_DEGTORAD
    local effect e = AddSpecialEffect("PkFx\\Clone.mdx", GetUnitX(u), GetUnitY(u))
    call BlzSetSpecialEffectScale(e, 3.0)
    call DestroyEffect(e)
    loop
        exitwhen i >= Mv_CloneCount
        call Mv_CloneSpawn(u, a + 6.2832 * I2R(i) / I2R(Mv_CloneCount))
        set i = i + 1
    endloop
    set e = null
endfunction

// EVENT_PLAYER_UNIT_SPELL_EFFECT: a hidden spell fired -> its button starts the cooldown; a button fired -> Double
// Team works by itself, any other button gives its cost back and orders the spell
function Mv_OnCast takes nothing returns boolean
    local integer id = GetSpellAbilityId()
    local unit u = GetTriggerUnit()
    local integer m = Mv_OfReal(id)
    local integer s = 0
    local unit tgt = null
    if m >= 0 then
        loop
            exitwhen s >= Mv_Slots
            if Mv_Slot(u, s) == m then
                call BlzStartUnitAbilityCooldown(u, Mv_Id(s, m), BlzGetUnitAbilityCooldown(u, id, 0))
            endif
            set s = s + 1
        endloop
        if GetWidgetLife(u) > 0.405 and not HaveSavedInteger(PkFx_HT, id, 0) then
            if Fx_CurPhys(u) == 1 then
                call SetUnitAnimation(u, "attack")
            else
                call SetUnitAnimation(u, "spell")
            endif
            call QueueUnitAnimation(u, "stand")
        endif
    elseif Ty_MoveOf(id) >= 0 then
        set s = Mv_SlotOfButton(u, id)
        if s >= 0 then
            set m = Mv_Slot(u, s)
            if m == Mv_DoubleTeam then
                call Mv_DoubleTeamCast(u)
            elseif m >= Fx_StatBase then  // v3.4.12: status moves
                set Fx_ArgU = u
                set Fx_ArgV = GetSpellTargetUnit()
                set Fx_ArgI = m
                call ExecuteFunc("Fx_StatusMoveX")
            elseif Mv_Ord[m] != 0 then
                set tgt = GetSpellTargetUnit()
                if tgt != null then
                    call Mv_Queue(u, s, tgt, GetUnitX(tgt), GetUnitY(tgt), 1, 1)
                elseif Mv_TT[m] == 0 then
                    call Mv_Queue(u, s, null, GetUnitX(u), GetUnitY(u), 0, 1)
                else
                    call Mv_Queue(u, s, null, GetSpellTargetX(), GetSpellTargetY(), 2, 1)
                endif
            endif
        endif
    endif
    set u = null
    set tgt = null
    return false
endfunction

